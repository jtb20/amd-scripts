#!/usr/bin/env ysh

const ScriptName = "amd-checkout"

source $_this_dir/utils
source $_this_dir/common

var SkippedUpdates = []

proc try_git_update (;; srcdir, destname, url, branch) {
  try {
    var remotes = @(git remote show)
    if (remotes=>indexOf("origin") < 0) {
      error "'origin' not found in remotes"
    }
    var remote = 'origin'
    var rem_url = $(git remote get-url $remote)
    var current = $(git branch --show-current)
    if (rem_url !== url) {
      error "Remote url '$rem_url' is not '$url'"
    } elif (current !== branch) {
      error "Wrong branch '$current' checked out here, wanted '$branch'"
    } else {
      write "Already checked out $url @ $branch"
      var modifications = $(git status --porcelain)
      if (modifications !== "") {
        error "Local modifications in '$srcdir/$destname'"
      }
      var localcommits = $(git log $remote/$branch..HEAD)
      if (localcommits !== "") {
        error "Local commits in '$srcdir/$destname'"
      }
    }
  }
  if (_status === 0) {
    write "Attempting 'git pull --rebase'..."
    git pull --rebase
  } else {
    if ('message' in _error) {
      write "Couldn't update: $[_error.message]"
    } else {
      write "Couldn't update $destname"
    }
    append $destname (SkippedUpdates)
  }
}

# Move a checkout to a pinned commit (a detached HEAD), fetching it from
# 'origin' first if the clone doesn't have it.  Local modifications are never
# discarded: such a checkout is left alone and reported as a skipped update.
proc git_pin_commit (;; srcdir, destname, commit) {
  var Head = $(git rev-parse HEAD)
  if (Head === $(git rev-parse --verify --quiet "$commit^{commit}" || echo none)) {
    write "Already at pinned commit $commit"
    return
  }
  if ($(git status --porcelain --untracked-files=no) !== "") {
    write "Couldn't move to pinned commit: local modifications in '$srcdir/$destname'"
    append $destname (SkippedUpdates)
    return
  }
  if ! git cat-file -e "$commit^{commit}" 2>/dev/null {
    git fetch origin $commit
  }
  git checkout --detach $commit
}

proc git_checkout (;; srcdir, destname, url, branch, shallow, submods, blobless,
                      commit=null) {
  if (commit and shallow) {
    error "$destname: 'commit' pins can't be combined with shallow clones"
  }
  if test --dir "$srcdir/$destname" {
    cd "$srcdir/$destname" {
      if (commit) {
        git_pin_commit (srcdir=srcdir, destname=destname, commit=commit)
      } else {
        try_git_update (srcdir=srcdir, destname=destname, url=url, branch=branch)
      }
    }
  } else {
    cd $srcdir {
      var shallow_opt = :| --depth 1 | if shallow else ()
      var submod_opt = :| --recurse-submodules | if submods else ()
      var filter_opt = :| --filter=blob:none | if blobless else ()
      git clone @shallow_opt @submod_opt @filter_opt --branch $branch $url $destname
    }
    if (commit) {
      cd "$srcdir/$destname" {
        git_pin_commit (srcdir=srcdir, destname=destname, commit=commit)
      }
    }
  }
}

proc unpack_tar (;; srcdir, destname, tarfile, strip) {
  var unpack_dir = "$srcdir/$destname"
  maybe_mkdir $unpack_dir
  cd $unpack_dir {
    tar -x --strip-components=$strip -f $tarfile
  }
}

proc do_md5sum(filename) {
  try {
    var md5 = $(md5sum $filename)=>shSplit()[0]
  }
  if (_status === 0) {
    write -- $md5
  } else {
    error "md5sum failed for $filename"
  }
}

func filename_from_url(url) {
  return (split(url,"/")[-1])
}

proc fetch_tar (;; url, tmpdir, md5_expected) {
  cd $tmpdir {
    var filename = filename_from_url(url)
    try {
      if test --exists $filename {
        var md5 = $(do_md5sum $filename)
        if (md5 === md5_expected) {
          write "using existing download for $filename"
        } else {
          error "md5 mismatch for $filename: expected $md5_expected, got $md5"
        }
      } else {
        false
      }
    }
    if (_status === 0) {
      return 0
    }
    try {
      # -L: follow redirects (e.g. GitHub release downloads).
      curl -L -O $url
    }
    if (_status !== 0) {
      error "download failed for $url"
    }
    try {
      setvar md5 = $(do_md5sum $filename)
      if (md5 === md5_expected) {
        write "md5 matches for $filename"
      } else {
        error "md5 mismatch for $filename: expected $md5_expected, got $md5"
      }
    }
    return $_status
  }
  if (_status !== 0) {
    error "Download failed for $url"
  }
}

# This is pretty basic.  Make it smarter?
proc setup_worktree (;; srcdir, parent, comp, tobranch) {
  var fromdir = get_srcdir_rel(parent)
  var todir = get_srcdir_rel(comp)
  if ! test --dir "$srcdir/$todir" {
    cd "$srcdir/$fromdir" {
      git worktree add "$srcdir/$todir" $tobranch
    }
  } else {
    cd "$srcdir/$todir" {
      try_git_update (srcdir=srcdir, destname=todir, url=Sources[parent].url,
                      branch=tobranch)
    }
  }
}

proc do_downloads (; comps) {
  var download_comps = Components if len(comps) === 0 else comps
  var dirname_in_srcdir
  for comp in (download_comps) {
    setvar dirname_in_srcdir = get_srcdir_rel(comp)
    case (Sources[comp].type) {
      "git" {
        write "$comp: check out url: $[Sources[comp].url]"
        var SubMods = false
        if ('submodules' in Sources[comp]) {
          setvar SubMods = Sources[comp].submodules
        }
        var Blobless = false
        if ('blobless_clone' in Sources[comp]) {
          setvar Blobless = Sources[comp].blobless_clone
        }
        # Optionally pin to an exact commit on (or reachable from) the branch,
        # e.g. to reproduce the revisions recorded in an AOMP release manifest.
        var Commit = Sources[comp].commit if 'commit' in Sources[comp] else null
        git_checkout (srcdir=SRCDIR,
                      destname=dirname_in_srcdir,
                      url=Sources[comp].url,
                      branch=Sources[comp].version,
                      shallow=Sources[comp].shallow_clone,
                      submods=SubMods,
                      blobless=Blobless,
                      commit=Commit)
      }

      "archive" {
        write "$comp: download archive: $[Sources[comp].url]"
        fetch_tar (url=Sources[comp].url,
                   tmpdir=ARCHIVEDIR,
                   md5_expected=Sources[comp].md5)
        var tarfile_name = "$ARCHIVEDIR/$[filename_from_url(Sources[comp].url)]"
        unpack_tar (srcdir=SRCDIR,
                    destname=dirname_in_srcdir,
                    tarfile=tarfile_name,
                    strip=1)
      }

      "subcomponent" {
        write "$comp: subcomponent of $[Sources[comp].parent]"
      }

      "worktree" {
        true
      }

      * {
        error "$comp: Unknown source type '$[Sources[comp].type]'!"
      }
    }
  }

  # 2nd pass to set up worktrees (no dependency checking here!)
  for comp in (download_comps) {
    case (Sources[comp].type) {
      "worktree" {
        write "$comp: worktree shared with $[Sources[comp].parent]"
        setup_worktree (srcdir=SRCDIR,
                        parent=Sources[comp].parent,
                        comp=comp,
                        tobranch=Sources[comp].version)
      }
    }
  }
}

parse_args (ARGV)

source $CONFIGDIR/$ActiveCfg

add_optional_modules

maybe_mkdir $ARCHIVEDIR
maybe_mkdir $SRCDIR

do_downloads (TASKLIST)

modify_checkout

if (SkippedUpdates) {
  write
  # Red, should probably be conditional
  write -n b'\y1b[31;1;4m'
  write "Skipped updates for:"
  write -n b'\y1b[0m'
  write
  write @SkippedUpdates
}
