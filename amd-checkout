#!/usr/bin/env ysh

source --builtin args.ysh
source $_this_dir/common

proc git_checkout (;; srcdir, destname, url, branch) {
    if test --dir $srcdir/$destname {
        cd $srcdir/$destname {
            try {
                var remote = $(git remote show)
                var rem_url = $(git remote get-url $remote)
                var current = $(git branch --show-current)
                if (rem_url !== url) {
                    error "Remote url '$rem_url' is not '$url'"
                } elif (current === branch) {
                    error "Already checked out $url @ $branch"
                } elif (current !== "") {
                    error "Wrong branch '$current' checked out here, wanted '$branch'"
                } else {
                    error "Something other than '$branch' checked out"
                }
            }
            if (_status === 0) {
                if (current === branch) {
                    error "Already checked out $url @ $branch"
                } 
            }
        }
    }
    cd "$srcdir" {
        git clone --branch $branch $url $destname
    }
}

proc unpack_tar (;; srcdir, destname, tarfile, strip) {
    var unpack_dir = "$srcdir/$destname"
    maybe_mkdir $unpack_dir
    cd $unpack_dir {
        tar fxpv --strip-components=$strip $tarfile
    }
}

proc do_md5sum(filename) {
    try {
        var md5 = $(md5sum $filename)=>split()[0]
    }
    if (_status === 0) {
       write -- $md5
    } else {
       error "md5sum failed for $filename"
    }
}

proc fetch_tar (;; url, tmpdir, md5_expected) {
    cd $tmpdir {
        var filename = split(url,"/")[-1]
        try {
            if test --exists $filename {
                var md5 = $(do_md5sum $filename)
                if (md5 === md5_expected) {
                    write "using existing download for $filename"
                } else {
                    error "md5 mismatch for $filename: expected $md5_expected, got $md5"
                }
            }
        }
        if (_status === 0) {
            return 0
        }
        try curl -O $url
        if (_status !== 0) {
            error "download failed for $url"
        }
        try {
            setvar md5 = $(do_md5sum $filename)
            if (md5 === md5_expected) {
                write "md5 matches for $filename"
            } else {
                error "md5 mismatch for $filename: expected $md5_expected, got $md5"
            }
        }
        return $_status
    }
}

proc do_downloads (; comps) {
  var download_comps = Components if len(comps) === 0 else comps
  for comp in (download_comps) {
    case (Sources[comp].type) {
      "git" {
        write "$comp: check out url: $[Sources[comp].url]"
      }

      "archive" {
        write "$comp: download archive: $[Sources[comp].url]"
      }

      "subcomponent" {
        write "$comp: subcomponent of $[Sources[comp].parent]"
      }

      * {
        error "$comp: Unknown source type '$[Sources[comp].type]'!"
      }
    }
  }
}

parse_args (ARGV)

load_config

maybe_mkdir $ARCHIVEDIR

do_downloads (TASKLIST)
