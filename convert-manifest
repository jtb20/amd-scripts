#!/usr/bin/env ysh

if (len(ARGV) !== 1) {
  error "Usage: $0 <manifest>"
}

# There's supposed to be a str=>lower() method, but it doesn't seem to be
# working for some reason (ysh 0.21.0)
func tolower(str) {
  var repl = $(echo $str | tr '[:upper:]' '[:lower:]')
  return (repl)
}

func compare_paths(a, b) {
  var alen = len(a)
  var blen = len(b)
  var shorter = alen if (alen < blen) else blen
  if (a[0:shorter] !== b[0:shorter]) {
    return (null)
  }
  if (alen > blen) {
    return (1)
  } elif (alen < blen) {
    return (-1)
  }
  return (0)
}

func project_name(Orig) {
  var Name = tolower(Orig)=>split("/")
  return (Name[-1]=>replace('-', '_'))
}

# Make a few substitutions to get a reasonable version name.
func version_name(Orig) {
  var Name = Orig=>replace("rocm-", "")
  setvar Name = Name=>replace("release/", "")
  setvar Name = Name=>replace("/", "_")
  setvar Name = Name=>replace("-", "_")
  setvar Name = tolower(Name)
  return (Name)
}

var Input = ARGV[0]

try > /dev/null {
  xq -h | grep -F "jq wrapper for XML documents"
}
if (_status !== 0) {
  error "You need 'xq' installed to use this script, e.g. from the Homebrew package 'python-yq'."
}

# 'xq' doesn't like the comments in there, not sure if that's badly-formed
# XML or whatever, but never mind.  Filter them out.
sed 's,<!--.*-->,,g' < $Input | xq . | json read (&Mani)

var Remotes = {}
var SourceInfo = {}
var Default = Mani.manifest["default"]

func outermost_parent(ProjName) {
  var ParentName = SourceInfo[ProjName].parent
  if (ParentName === null) {
    return (ProjName)
  } else {
    return (outermost_parent(ParentName))
  }
}

for r in (Mani.manifest.remote) {
  var name = r["@name"]
  var fetch_url = r["@fetch"]
  setvar Remotes[name] = fetch_url
}

for p in (Mani.manifest.project) {
  var Name = p["@name"]
  var Groups = p["@groups"]
  if (Groups !== "skip") {
    setglobal SourceInfo[Name] = {}
    if ("@remote" in p) {
      setglobal SourceInfo[Name].url = Remotes[p["@remote"]]
      setglobal SourceInfo[Name].revision = p["@revision"]
    } else {
      setglobal SourceInfo[Name].url = Remotes[Default["@remote"]]
      setglobal SourceInfo[Name].revision = Default["@revision"]
    }
    setglobal SourceInfo[Name].path = p["@path"]=>split("/")
    setglobal SourceInfo[Name].parent = null
  }
}

for InnerName, InnerData in (SourceInfo) {
  var InnerPath = InnerData.path
  for OuterName, OuterData in (SourceInfo) {
    if (InnerName !== OuterName) {
      var Comp = compare_paths (InnerPath, OuterData.path)
      if (Comp === 1) {
        # No transitive closure here.
        setglobal InnerData.parent = OuterName
      }
    }
  }
}

write -- """
# Autogenerated from $(basename $Input) by convert-manifest
"""

var ProjectNames = []

for ProjName, ProjData in (SourceInfo) {
  var UseName = project_name (ProjName)
  if (ProjectNames=>indexOf(UseName) >= 0) {
    error "Duplicate project name $UseName"
  }
  call ProjectNames->append(UseName)
  if (ProjData.parent === null) {
    var FullPath = ProjData.url ++ ProjData.path=>join("/")
    write -- """
var ${UseName}_src = {
  "url" : "$FullPath",
  "type" : "git",
  "version" : "$[ProjData.revision]",
  "version_name" : "$[version_name (ProjData.revision)]",
  "shallow_clone" : false
}

add_sources ("$UseName", ${UseName}_src)
"""
  } else {
    var OuterParent = outermost_parent(ProjName)
    var ParentName = project_name (OuterParent)
    write -- """
var ${UseName}_src = {
  "type" : "subcomponent"
  "parent" : "$ParentName"
  "subdir" : "$[ProjData.path=>join("/")]"
}

add_sources ("$UseName", ${UseName}_src)
"""
  }
}

# json write (SourceInfo)