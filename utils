#!/usr/bin/env ysh

proc maybe_mkdir (where) {
  if ! test --dir $where {
    mkdir -p $where
  }
}

func dir_empty (where) {
  cd $where {
    # shopt "dotglob" appears to be unimplemented. This'll do.
    var files=glob("*")++glob(".*")
    return (len(files) === 2)
  }
}

proc copy_dir (Src, Dest) {
  write "Copying directory $Src to $Dest..."
  if test --dir $Dest {
    rm -rf -- $Dest
  }
  if test --exists $Dest {
    error "$Dest exists and is not a directory, stopping"
  }
  mkdir -p $(dirname $Dest)
  cp -a $Src $Dest
}

func lookup_func(name) {
  var fn = getVar(name)
  if (type(fn) === "Func") {
    return (fn)
  } else {
    error "Not a function: $name"
  }
}

proc time_now {
  date +"%H:%M:%S"
}

func in_list(item, inlist) {
  return (inlist=>indexOf(item) >= 0)
}

func list_remove(thelist, ...items) {
  var newlist = []
  for E in (thelist) {
    if (not in_list (E, items)) {
      call newlist->append(E)
    }
  }
  return (newlist)
}

func has_proc (procname) {
  try {
    var P = getVar(procname)
    return (type(P) === 'Proc')
  }
  return (false)
}

func have_binary (Binary) {
  try > /dev/null 2>&1 {
    if type -t $Binary {
      return (true)
    }
  }
  return (false)
}

proc clear_error () {
  setglobal _error.message = null
  setglobal _error.code = 0
}

# Take an array of arguments and return a string with arguments escaped
# suitably for passing to an underlying shell as a space-separated string.

func shell_quote_args(ArgArray) {
  return ($(printf '%q ' @ArgArray))
}

# Quote a string suitable for consumption by ysh itself, e.g. by "eval".

func ysh_quote_string(Arg) {
  return ("$(pp value (str(Arg)))"=>trimStart(/ '(Str)' s* /))
}

# Evaluate a block with a set of modified environment variables.  Call like:
#   with-env PATH=/foo/bar ARGS="-a -b -c" {
#     commands
#   }

proc with-env(...vars;;;block) {
  forkwait {
    var idx = 0
    while (idx < len(vars)) {
      case (vars[idx]) {
        *=* {
          var parts = vars[idx].split('=', count=1)
          setglobal ENV[parts[0]]=parts[1]
        }
        -u {
          setvar idx += 1
          call first(ENV)->erase(vars[idx])
        }
        * {
          error "syntax error: $[vars[idx]]"
        }
      }
      setvar idx += 1
    }
    call io->eval (block)
  }
}

# Prepend a set of paths to final argument, which names a colon-separated
# PATH-like shell variable. E.g:
#
# setglobal ENV.PATH=$(prepend_path "/usr/floop/bin" PATH)
# setglobal ENV.LD_LIBRARY_PATH=$(prepend_path "/usr/floop/lib" "/usr/local/floop/lib" LD_LIBRARY_PATH)
#
# Note this is a proc not a function, so we can pass the path variable name as
# an unadorned word.

proc prepend_path(...NewPaths) {
  var Path = ENV=>get(NewPaths[-1])
  setvar NewPaths = NewPaths[0:-1]
  if (Path) {
    write -- "$[NewPaths.join(':')]:$Path"
  } else {
    write -- "$[NewPaths.join(':')]"
  }
}
