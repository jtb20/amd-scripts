proc add_task (name) {
  append $name (TASKARR)
}

proc standard_tasks (component) {
  add_task "clean_$component"
  add_task "configure_$component"
  add_task "build_$component"
  add_task "install_$component"
}

standard_tasks llvm
standard_tasks device_libs
standard_tasks comgr
#standard_tasks composable_kernel

func get_srcdir (component) {
  # It seems like evalExpr "..." might be better here somehow, but it doesn't
  # seem to work like that (yet?)
  eval "var COMPONENT_SRC = get_${component}_src()"
  return ("$SRCDIR/$COMPONENT_SRC")
}

func get_objdir (component) {
  return ("$OBJDIR/$component")
}

func get_installdir (component) {
  return ("$INSTALLDIR/$component")
}

proc clean_component (component) {
  var OBJDIR = get_objdir(component)
  if test --dir $OBJDIR {
    rm -rf $OBJDIR/*
  } else {
    mkdir -p $OBJDIR
  }
}

maybe_mkdir $LOGDIR
maybe_mkdir $OBJDIR
maybe_mkdir $INSTALLDIR

do_tasks (TASKLIST)
