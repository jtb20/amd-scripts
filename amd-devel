proc print_tasks {
  for i, task in (TASKARR) {
    printf u'%.3d: %s\n' "$i" "$task"
  }
}

proc do_task_number (; num) {
  var taskfn = TASKARR[num]
  printf u'%d: %s\n' "$num" "$taskfn"
  eval "$taskfn"
}

proc do_tasks (; todo) {
  #local TASKS=$@
  #local START
  #local END
  #local TASK
  #local LASTTASK
  var task = -1
  var nexttask = -1
  var Range = / <capture digit+ as start : int> '--' <capture digit+ as end : int> /
  if (len(todo) === 0) {
    setvar todo = ("0", "continue")
  }
  for t in (todo) {
    if (t ~ Range) {
      var starttask = _group('start')
      var endtask = _group('end')
      for i in (starttask .. endtask+1) {
        do_task_number (i)
      }
      setvar nexttask = endtask+1
    } elif (t ~ /<capture digit+ as tasknum: int>/) {
      setvar task = _group('tasknum')
      do_task_number (task)
      setvar nexttask = task+1
    } elif (t === "continue") {
      setvar task = nexttask
      for i, task in (TASKARR[task:]) {
        do_task_number (i)
      }
      setvar nexttask = len(TASKARR)
    } elif (t === "list") {
      print_tasks
      exit 0
    }
  }
}
  
