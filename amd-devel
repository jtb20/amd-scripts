#!/bin/bash
set -e

WORKDIR="$(pwd)"

SCRIPTDIR="$WORKDIR/amd-scripts"
SRCDIR="$WORKDIR/src"
LOGDIR="$WORKDIR/logs"
OBJDIR="$WORKDIR/obj"
INSTALLDIR="$WORKDIR/install"

TASKLIST=$*
TASKARR=()

source "$WORKDIR/llvm"
source "$WORKDIR/comgr"
source "$WORKDIR/device_libs"
source "$WORKDIR/composable_kernels"

echo "HIP_CLANG_PATH: $HIP_CLANG_PATH"
echo "ROCM_PATH: $ROCM_PATH"
echo "HIP_PATH: $HIP_PATH"
echo "LLVM_PATH: $LLVM_PATH"
echo "PATH: $PATH"

print_tasks() {
  local i
  local NUMTASKS="${#TASKARR[@]}"
  echo "num tasks: $NUMTASKS"
  for (( i = 0; i < NUMTASKS; i++ )); do
    printf "%d: %s\n" "$i" "${TASKARR[i]}"
  done
}

do_task_number() {
  local NUM=$1
  local TASKFN="${TASKARR[$NUM]}"
  printf "%d: %s\n" "$NUM" "$TASKFN"
  eval "$TASKFN"
}

do_tasks() {
  local TASKS=$@
  local START
  local END
  local TASK
  local LASTTASK
  if [ "$TASKS" ]; then
    set $TASKS
  else
    LASTTASK=0
    TASKS="continue"
    set $TASKS
  fi
  while [ ${#@} -gt 0 ]; do
    case "$1" in
      *--*)
	      START="${1%--*}"
	      END="${1#*--}"
	      if ! [ "$START" ] || ! [ "$END" ]; then
		      echo "Missing start or end"
		      exit 1
	      fi
	      for (( i = START; i <= END; i++ )); do
	        do_task_number "$i"
              done
	      LASTTASK=$(( $END + 1 ))
	      ;;
      continue)
	      FINAL="${#TASKARR[@]}"
	      for (( i = LASTTASK; i < FINAL; i++ )); do
	        do_task_number "$i"
              done
	      ;;
      list)
	      print_tasks
	      exit 0
	      ;;
      *)
              do_task_number "$1"
	      LASTTASK=$(( $1 + 1 ))
	      ;;
      esac
    shift 1
  done
  return 1
}

add_task() {
  local NEWTASK=$1
  TASKARR=("${TASKARR[@]}" "$NEWTASK")
}

standard_tasks() {
  local COMPONENT=$1
  add_task "clean_$COMPONENT"
  add_task "configure_$COMPONENT"
  add_task "build_$COMPONENT"
  add_task "install_$COMPONENT"
}

standard_tasks llvm
standard_tasks device_libs
standard_tasks comgr
#standard_tasks composable_kernel

print_srcdir() {
  local COMPONENT=$1
  local COMPONENT_SRC="$(eval print_${COMPONENT}_src)"
  echo "$SRCDIR/$COMPONENT_SRC"
}

print_objdir() {
  local COMPONENT=$1
  echo "$OBJDIR/$COMPONENT"
}

print_installdir() {
  local COMPONENT=$1
  echo "$INSTALLDIR/$COMPONENT"
}

clean_component() {
  local COMPONENT=$1
  local OBJDIR="$(print_objdir "$COMPONENT")"
  if [ -d "$OBJDIR" ]; then
    rm -rf "$OBJDIR"/*
  else
    mkdir -p "$OBJDIR"
  fi
}

do_tasks $TASKLIST
