#!/usr/bin/env ysh
#set -e

source --builtin args.ysh
source $_this_dir/common

var TASKLIST=ARGV
var TASKARR=()
var CurrentLogFile

proc print_tasks {
  if (len(TASKARR) === 0) {
    error "No tasks!"
  }
  for i, task in (TASKARR) {
    printf u'%.3d: %s\n' $[i+1] $task
  }
}

proc do_task_number (; num) {
  var taskidx = num-1
  var taskfn = TASKARR[taskidx]
  var logname=$(printf u'%.3d-%s.log' $num $taskfn)
  var numtasks = len(TASKARR)
  setglobal CurrentLogFile="$LOGDIR/$logname"
  printf u'[%s] [%.3d/%.3d]: start %s\n' $(time_now) $num $numtasks $taskfn
  eval "$taskfn" >> $CurrentLogFile
  printf u'[%s] [%.3d/%.3d]: finish %s\n' $(time_now) $num $numtasks $taskfn
}

proc do_tasks (; todo) {
  var task = -1
  var nexttask = -1
  var Range = / <capture digit+ as start : int> '--' <capture digit+ as end : int> /
  if (len(todo) === 0) {
    setvar todo = ("1", "continue")
  }
  for t in (todo) {
    if (nexttask > len(TASKARR)) {
      :
    } elif (t ~ Range) {
      var starttask = _group('start')
      var endtask = _group('end')
      for i in (starttask .. endtask+1) {
        do_task_number (i)
      }
      setvar nexttask = endtask+1
    } elif (t ~ /<capture digit+ as tasknum: int>/) {
      setvar task = _group('tasknum')
      do_task_number (task)
      setvar nexttask = task+1
    } elif (t === "continue") {
      for i in (nexttask .. len(TASKARR)+1) {
        do_task_number (i)
      }
      setvar nexttask = len(TASKARR)+1
    } elif (t === "list") {
      print_tasks
      exit 0
    }
  }
}

func get_srcdir (component) {
  var COMPONENT_SRC = lookup_func("get_${component}_src")()
  return ("$SRCDIR/$COMPONENT_SRC")
}

func get_objdir (component) {
  return ("$OBJDIR/$component")
}

func get_installdir (component) {
  return ("$INSTALLDIR/$component")
}

proc clean_component (component) {
  var OBJDIR = get_objdir(component)
  if test --dir $OBJDIR {
    rm -rf $OBJDIR/*
  } else {
    mkdir -p $OBJDIR
  }
}

maybe_mkdir $LOGDIR
maybe_mkdir $OBJDIR
maybe_mkdir $INSTALLDIR

parse_args (ARGV)

load_config

elaborate_tasks

do_tasks (TASKLIST)
