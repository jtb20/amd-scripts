#!/usr/bin/env ysh

proc clean_aqlprofile() {
  clean_component aqlprofile
}

func get_aqlprofile_src() {
  return (get_src_default ("aqlprofile"))
}

proc configure_aqlprofile() {
  var Build = get_objdir("aqlprofile")
  var Src = get_srcdir("aqlprofile")
  var BuildType = get_build_type("aqlprofile")
  var Tool = get_build_tool("aqlprofile")
  var GPUList = join(ConfigureOpts.llvm.gfxlist, ',')
  cd $Build {
    with-env HIPCC_COMPILE_FLAGS_APPEND="--rocm-path=$INSTALLDIR --offload-arch=$GPUList" {
      rocm_env cmake -G $Tool -DCMAKE_INSTALL_PREFIX=$INSTALLDIR \
        -DCMAKE_BUILD_TYPE=$BuildType \
        -DCMAKE_MODULE_PATH=$Src/cmake_modules \
        -DCMAKE_PREFIX_PATH=$INSTALLDIR \
	      -DROCM_PATH=$INSTALLDIR \
        -DBUILD_SHARED_LIBS=YES \
        -DENABLE_LDCONFIG=OFF \
        -DGPU_TARGETS=$GPUList \
        -DCPACK_OBJCOPY_EXECUTABLE=$INSTALLDIR/llvm/bin/llvm-objcopy \
        -DCPACK_READELF_EXECUTABLE=$INSTALLDIR/llvm/bin/llvm-readelf \
        -DCPACK_STRIP_EXECUTABLE=$INSTALLDIR/llvm/bin/llvm-strip \
        -DCPACK_OBJDUMP_EXECUTABLE=$INSTALLDIR/llvm/bin/llvm-objdump \
        $Src
    }
  }
}

proc build_aqlprofile() {
  rocm_env cmake_build aqlprofile
}

# This is actually prerequisite for the "install" step, because it builds
# some artifacts (e.g. in test/simple_convolution/...)
proc test_aqlprofile() {
  var Build = get_objdir("aqlprofile")
  var Tool = get_build_tool("aqlprofile")
  var GPUList = join(ConfigureOpts.llvm.gfxlist, ',')
  cd $Build {
    if (Tool === "Ninja") {
      rocm_env ninja test
    } else {
      rocm_env make test
    }
  }
}

proc install_aqlprofile() {
  rocm_env cmake_install aqlprofile
}

func aqlprofile_dependencies() {
  return (:| llvm hipamd |)
}

proc aqlprofile_tasks() {
  add_tasks aqlprofile clean configure build test install
}
