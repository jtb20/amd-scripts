# The "smoke" and "smoke_fails" testsuites (and similar) use the same
# arrangement to report their test results.  Process that into a .sum file
# here.

proc gather_smoketests_results(which, reldir; known_fails=null) {
  var BuildDir = get_objdir (which)
  cd $BuildDir/$reldir {
    rm -f ${which}-tmp.sum
    if test --exists passing-tests.txt {
      cat passing-tests.txt | while read n {
        if (known_fails !== null and in_list(n, known_fails)) {
          write "XPASS: $n"
        } else {
          write "PASS: $n"
        }
      } >> ${which}-tmp.sum
    }
    if test --exists failing-tests.txt {
      cat failing-tests.txt | while read n {
        if (known_fails !== null and in_list(n, known_fails)) {
          write "XFAIL: $n"
        } else {
          write "FAIL: $n"
        }
      } >> ${which}-tmp.sum
    }
    if test --exists make-fail.txt {
      var n
      cat make-fail.txt | while read n {
        setvar n = n=>trimEnd(": Make Failed")
        if (known_fails !== null and in_list(n, known_fails)) {
          write "XFAIL: $n"
        } else {
          write "ERROR: $n"
        }
      } >> ${which}-tmp.sum
    }
    sort --key=2 ${which}-tmp.sum > $TESTRESULTSDIR/$which.sum
    rm -f ${which}-tmp.sum
  }
}

proc select_smoke_tests (; Pattern) {
  var DoTests = []
  for Test in * {
    if test --dir $Test {
      if (Test ~~ "*${Pattern}*") {
        append $Test (DoTests)
      } else {
        # OK, this is revolting.  We know we have a fresh copy of the
        # test dir.  We can disable tests by moving them out of the way.
        # FIXME: do it more nicely.
        mv $Test .$Test
      }
    }
  }
  write "Running selected tests: $[DoTests=>join(' ')]"
}

func extract_smoke_known_fails(Script) {
    # Yes, we're really extracting the known failing tests from a shell
    # script here.  That's where the info is...
    var known_fails_line = $(grep -F "known_fails=" $Script)
    var pattern = / 'known_fails="' <capture ![\"]* as testnames> '"' /

    var xfails = []

    if (known_fails_line ~ pattern) {
      setvar xfails = _group('testnames')=>split()
    }

  return (xfails)
}

### SMOKE ###

proc clean_results_aomp_smoke() {
  clean_component smoke
}

func get_smoke_src() {
  return (get_src_default ("smoke"))
}

proc test_aomp_smoke {
  var AOMP_Src = get_srcdir ("aomp")
  var Source = get_srcdir ("smoke")
  var Obj = get_objdir ("smoke")
  var GPUs = get_amd_gpus ()
  # These tests write into their source directory.  Copy to obj dir and
  # run from there.
  rm -rf $Obj
  copy_dir $Source $Obj/test/smoke
  ln -sf $AOMP_Src/bin $Obj/bin
  ln -sf $AOMP_Src/test/Makefile.defs $Obj/test
  cd $Obj/test/smoke {
    shvar AOMP=$INSTALLDIR \
          LD_LIBRARY_PATH=$INSTALLDIR/lib/x86_64-unknown-linux-gnu \
          AOMP_PARALLEL_SMOKE=1 \
          AOMP_GPU="$[GPUs[0]]" \
          SHELL=/bin/bash {
      export AOMP
      export LD_LIBRARY_PATH
      export AOMP_PARALLEL_SMOKE
      export AOMP_GPU
      # In case SHELL is set by some other login shell (tcsh, ...), reset it
      # here.  Otherwise e.g. "flock -c ..." uses the wrong shell inside
      # check_smoke.sh.
      export SHELL
      if (SelectTests !== null) {
        select_smoke_tests (SelectTests)
        export AOMP_PARALLEL_SMOKE=0
      }
      CLEANUP=0 gpu_opts ./check_smoke.sh
      ./check_smoke.sh gatherdata
    }
  }
}

proc save_results_aomp_smoke (; files) {
  gather_smoketests_results smoke test/smoke
  call files->setValue (:| smoke.sum |)
}

