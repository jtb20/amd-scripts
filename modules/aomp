### SMOKE SUITES SHARING check_smoke.sh ###
#
# smoke-fort, smoke-fort-limbo, smoke-fort-dev and smoke-asan each run the
# smoke directory's check_smoke.sh (their check_*.sh is a symlink to it), and
# record their results as the smoke tests do.

proc run_smoke_style_suite(comp, dirname, script) {
  var AOMP_Src = get_srcdir ("aomp")
  var Source = get_srcdir (comp)
  var Obj = get_objdir (comp)
  var GPUs = get_amd_gpus ()
  # These tests write into their source directory.  Copy to obj dir and run
  # from there, with the parts of the AOMP tree they refer to alongside.
  rm -rf $Obj
  copy_dir $Source $Obj/test/$dirname
  ln -sf $AOMP_Src/bin $Obj/bin
  ln -sf $AOMP_Src/test/Makefile.defs $Obj/test
  mkdir -p $Obj/test/smoke
  ln -sf $AOMP_Src/test/smoke/Makefile.rules $Obj/test/smoke
  ln -sf $AOMP_Src/test/smoke/check_smoke.sh $Obj/test/smoke
  cd $Obj/test/$dirname {
    with-env AOMP_PARALLEL_SMOKE=1 \
             AOMP_GPU="$[GPUs[0]]" \
             SHELL=/bin/bash \
             CLEANUP=0 {
      if (SelectTests !== null) {
        select_smoke_tests (SelectTests)
        setglobal ENV.AOMP_PARALLEL_SMOKE=0
      }
      rocm_env gpu_opts ./$script
      rocm_env ./$script gatherdata
    }
  }
}

