  var GPUs = get_amd_gpus ()
  copy_dir $Source $Obj
  var LibDir = "$INSTALLDIR/lib/x86_64-unknown-linux-gnu"
  sed -i "s,LIBS = \"\",LIBS = \" -L$LibDir\"," $Obj/test.py
  cd $Obj {
    shvar AOMP=$INSTALLDIR \
          AOMP_GPU=$[GPUs[0]] \
          LD_LIBRARY_PATH=$INSTALLDIR/lib/x86_64-unknown-linux-gnu {
      export AOMP
      export AOMP_GPU
      export LD_LIBRARY_PATH

      ./check_LLNL.sh log $Obj
    }
  }
}

