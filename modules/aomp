### HIP-OPENMP ###

func get_hip_openmp_src() {
  var AOMP_Src = get_aomp_src()
  var Relative = Sources.hip_openmp.subdir
  return ("$AOMP_Src/$Relative")
}

proc clean_results_aomp_hip_openmp() {
  clean_component hip_openmp
}

proc test_aomp_hip_openmp {
  var AOMP_Src = get_srcdir ("aomp")
  var Source = get_srcdir ("hip_openmp")
  var Obj = get_objdir ("hip_openmp")
  rm -rf $Obj
  copy_dir $Source $Obj/hip-openmp
  ln -sf $AOMP_Src/test/Makefile.defs $Obj
  cd $Obj/hip-openmp {
    shvar AOMP=$INSTALLDIR \
          LD_LIBRARY_PATH=$INSTALLDIR/lib/x86_64-unknown-linux-gnu {
      export AOMP
      export LD_LIBRARY_PATH
      ./check_hip-openmp.sh
    }
  }
}

proc save_results_aomp_hip_openmp (; files) {
  var Obj = get_objdir ("hip_openmp")
  cd $Obj/hip-openmp {
    # Yes, we're really extracting the known failing tests from the shell
    # script here.  That's where the info is...
    var known_fails_line = $(grep -F "known_fails=" check_hip-openmp.sh)
    var pattern = / 'known_fails="' <capture ![\"]* as testnames> '"' /

    var xfails = []

    if (known_fails_line ~ pattern) {
      setvar xfails = _group('testnames')=>split()
    }

    var resultline = / 'Return Code for ' <capture ![':']+ as testname> \
                      ':' s* <capture digit+ as res: int> /

    cat hip-openmp-check.txt | while read n {
      if (n ~ resultline) {
        if (_group('res') === 0) {
          if (xfails=>indexOf(_group('testname')) >= 0) {
            write "XPASS: $[_group('testname')]"
          } else {
            write "PASS: $[_group('testname')]"
          }
        } elif (xfails=>indexOf(_group('testname')) >= 0) {
          write "XFAIL: $[_group('testname')]"
        } else {
          write "FAIL: $[_group('testname')]"
        }
      }
    } > $TESTRESULTSDIR/hip_openmp.sum
  }
  call files->setValue (:| hip_openmp.sum |)
}

