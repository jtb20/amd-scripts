proc llnl_tasks {
  # No tasks!
  true
}

proc clean_results_aomp_llnl () {
  clean_component llnl
}

proc test_aomp_llnl {
  var Source = get_srcdir ("llnl")
  var Obj = get_objdir ("llnl")
  var GPUs = get_amd_gpus ()
  copy_dir $Source $Obj
  var LibDir = "$INSTALLDIR/lib/x86_64-unknown-linux-gnu"
  sed -i "s,LIBS = \"\",LIBS = \" -L$LibDir\"," $Obj/test.py
  cd $Obj {
    shvar PATH=$[sanitize_path (PATH)] \
          AOMP=$INSTALLDIR \
          AOMP_GPU=$[GPUs[0]] \
          LD_LIBRARY_PATH=$INSTALLDIR/lib/x86_64-unknown-linux-gnu \
          BLOG_DATE=today {
      export PATH
      export AOMP
      export AOMP_GPU
      export LD_LIBRARY_PATH
      export BLOG_DATE

      try {
        # This script (or the python program it calls) does something strange
        # with file descriptors, such that it's difficult to capture its output
        # successfully if output is already redirected (as we have here).
        # Try to work around that.  (This didn't work; we fixed the Python
        # script instead.)
        #expect <<< """
        #spawn ./check_LLNL.sh
        #expect eof
        #lassign [wait] pid spawn_id os_error_flag exit_status
        #exit \$exit_status
        #"""
        ./check_LLNL.sh log $Obj
      }
      if (_status === 0) {
        write "Success."
      } else {
        write "Failure."
      }
    }
  }
}

proc save_results_aomp_llnl (; files) {
  var Obj = get_objdir ("llnl")
  cd $Obj {
    var comp_passed = / 'Compiling' s+ <capture !s+ as testname> /
    var comp_failed = / 'Compilation of' s+ <capture !s+ as testname> s+ 'failed' /
    var run_passed = / 'Running' s+ <capture !s+ as testname> s+ '... Passed' /
    var run_failed = / 'Running' s+ <capture !s+ as testname> s+ '... Failed' /
    var name
    cat LLNL.run.log.today | while read n {
      if (n ~ comp_passed) {
        write "PASS: $[_group('testname')] compile"
      } elif (n ~ comp_failed) {
        setvar name = _group('testname')=>trimEnd(/ '.' alnum+ /)
        write "FAIL: $name compile"
      } elif (n ~ run_passed) {
        write "PASS: $[_group('testname')] run"
      } elif (n ~ run_failed) {
        write "FAIL: $[_group('testname')] run"
      }
    } > llnl.sum.tmp
    # It seems more useful to have this all glued together.  Let's do that.
    cat LLNL.run.log.today | while read n {
      if (n ~ comp_failed) {
        setvar name = _group('testname')=>trimEnd(/ '.' alnum+ /)
        var errfile = "${name}.ERR"
        if test --exists $errfile {
          cat $errfile
          write
        } else {
          # Not a disaster, but make a note of it for the unsuspecting user.
          write "Expected error output file ${name}.ERR not found"
        }
      }
      write -- $n
    } > $TESTRESULTSDIR/llnl.log
    sort --key=2 llnl.sum.tmp > $TESTRESULTSDIR/llnl.sum
    rm -f llnl.sum.tmp
    call files->setValue (:| llnl.sum |)
  }
}

