### BABELSTREAM ###
#
# AOMP's run_babelstream.sh and run_fBabel.sh build and run BabelStream (C++,
# and its Fortran version) in several modes, and record one result for the
# lot.  Run them once per mode instead, on a private copy of the BabelStream
# repository (run_babelstream.sh checks out a particular commit and patches
# it), and record a result for each mode: "<comp>/<mode>".  --select
# takes a glob matching mode names.

func get_babelstream_src() {
  return (get_src_default ("babelstream"))
}

func babelstream_dependencies() {
  return ([])
}

