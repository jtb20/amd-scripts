proc fortran_babelstream_tasks {
  # No tasks!
  true
}

# Run AOMP's 'script' for each of 'modes' with the result files in a private
# copy of BabelStream; 'var_prefix' is the script's prefix for its _REPO and
# _BUILD variables.  Writes $Obj/results-tmp.sum.
proc run_babelstream_suite(comp, script, var_prefix;; modes) {
  var AOMP_Src = get_srcdir ("aomp")
  var Obj = get_objdir (comp)
  var LLVM_Inst = get_installdir ('llvm')
  var GPUs = get_amd_gpus ()
  var Repo = "$Obj/repo/babelstream"
  rm -rf $Obj
  copy_dir $[get_srcdir ("babelstream")] $Repo
  var Lines = []
  for Mode in (modes) {
    if (SelectTests !== null and not (Mode ~~ SelectTests)) {
      continue
    }
    cd $Repo {
      rm -f passing-tests.txt failing-tests.txt make-fail.txt
    }
    write "=== $comp: $Mode ==="
    try {
      with-env AOMP=$LLVM_Inst \
               AOMPHIP=$INSTALLDIR \
               GPURUN_BINDIR=$LLVM_Inst/bin \
               AOMP_GPU="$[GPUs[0]]" \
               AOMP_REPOS_TEST=$Obj/repo \
               AOMP_BABELSTREAM_REPO_NAME=babelstream \
               "${var_prefix}_REPO=$Repo" \
               "${var_prefix}_BUILD=$Obj/build-$Mode" \
               RUN_OPTIONS=$Mode {
        rocm_env bash $AOMP_Src/bin/$script
      }
    }
    var Result = 'FAIL'
    if test --exists $Repo/passing-tests.txt {
      setvar Result = 'PASS'
    } elif test --exists $Repo/make-fail.txt {
      setvar Result = 'ERROR'
    }
    append "$Result: $comp/$Mode" (Lines)
  }
  write -- @Lines > $Obj/results-tmp.sum
}

proc clean_results_aomp_babelstream() {
  clean_component babelstream
}

proc test_aomp_babelstream {
  # run_babelstream.sh's defaults for AMD GPUs without unified shared memory,
  # less "stdpar", which needs rocThrust (not built here).
  run_babelstream_suite babelstream run_babelstream.sh BABELSTREAM (
    modes=:| omp-default omp-fast hip |)
}

