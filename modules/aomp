### LLNL ###

func get_llnl_src() {
  return (get_src_default ("llnl"))
}

func llnl_dependencies() {
  return ([])
}

proc llnl_tasks {
  # No tasks!
  true
}

proc clean_results_aomp_llnl () {
  clean_component llnl
}

proc test_aomp_llnl {
  var Source = get_srcdir ("llnl")
  var Obj = get_objdir ("llnl")
  var GPUs = get_amd_gpus ()
  copy_dir $Source $Obj
  var LLVM_Inst = get_installdir('llvm')
  var LibDir = "$LLVM_Inst/lib/x86_64-unknown-linux-gnu"
  sed -i "s,LIBS = \"\",LIBS = \" -L$LibDir\"," $Obj/test.py
  cd $Obj {
    with-env PATH=$[sanitize_path (ENV.PATH)] \
             AOMP_GPU=$[GPUs[0]] \
             BLOG_DATE=today {

      if (SelectTests !== null) {
        # !!! The check_LLNL.sh script adds
        # test_requires_unified_shared_memory.cxx itself.  But it doesn't use
        # set -e, so we can override its behaviour by forcing the file
        # permissions.  (Yuck!)
        try {
          lspci | grep -Fq VMware
        }
        if (_pipeline_status[1] !== 0) {
          echo test_requires_unified_shared_memory.cxx >> $Obj/test_list
        }
        cat $Source/test_list | while read n {
          if (n ~~ "*${SelectTests}*") {
            write -- $n
          }
        } > $Obj/test_list_tmp
        mv -f test_list_tmp test_list
        chmod a-w $Obj/test_list
      }

      try {
        rocm_env ./check_LLNL.sh log $Obj
      }
      if (_status === 0) {
        write "Success."
      } else {
        write "Failure."
      }
    }
  }
}

proc save_results_aomp_llnl (; files) {
  var Obj = get_objdir ("llnl")
  cd $Obj {
    var comp_passed = / 'Compiling' s+ <capture !s+ as testname> /
    var comp_failed = / 'Compilation of' s+ <capture !s+ as testname> s+ 'failed' /
    var run_passed = / 'Running' s+ <capture !s+ as testname> s+ '... Passed' /
    var run_failed = / 'Running' s+ <capture !s+ as testname> s+ '... Failed' /
    var name
    cat LLNL.run.log.today | while read n {
      if (n ~ comp_passed) {
        write "PASS: $[_group('testname')] compile"
      } elif (n ~ comp_failed) {
        setvar name = _group('testname')=>trimEnd(/ '.' alnum+ /)
        write "FAIL: $name compile"
      } elif (n ~ run_passed) {
        write "PASS: $[_group('testname')] run"
      } elif (n ~ run_failed) {
        if test --exists xfail-list && \
           boolstatus grep -Fq "$[_group('testname')] run" xfail-list {
          write "XFAIL: $[_group('testname')] run"
        } else {
          write "FAIL: $[_group('testname')] run"
        }
      }
    } > llnl.sum.tmp
    # It seems more useful to have this all glued together.  Let's do that.
    cat LLNL.run.log.today | while read n {
      if (n ~ comp_failed) {
        setvar name = _group('testname')=>trimEnd(/ '.' alnum+ /)
        var errfile = "${name}.ERR"
        if test --exists $errfile {
          cat $errfile
          write
        } else {
          # Not a disaster, but make a note of it for the unsuspecting user.
          write "Expected error output file ${name}.ERR not found"
        }
      }
      write -- $n
    } > $TESTRESULTSDIR/llnl.log
    sort --key=2 llnl.sum.tmp > $TESTRESULTSDIR/llnl.sum
    rm -f llnl.sum.tmp
    call files->setValue (:| llnl.sum |)
  }
}

