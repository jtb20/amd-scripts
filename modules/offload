#!/usr/bin/env ysh

proc clean_offload(var) {
  clean_component offload $var
}

func get_offload_src() {
  return (get_src_default ("offload"))
}

proc configure_offload(var) {
  var Build = get_objdir("offload", var)
  var LLVM_Build = get_objdir("llvm")
  var LLVM_Cfg = ConfigureOpts["llvm"]
  var BuildType = get_build_type("offload")
  var Src = get_srcdir("offload")
  var Tool = get_build_tool("offload")
  var LLVM_Inst = get_installdir('llvm')
  var Cfg = get_configure_opts('offload', var)
  cd $Build {
    cmake -G $Tool -DCMAKE_INSTALL_PREFIX=$LLVM_Inst \
      -DCMAKE_PREFIX_PATH="$INSTALLDIR/lib/cmake;$INSTALLDIR/lib64/cmake" \
      -DCMAKE_BUILD_TYPE=$BuildType \
      -DOPENMP_ENABLE_LIBOMPTARGET=1 \
      -DOPENMP_TEST_C_COMPILER=$LLVM_Inst/bin/clang \
      -DOPENMP_TEST_CXX_COMPILER=$LLVM_Inst/bin/clang++ \
      -DCMAKE_C_COMPILER=$LLVM_Inst/bin/clang \
      -DCMAKE_CXX_COMPILER=$LLVM_Inst/bin/clang++ \
      -DLIBOMPTARGET_AMDGCN_GFXLIST=$[LLVM_Cfg.gfxlist=>join(';')] \
      -DLIBOMPTARGET_ENABLE_DEBUG=ON \
      -DLLVM_DIR=$LLVM_Build \
      -DROCM_DIR=$INSTALLDIR \
      @[get_rpath_opts('offload', var)] \
      @Cfg \
      $Src
  }
}

proc build_offload(var) {
  cmake_build offload $var
}

proc install_offload(var) {
  cmake_install offload $var
}

func offload_dependencies() {
  return (:| llvm device_libs comgr rocr_runtime |)
}

proc offload_tasks {
  standard_tasks offload
}
