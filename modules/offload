#!/usr/bin/env ysh

proc clean_offload() {
  clean_component offload
}

func get_offload_src() {
  var LLVM_Src = get_llvm_src()
  var Relative = Sources.offload.subdir
  return ("$LLVM_Src/$Relative")
}

proc configure_offload() {
  var Build = get_objdir("offload")
  var LLVM_Build = get_objdir("llvm")
  var BuildType = get_build_type("offload")
  var Src = get_srcdir("offload")
  var Tool = get_build_tool("offload")
  cd $Build {
    cmake -G $Tool -DCMAKE_INSTALL_PREFIX=$INSTALLDIR \
      -DCMAKE_BUILD_TYPE=$BuildType \
      -DOPENMP_ENABLE_LIBOMPTARGET=1 \
      -DOPENMP_TEST_C_COMPILER=$INSTALLDIR/bin/clang \
      -DOPENMP_TEST_CXX_COMPILER=$INSTALLDIR/bin/clang++ \
      -DCMAKE_C_COMPILER=$INSTALLDIR/bin/clang \
      -DCMAKE_CXX_COMPILER=$INSTALLDIR/bin/clang++ \
      -DLIBOMPTARGET_ENABLE_DEBUG=ON \
      -DLLVM_DIR=$LLVM_Build
      $Src
  }
}

proc build_offload() {
  cmake_build offload
}

proc install_offload() {
  cmake_install offload
}

func offload_dependencies() {
  return (:| llvm device_libs comgr |)
}

proc offload_tasks {
  standard_tasks offload
}
