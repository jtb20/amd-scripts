func get_genasis_src() {
  return (get_src_default ("genasis"))
}

func genasis_dependencies() {
  return (:| silo hdf5 openmpi |)
}

proc genasis_tasks {
  # No tasks!
  true
}

proc run_genasis_test_script(ScriptName, Suf) {
  var AOMP_Src = get_srcdir ("aomp")
  var Source = get_srcdir ("genasis")
  var Obj = "$[get_objdir ("genasis")]$Suf"
  var GPUs = get_amd_gpus()
  var LLVM_Inst = get_installdir('llvm')

  write "Found GPUs: $[GPUs=>join(",")]"

  copy_dir $Source $Obj

  var Parts = Obj=>split('/')

  cd $OBJDIR {
    # Old versions of run_genasis.sh hardcode the test dir name, so hackily
    # allow for that...
    ln -sf $[Parts[-1]] GenASis
  }

  with-env AOMP=$LLVM_Inst \
           AOMPHIP=$INSTALLDIR \
           HIP_DIR=$INSTALLDIR \
           ROCM=$INSTALLDIR \
           AOMP_GPU=$[GPUs[0]] \
           AOMP_REPOS_TEST=$[Parts[:-1]=>join('/')] \
           SRC_DIR=$[Parts[-1]] \
           AOMP_SUPP=$INSTALLDIR/aomp-support \
           ENABLE_OMP_OFFLOAD=1 {
    cd $AOMP_Src/bin {
      try {
        rocm_env ./$ScriptName
      }
      if (_error.code === 0) {
        write "Success."
      } else {
        write "Failure."
      }
    }
  }
}

proc test_misc_genasis() {
  run_genasis_test_script run_genasis.sh ""
}

proc clean_results_misc_genasis () {
  var Obj = get_objdir ("genasis")
  cd $Obj {
    rm -f genasis.run.log*
  }
}

proc save_results_misc_genasis (; files) {
  var Obj = get_objdir ("genasis")
  var FoundResults = false
  
  if (FoundResults) {
    call files->setValue (:| genasis.sum |)
  }
}

proc test_misc_genasis_flang_new() {
  run_genasis_test_script run_genasis_flang_new.sh "_flang_new"
}

proc clean_results_misc_genasis_flang_new() {
  true
}

proc save_results_misc_genasis_flang_new(; files) {
  true
}
