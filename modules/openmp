#!/usr/bin/env ysh

# This one isn't quite as abstracted as it could be, but it's only needed for
# "--add openmp_legacy" builds, i.e. for historical versions of amd_staging,
# etc.  So keep it simple.

proc clean_openmp() {
  clean_component openmp
}

func get_openmp_src() {
  return (get_src_default ("openmp"))
}

proc configure_openmp() {
  var Build = get_objdir("openmp")
  var LLVM_Src = get_srcdir("llvm")
  var LLVM_Build = get_objdir("llvm")
  var LLVM_Cfg = ConfigureOpts["llvm"]
  var BuildType = get_build_type("openmp")
  var Src = get_srcdir("openmp")
  var Tool = get_build_tool("openmp")
  var Cfg_opts = get_configure_opts("openmp")
  cd $Build {
    cmake -G $Tool -DCMAKE_INSTALL_PREFIX=$INSTALLDIR \
      -DCMAKE_BUILD_TYPE=$BuildType \
      -DOPENMP_ENABLE_LIBOMPTARGET=1 \
      -DOPENMP_TEST_C_COMPILER=$INSTALLDIR/bin/clang \
      -DOPENMP_TEST_CXX_COMPILER=$INSTALLDIR/bin/clang++ \
      -DCMAKE_C_COMPILER=$INSTALLDIR/bin/clang \
      -DCMAKE_CXX_COMPILER=$INSTALLDIR/bin/clang++ \
      -DLIBOMPTARGET_AMDGCN_GFXLIST=$[LLVM_Cfg.gfxlist=>join(';')] \
      -DDEVICELIBS_ROOT=$[get_srcdir ("device_libs")] \
      -DLIBOMP_COPY_EXPORTS=OFF \
      -DLIBOMPTARGET_ENABLE_DEBUG=ON \
      -DLLVM_DIR=$LLVM_Build \
      -DLLVM_MAIN_INCLUDE_DIR=$LLVM_Src/llvm/include \
      -DLIBOMPTARGET_LLVM_INCLUDE_DIRS=$LLVM_Src/llvm/include \
      -DLIBOMP_USE_HWLOC=ON \
      -DLIBOMP_HWLOC_INSTALL_DIR=$[get_installdir ("hwloc")] \
      -DCMAKE_PREFIX_PATH=$INSTALLDIR/lib/cmake \
      @Cfg_opts \
      $Src
  }
}

proc build_openmp() {
  cmake_build openmp
}

proc install_openmp() {
  cmake_install openmp
}

func openmp_dependencies() {
  return (:| llvm device_libs hwloc |)
}

proc openmp_tasks {
  standard_tasks openmp
}
