#!/usr/bin/env ysh

proc clean_rocprofiler() {
  clean_component rocprofiler
}

func get_rocprofiler_src() {
  return (get_src_default ("rocprofiler"))
}

proc symlink_perfetto_rocprofiler() {
  var Src = get_srcdir("rocprofiler")
  var PerfettoSrc = get_srcdir("perfetto")
  if test --dir $Src/plugin/perfetto/perfetto {
    rmdir $Src/plugin/perfetto/perfetto
  }
  ln -sf $PerfettoSrc $Src/plugin/perfetto/perfetto
}

proc configure_rocprofiler() {
  var Build = get_objdir("rocprofiler")
  var Src = get_srcdir("rocprofiler")
  var BuildType = get_build_type("rocprofiler")
  var Tool = get_build_tool("rocprofiler")
  # NOTE: For tonight only, the gfx separator is comma not semicolon.
  var GPUList = join(ConfigureOpts.rocprofiler.gfxlist, ',')
  cd $Build {
    hide_git $Build/_tmpdir rocm_env cmake -G $Tool \
      -DCMAKE_INSTALL_PREFIX=$INSTALLDIR \
      -DCMAKE_BUILD_TYPE=$BuildType \
      -DCMAKE_MODULE_PATH="$[get_srcdir("rocprofiler")]/cmake_modules" \
      -DCMAKE_PREFIX_PATH=$INSTALLDIR \
      -DBUILD_SHARED_LIBS=YES \
      -DENABLE_LDCONFIG=OFF \
      -DUSE_GET_ROCM_PATH_API=1 \
      -DGPU_TARGETS=$GPUList \
      -DPython3_EXECUTABLE=$(which python3) \
      -DPROF_ABI_HEADER_PATH="$[get_srcdir("roctracer")]/inc/ext" \
      -DHIP_HIPCC_FLAGS="${HIP_HIPCC_FLAGS:-};--offload-arch=$GPUList" \
      -DCPACK_OBJCOPY_EXECUTABLE=$INSTALLDIR/llvm/bin/llvm-objcopy \
      -DCPACK_READELF_EXECUTABLE=$INSTALLDIR/llvm/bin/llvm-readelf \
      -DCPACK_STRIP_EXECUTABLE=$INSTALLDIR/llvm/bin/llvm-strip \
      -DCPACK_OBJDUMP_EXECUTABLE=$INSTALLDIR/llvm/bin/llvm-objdump \
      @[get_rpath_opts('rocprofiler')] \
      $Src
  }
}

proc build_rocprofiler() {
  rocm_env cmake_build rocprofiler
}

proc install_rocprofiler() {
  rocm_env cmake_install rocprofiler
}

func rocprofiler_dependencies() {
  return (:| rocm_dbgapi hipamd device_libs aqlprofile rocprofiler_register
             rocminfo rocprofiler_sdk roctracer |)
}

proc rocprofiler_tasks() {
  #add_tasks rocprofiler clean symlink_perfetto configure build install
  standard_tasks rocprofiler
}
