#!/usr/bin/env ysh

proc clean_device_libs_first() {
  clean_component device_libs_first
}

func get_device_libs_first_src() {
  return (get_src_default ("device_libs"))
}

proc configure_device_libs_first() {
  var Build = get_objdir("device_libs_first")
  var Src = get_srcdir("device_libs")
  var BuildType = get_build_type("device_libs")
  var LLVM_Build = get_objdir("llvm_first")
  var LLVM_Inst = get_installdir('llvm_first')
  var Tool = get_build_tool("device_libs_first")
  var Cfg_opts = get_configure_opts("device_libs_first")
  cd $Build {
    cmake -G $Tool -DCMAKE_INSTALL_PREFIX=$INSTALLDIR \
      -DCMAKE_PREFIX_PATH="$LLVM_Build;$LLVM_Inst" \
      -DCMAKE_BUILD_TYPE=$BuildType \
      -DLLVM_DIR=$LLVM_Inst \
      -DCMAKE_INSTALL_LIBDIR=lib \
      @Cfg_opts \
      $Src
  }
}

proc build_device_libs_first() {
  cmake_build device_libs_first
}

proc install_device_libs_first() {
  cmake_install device_libs_first
}

func device_libs_first_dependencies() {
  return (:| rocm_cmake llvm_first |)
}

proc device_libs_first_tasks() {
  standard_tasks device_libs_first
}
