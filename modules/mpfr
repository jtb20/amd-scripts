#!/usr/bin/env ysh

proc clean_mpfr() {
  clean_component mpfr
}

func get_mpfr_src() {
  return (get_src_default ("mpfr"))
}

proc configure_mpfr() {
  standard_configure mpfr
}

proc build_mpfr() {
  standard_build mpfr
}

proc install_mpfr() {
  standard_install mpfr
}

func mpfr_dependencies() {
  return ([])
}

proc mpfr_tasks() {
  standard_tasks mpfr
}


proc default_configure_opts_mpfr() {
  set_configure_opts ("mpfr", :| --with-gmp=$INSTALLDIR |)
}
