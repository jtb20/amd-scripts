#!/usr/bin/env ysh

func get_composable_kernel_src() {
  return (get_src_default ("composable_kernel"))
}

proc clean_composable_kernel() {
  clean_component composable_kernel
}

proc configure_composable_kernel() {
  var Build = get_objdir("composable_kernel")
  var Src = get_srcdir("composable_kernel")
  var BuildType = get_build_type("composable_kernel")
  var Tool = get_build_tool("composable_kernel")
  #local HIPCC_COMPILE_FLAGS_APPEND

  cd $Build {
    #export HIPCC_COMPILE_FLAGS_APPEND="-mllvm -amdgpu-mfma-padding-ratio=100 -mllvm -verify-machineinstrs -mllvm -amdgpu-waitcnt-forcezero"
    rocm_env cmake -G $Tool -S $Src -D CMAKE_PREFIX_PATH=$INSTALLDIR \
      -D CMAKE_CXX_COMPILER="$INSTALLDIR/bin/hipcc" \
      -D CMAKE_BUILD_TYPE=$BuildType
  }
}
  
proc build_composable_kernel() {
  rocm_env cmake_build composable_kernel
}

proc install_composable_kernel() {
  rocm_env cmake_install composable_kernel
}

func composable_kernel_dependencies() {
  return (:| llvm device_libs comgr hipamd |)
}

