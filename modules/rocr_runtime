#!/usr/bin/env ysh

proc clean_rocr_runtime() {
  clean_component rocr_runtime
}

func get_rocr_runtime_src() {
  return (get_src_default ("rocr_runtime"))
}

proc apply_patch_rocr_runtime() {
  aomp_apply_patch rocr_runtime
}

proc configure_rocr_runtime() {
  var Build = get_objdir("rocr_runtime")
  var BuildType = get_build_type("rocr_runtime")
  var Src = get_srcdir("rocr_runtime")
  var Tool = get_build_tool("rocr_runtime")
  var SrcSubdir = Src
  if ("$(basename $Src)" !== "hsa-runtime") {
    # There are two arrangements for the rocr_runtime component -- as a
    # component of that name (e.g. for ROCm 6.1) or as a subdirectory of the
    # hsa_runtime component (e.g. for ROCm 6.3).  The former has a "src"
    # subdirectory, the latter an "opensrc/hsa-runtime" subdirectory  (which we
    # get as part of the source path above).  This awkward condition supports
    # both versions.
    setvar SrcSubdir = "$Src/src"
  }
  cd $Build {
    # PATH=$INSTALLDIR/bin:$[sanitize_path (PATH)]
    cmake -G $Tool \
      -DCMAKE_INSTALL_PREFIX=$INSTALLDIR \
      -DCMAKE_PREFIX_PATH=$INSTALLDIR \
      -DCMAKE_BUILD_TYPE=$BuildType \
      -DIMAGE_SUPPORT=OFF \
      $SrcSubdir
  }
}

proc build_rocr_runtime() {
  cmake_build rocr_runtime
}

proc install_rocr_runtime() {
  cmake_install rocr_runtime
}

proc revert_patch_rocr_runtime() {
  aomp_revert_patch rocr_runtime
}

func rocr_runtime_dependencies() {
  return (:| llvm roct_thunk_interface |)
}

proc rocr_runtime_tasks {
  if (ConfigureOpts.rocr_runtime.aomp_patch) {
    add_tasks rocr_runtime clean apply_patch configure build install revert_patch
  } else {
    standard_tasks rocr_runtime
  }
}

# Well, this is all a bit of a fiddle.  As well as patching the rocr_runtime
# sources for the build proper, we also have to patch them for building *llvm*.
# So this complicated arrangement makes llvm depend on rocr_runtime_patch,
# and rocr_runtime_unpatch depend on llvm.  Then we must manually add
# rocr_runtime_unpatch as a component in the config file, e.g.
# aomp-amd-staging.cfg.
# See also symlink handling in roct_thunk_interface.
# We could do all this patching/unpatching just once, but that would seem to
# make "bracketing" the operation a bit more fragile.

var rocr_runtime_patch_src = {
  "type" : "subcomponent"
  "parent" : "rocr_runtime"
  "subdir" : "."
}

add_sources ("rocr_runtime_patch", rocr_runtime_patch_src)
add_sources ("rocr_runtime_unpatch", rocr_runtime_patch_src)

proc modify_rocr_runtime_patch () {
  apply_patch_rocr_runtime
}

proc restore_rocr_runtime_unpatch () {
  revert_patch_rocr_runtime
}

func get_rocr_runtime_patch_src () {
  return (get_src_default ("rocr_runtime_patch"))
}

func rocr_runtime_patch_dependencies() {
  return ([])
}

proc rocr_runtime_patch_tasks {
  add_tasks rocr_runtime_patch modify
}

func get_rocr_runtime_unpatch_src () {
  return (get_src_default ("rocr_runtime_unpatch"))
}

func rocr_runtime_unpatch_dependencies() {
  return (:| rocr_runtime_patch llvm |)
}

proc rocr_runtime_unpatch_tasks {
  add_tasks rocr_runtime_unpatch restore
}
