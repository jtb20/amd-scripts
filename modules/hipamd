#!/usr/bin/env ysh

proc clean_hipamd() {
  clean_component hipamd
}

func get_hipamd_src() {
  return (get_src_default ("hipamd"))
}

proc configure_hipamd() {
  var Build = get_objdir("hipamd")
  var BuildType = get_build_type("hipamd")
  var Src = get_srcdir("hipamd")
  var Tool = get_build_tool("hipamd")
  var LLVM_Inst = get_installdir('llvm')
  var Cfg_opts = get_configure_opts('hipamd')
  cd $Build {
    rocm_env cmake -G $Tool \
      -DCMAKE_INSTALL_PREFIX=$LLVM_Inst \
      -DCMAKE_PREFIX_PATH="$INSTALLDIR;$LLVM_Inst" \
      -DCMAKE_BUILD_TYPE=$BuildType \
      @Cfg_opts \
      @[get_rpath_opts('hipamd')] \
      $Src
  }
}

proc build_hipamd() {
  if (get_build_tool('hipamd') === "Ninja") {
    rocm_env cmake_build hipamd
  } else {
    rocm_env standard_build hipamd
  }
}

proc install_hipamd() {
  if (get_build_tool('hipamd') === 'Ninja') {
    rocm_env cmake_install hipamd
  } else {
    rocm_env standard_install hipamd
  }
}

proc llvm_symlink_hipamd() {
  # ROCM-related stuff (e.g. composable_kernel) wants a symlink here.
  var LLVM_Inst = get_installdir('llvm')
  cd $INSTALLDIR {
    ln -sf $LLVM_Inst llvm
  }
}

func hipamd_dependencies() {
  return (:| roct_thunk_interface rocr_runtime hipcc hip comgr |)
}

proc hipamd_tasks {
  standard_tasks hipamd
  add_tasks hipamd llvm_symlink
}
