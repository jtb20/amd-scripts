#!/usr/bin/env ysh

proc clean_hipamd(var="") {
  clean_component hipamd $var
}

func get_hipamd_src() {
  return (get_src_default ("hipamd"))
}

proc configure_hipamd(var="") {
  var Build = get_objdir("hipamd", var) if var else get_objdir("hipamd")
  var BuildType = get_build_type("hipamd")
  var Src = get_srcdir("hipamd")
  var Tool = get_build_tool("hipamd")
  var LLVM_Inst = get_installdir('llvm')
  var Cfg_opts = get_configure_opts('hipamd')
  cd $Build {
    rocm_env variant_cmake hipamd "$var" -G $Tool \
      -DCMAKE_INSTALL_PREFIX=$INSTALLDIR \
      -DCMAKE_PREFIX_PATH="$INSTALLDIR;$LLVM_Inst" \
      -DCMAKE_BUILD_TYPE=$BuildType \
      @Cfg_opts \
      @[get_rpath_opts('hipamd', var)] \
      $Src
  }
}

proc build_hipamd(var="") {
  if (get_build_tool('hipamd') === "Ninja") {
    rocm_env cmake_build hipamd $var
  } else {
    rocm_env standard_build hipamd
  }
}

proc install_hipamd(var="") {
  if (get_build_tool('hipamd') === 'Ninja') {
    rocm_env cmake_install hipamd $var
  } else {
    rocm_env standard_install hipamd
  }
}

proc llvm_symlink_hipamd() {
  # ROCM-related stuff (e.g. composable_kernel) wants a symlink here.
  var LLVM_Inst = get_installdir('llvm')
  cd $INSTALLDIR {
    ln -sf $LLVM_Inst llvm
  }
}

func hipamd_dependencies() {
  return (:| roct_thunk_interface rocr_runtime hipcc hip comgr |)
}

proc apply_patch_hipamd(var="") {
  aomp_apply_patch hipamd
  aomp_apply_patch rocclr
}

proc revert_patch_hipamd(var="") {
  aomp_revert_patch rocclr
  aomp_revert_patch hipamd
}

proc hipamd_tasks {
  add_tasks hipamd @[hipamd_variant_tasks()]
  add_tasks hipamd llvm_symlink
}

### Build variants (see "BUILD VARIANTS" in common, and configs/aomp/aomp-variants.inc) ###

func hipamd_supported_variants() {
  return (:| asan debug |)
}

func hipamd_variant_tasks(var=null) {
  if (ConfigureOpts.hipamd.aomp_patch) {
    return (:| clean apply_patch configure build install revert_patch |)
  }
  return (:| clean configure build install |)
}

# As AOMP's build_hipamd.sh: variants are always built with the new clang.
# That links with lld, which (unlike GNU ld) rejects the OpenCL runtime's
# version script for naming symbols this build doesn't define (D3D10 and
# other Windows-only entry points), unless told otherwise.
func hipamd_variant_cmake(var) {
  var LLVM_Inst = get_installdir ('llvm')
  var Opts = :| -DCMAKE_C_COMPILER=$LLVM_Inst/bin/clang
                -DCMAKE_CXX_COMPILER=$LLVM_Inst/bin/clang++ |
  var CFlags = :| -Wl,--undefined-version |
  if (in_list ('debug', variant_parts (var))) {
    append -- "-fdebug-prefix-map=$[get_srcdir ('hipamd')]=$[ompd_src_dir()]/clr" (CFlags)
  }
  return ({opts: Opts, cflags: CFlags})
}
