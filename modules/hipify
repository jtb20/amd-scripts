#!/usr/bin/env ysh

proc clean_hipify() {
  clean_component hipify
}

func get_hipify_src() {
  return (get_src_default ("hipify"))
}

proc configure_hipify() {
  var Build = get_objdir("hipify")
  var BuildType = get_build_type("hipify")
  var Src = get_srcdir("hipify")
  var Tool = get_build_tool("hipify")
  var LLVM_Inst = get_installdir('llvm')
  var Cfg_opts = get_configure_opts('hipify')
  cd $Build {
    rocm_env cmake -G $Tool \
      -DCMAKE_INSTALL_PREFIX=$INSTALLDIR \
      -DCMAKE_PREFIX_PATH="$LLVM_Inst" \
      -DCMAKE_BUILD_TYPE=$BuildType \
      -DHIPIFY_INSTALL_CLANG_HEADERS=OFF \
      @Cfg_opts \
      -DLLVM_EXTERNAL_LIT="$LLVM_Inst/bin/llvm-lit" \
      $Src
  }
}

proc build_hipify() {
  if (get_build_tool('hipify') === "Ninja") {
    rocm_env cmake_build hipify
  } else {
    rocm_env standard_build hipify
  }
}

proc install_hipify() {
  if (get_build_tool('hipify') === 'Ninja') {
    rocm_env cmake_install hipify
  } else {
    rocm_env standard_install hipify
  }
}

func hipify_dependencies() {
  return (:| llvm hipamd |)
}

proc hipify_tasks {
  standard_tasks hipify
}
