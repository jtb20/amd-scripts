#!/usr/bin/env ysh
# clang-tools-extra

func get_llvm_src() {
  var version_name=Sources.llvm.version_name
  return ("llvm-project-$version_name")
}

func get_llvm_install(installdir) {
  if (PreinstalledAOMP) {
    return (PreinstalledAOMP)
  } elif ('append_install_dir' in ConfigureOpts.llvm and
      ConfigureOpts.llvm.append_install_dir) {
    return ("$installdir/$[ConfigureOpts.llvm.append_install_dir]")
  } else {
    return (installdir)
  }
}

proc clean_llvm() {
  clean_component llvm
}

proc configure_llvm() {
  var Src = get_srcdir("llvm")
  var BuildDir = get_objdir("llvm")
  var BuildType = get_build_type("llvm")
  var Cfg = ConfigureOpts["llvm"]
  var Tool = get_build_tool("llvm")
  var CCache_opt = cmake_ccache_option("llvm")
  var Assertions_opt = :| -DLLVM_ENABLE_ASSERTIONS=ON | if get_assertions('llvm') else []
  cd $BuildDir {
    cmake -G $Tool @CCache_opt \
          -DLLVM_ENABLE_PROJECTS=$[join(Cfg.projects, ';')] \
          -DLLVM_TARGETS_TO_BUILD=$[join(Cfg.targets, ';')] \
          -DCMAKE_BUILD_TYPE=$BuildType \
          -DCMAKE_INSTALL_PREFIX=$[get_installdir ('llvm')] \
          @[Cfg.cfg] -DLLVM_ENABLE_RUNTIMES=$[join(Cfg.runtimes, ';')] \
          @Assertions_opt \
          @[get_rpath_opts('llvm')] \
          $Src/llvm
  }
	# -DCLANG_DEFAULT_PIE_ON_LINUX
	#cmake ../llvm-project/amd/hipcc -DCMAKE_INSTALL_PREFIX=../install -DCMAKE_BUILD_TYPE=Release
	#cmake ../llvm-project/amd/device-libs -DCMAKE_INSTALL_PREFIX=../install -DCMAKE_BUILD_TYPE=Release
}

proc build_llvm() {
  if ('hsakmt_build_hack' in ConfigureOpts.llvm and
      ConfigureOpts.llvm.hsakmt_build_hack) {
    hsakmt_DIR=$INSTALLDIR/lib/cmake/hsakmt cmake_build llvm
  } else {
    cmake_build llvm
  }
}

proc install_llvm() {
  cmake_install llvm
}

proc install_filecheck_llvm() {
  var BuildDir = get_objdir('llvm')
  var InstDir = get_installdir('llvm')
  # This is a weird hack.  The AOMP test/Makefile.defs fragment wants to see
  # a copy of FileCheck in $AOMP/bin/FileCheck, otherwise falls back to a set
  # of heuristics to try to locate the binary elsewhere.  Those heuristics can
  # fail, so make sure to use our own version.
  install $BuildDir/bin/FileCheck $InstDir/bin/FileCheck
}

func llvm_dependencies() {
  return ([])
}

proc llvm_tasks() {
  standard_tasks llvm
  add_tasks llvm install_filecheck
}

proc default_configure_opts_llvm() {
  var LLDOpts = []
  if (false and have_binary ('ld.lld')) {
    # Opportunistically use lld if we find it (for linking LLVM libs/binaries
    # themselves).  This should probably be a build option (like Ninja, ccache
    # usage).
    setvar LLDOpts = :| -DLLVM_USE_LINKER=lld |
  }
  set_configure_opts ("llvm", :| -DLLVM_BUILD_TOOLS=ON
                                 -DLLVM_ENABLE_Z3_SOLVER=OFF
                                 -DLLVM_ENABLE_ZLIB=ON
                                 -DLLVM_INCLUDE_TESTS=ON
                                 -DCLANG_DEFAULT_LINKER=lld
                                 -DLLVM_PARALLEL_LINK_JOBS=8
                                 #-DLLVM_USE_SPLIT_DWARF=TRUE
                                 -DLLVM_PARALLEL_LINK_JOBS=2
                                 @LLDOpts |)
}

proc run_lit {
  var BuildDir = get_objdir("llvm")
  var Lit = "$BuildDir/bin/llvm-lit"
  $Lit -s --no-progress-bar @ARGV
}

proc run_llvm_check(check_target) {
  var BuildDir = get_objdir("llvm")
  # Inside the build sandbox /opt is a tmpfs (see do_bwrap), so clang can't see
  # the system ROCm and fails to locate the device bitcode (amdgcn/bitcode)
  # needed by the offload/openmp suites.  Point it at our own install tree via
  # ROCM_PATH, fed into every test's environment through the suites'
  # CHECK_OPENMP_ENV hook (offload/test/lit.cfg, openmp/runtime/test/lit.cfg).
  # ROCM_PATH (unlike --rocm-path) is silently ignored by non-AMD/host compiles,
  # so it adds no unused-argument warnings to the CPU suites, and harmless for
  # non-OpenMP check targets which don't read CHECK_OPENMP_ENV.
  # A per-test timeout (requires the psutil python module) keeps a single
  # hung/deadlocked test (e.g. a GPU reduction that never returns) from
  # wedging the whole campaign: lit marks it TIMEOUT and moves on instead of
  # blocking forever.  300s is generous - real offload tests finish in well
  # under a second.
  var LitOpts = "-o testresults.json --timeout=300"
  # ROCM_PATH: device bitcode (amdgcn/bitcode) lives in our install tree, not
  #   the bwrap-hidden /opt/rocm.
  # LD_LIBRARY_PATH needs to cover libs that live in two different install
  # subtrees, because the openmp/runtime lit suite builds its test binaries
  # WITHOUT an rpath on Linux (openmp/runtime/test/lit.cfg only adds -rpath on
  # Darwin) and then OVERWRITES LD_LIBRARY_PATH with this value (lit.cfg:190,
  # config.environment[name]=value), so the build's own lib dir is dropped and
  # the only way the binaries find libomp.so is via the dirs we list here:
  #   - $INSTALLDIR/lib: the AMDGPU plugins dlopen the bare soname
  #     "libhsa-runtime64.so" (dynamic_hsa/hsa.cpp / the hsx hsa_loader); this
  #     binds OUR freshly-built HSA runtime (rocr_runtime/install) instead of a
  #     system/stub libhsa or an uncontrolled /opt/rocm.  (libhsastream is a
  #     static .a linked into libomptarget, so it needs no runtime path.)
  #   - $LLVMInst/lib/<triple> and $LLVMInst/lib: the LLVM install is nested at
  #     $INSTALLDIR/lib/llvm, so libomp.so/libomptarget.so land in the
  #     per-target-runtime-dir subdir and libLLVM.so in lib/.  Without these
  #     the openmp-runtime tests fail to load libomp.so (exit 127).
  # The offload suite is unaffected either way: its binaries carry a DT_RUNPATH
  # into the obj tree for libomp/libomptarget, and only need libhsa from here.
  var LLVMInst = get_installdir('llvm')
  with-env CHECK_OPENMP_ENV="ROCM_PATH=$INSTALLDIR LD_LIBRARY_PATH=$INSTALLDIR/lib:$LLVMInst/lib/x86_64-unknown-linux-gnu:$LLVMInst/lib" {
    cd $BuildDir {
      var Tool = get_build_tool("llvm")
      if (Tool === "Ninja") {
        try {
          if (SelectTests !== null) {
            # This is a regex, not a glob.  Consistency, schmonsistency.
            FILECHECK_OPTS="--dump-input=always" LIT_FILTER=$SelectTests LIT_OPTS=$LitOpts ninja -k 0 $check_target
          } else {
            LIT_OPTS=$LitOpts ninja -k 0 $check_target
          }
        }
      } else {
        try {
          if (SelectTests !== null) {
            make -k $check_target LIT_OPTS=$LitOpts LIT_FILTER=$SelectTests
          } else {
            make -k $check_target LIT_OPTS=$LitOpts
          }
        }
      }
    }
  }
}

proc llvm_results_helper(task, name, relpath; files=null) {
  var BuildDir = get_objdir("llvm")
  var ResultFile = "$BuildDir/$relpath/testresults.json"
  if (task === "save") {
    if test --exists $ResultFile {
      cp $ResultFile $TESTRESULTSDIR/${name}.json
      call files->setValue (:| ${name}.json |)
    }
  } elif (task === "clean") {
    rm -f $ResultFile
  } else {
    error "Unknown task $task"
  }
}

