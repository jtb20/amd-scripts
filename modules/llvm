### LIBCLANG_PYTHON ###

proc clean_results_llvm_libclang_python () {
  var Obj = get_objdir('llvm')
  rm -f $Obj/libclang_python.log
}

proc test_llvm_libclang_python () {
  var Src = get_srcdir('llvm')
  var Obj = get_objdir('llvm')
  cd "$Src/clang/bindings/python" {
    try {
      with-env CLANG_NO_DEFAULT_CONFIG=1 \
              CLANG_LIBRARY_PATH="$Obj/lib" {
        /usr/bin/python3 -m unittest discover -v 2> $Obj/libclang_python.log
      }
    }
    if failed {
      >&2 write "Testing failed!"
    }
  }
  #run_llvm_check check-clang-python
}

proc save_results_llvm_libclang_python (; files) {
  var Obj = get_objdir('llvm')
  cat $Obj/libclang_python.log | while read n {
    var OK = / ^ <capture dot* as testname> ' ... ok' $ /
    var Fail = / ^ <capture dot* as testname> ' ... test_from_id' /
    var Fail1 = / ^ <capture dot* as testname> ' ... FAIL' $ /
    if (n ~ OK) {
      write "PASS: $[_group('testname')]"
    } elif (n ~ Fail or n ~ Fail1) {
      write "FAIL: $[_group('testname')]"
    }
    # There might be other ways that tests can fail...
  } > "$TESTRESULTSDIR/libclang_python.sum"
  cp $Obj/libclang_python.log $TESTRESULTSDIR
  call files->setValue(:| libclang_python.sum |)
}

