func get_llvm_src() {
  return ("llvm-project")
}

proc clean_llvm() {
  clean_component llvm
}

proc configure_llvm() {
  var SRC=get_srcdir("llvm")
  var BUILDDIR=get_objdir("llvm")
  var BUILDTYPE="Release"
  cd "$BUILDDIR" {
    # --fresh
    cmake -DLLVM_ENABLE_PROJECTS='clang;lld;clang-tools-extra' \
        -DLLVM_TARGETS_TO_BUILD='X86;AMDGPU' \
      -DCMAKE_BUILD_TYPE=$BUILDTYPE -DCMAKE_INSTALL_PREFIX="$INSTALLDIR" \
      -DLLVM_BUILD_TOOLS=ON -DLLVM_ENABLE_Z3_SOLVER=OFF -DLLVM_ENABLE_ZLIB=ON \
      -DLLVM_INCLUDE_TESTS=ON -DCLANG_DEFAULT_LINKER=lld -DLLVM_PARALLEL_LINK_JOBS=8 \
      -DLLVM_BUILD_LLVM_DYLIB=ON \
      -DCLANG_ENABLE_AMDCLANG=ON \
      -DLLVM_ENABLE_RUNTIMES=compiler-rt \
      "$SRC/llvm" > "$LOGDIR"/llvm-config.log
  }
	# -DCLANG_DEFAULT_PIE_ON_LINUX
	#cmake ../llvm-project/amd/hipcc -DCMAKE_INSTALL_PREFIX=../install -DCMAKE_BUILD_TYPE=Release
	#cmake ../llvm-project/amd/device-libs -DCMAKE_INSTALL_PREFIX=../install -DCMAKE_BUILD_TYPE=Release
}

proc build_llvm() {
  var BUILDDIR=get_objdir("llvm")
  cd "$BUILDDIR" {
    make -j32 > "$LOGDIR/llvm-build.log"
  }
}

proc install_llvm() {
  var BUILDDIR=get_objdir("llvm")
  cd "$BUILDDIR" {
    make -j32 install > "$LOGDIR/llvm-install.log"
  }
}

