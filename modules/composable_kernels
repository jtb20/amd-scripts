#!/usr/bin/env ysh

func get_composable_kernel_src() {
  var version_name = Sources.composable_kernel.version_name
  return ("composable_kernel-$version_name")
}

proc clean_composable_kernel() {
  clean_component composable_kernel
}

proc configure_composable_kernel() {
  var Build = get_objdir("composable_kernel")
  var Src = get_srcdir("composable_kernel")
  local HIPCC_COMPILE_FLAGS_APPEND

  # --fresh

  cd $Build {
    export HIPCC_COMPILE_FLAGS_APPEND="-mllvm -amdgpu-mfma-padding-ratio=100 -mllvm -verify-machineinstrs -mllvm -amdgpu-waitcnt-forcezero"
    cmake -S $Src -D CMAKE_PREFIX_PATH="$ROCM_PATH" \
      -D CMAKE_CXX_COMPILER="$ROCM_PATH/bin/hipcc" \
      -D CMAKE_CXX_FLAGS="-O3 -Wno-gnu-line-marker -save-temps=$PWD -v" \
      -D CMAKE_BUILD_TYPE=RelWithDebug \
      -D GPU_TARGETS=gfx942
  }
}
  
proc build_composable_kernel() {
  var Build = get_objdir("composable_kernel")
  cd $Build {
    make example_gemm_xdl_fp16_v3
  }
}

func composable_kernels_dependencies() {
  return (:| llvm device_libs comgr |)
}

