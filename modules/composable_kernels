#!/usr/bin/env ysh

func get_composable_kernels_src() {
  return (get_src_default ("composable_kernels"))
}

proc clean_composable_kernels() {
  clean_component composable_kernels
}

proc configure_composable_kernels() {
  var Build = get_objdir("composable_kernels")
  var Src = get_srcdir("composable_kernels")
  var BuildType = get_build_type("composable_kernels")
  var Tool = get_build_tool("composable_kernels")
  #local HIPCC_COMPILE_FLAGS_APPEND

  cd $Build {
    shvar HIP_CLANG_PATH=$INSTALLDIR/bin \
          ROCM_PATH=$INSTALLDIR \
          HIP_PATH=$INSTALLDIR \
          LLVM_PATH=$INSTALLDIR \
          GPU_TARGETS="" {
      export HIP_CLANG_PATH
      export HIP_PATH
      export LLVM_PATH
      unset GPU_TARGETS
      #export HIPCC_COMPILE_FLAGS_APPEND="-mllvm -amdgpu-mfma-padding-ratio=100 -mllvm -verify-machineinstrs -mllvm -amdgpu-waitcnt-forcezero"
      cmake -G $Tool -S $Src -D CMAKE_PREFIX_PATH=$INSTALLDIR \
        -D CMAKE_CXX_COMPILER="$INSTALLDIR/bin/hipcc" \
        -D CMAKE_BUILD_TYPE=$BuildType
    }
  }
}
  
proc build_composable_kernels() {
  shvar HIP_CLANG_PATH=$INSTALLDIR/bin \
        ROCM_PATH=$INSTALLDIR \
        HIP_PATH=$INSTALLDIR \
        LLVM_PATH=$INSTALLDIR {
    cmake_build composable_kernels
  }
}

proc install_composable_kernels() {
  shvar HIP_CLANG_PATH=$INSTALLDIR/bin \
        ROCM_PATH=$INSTALLDIR \
        HIP_PATH=$INSTALLDIR \
        LLVM_PATH=$INSTALLDIR {
    cmake_install composable_kernels
  }
}

func composable_kernels_dependencies() {
  return (:| llvm device_libs comgr hipamd |)
}

