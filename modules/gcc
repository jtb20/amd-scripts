#!/usr/bin/env ysh

proc clean_gcc() {
  clean_component gcc
}

func get_gcc_src() {
  return (get_src_default ("gcc"))
}

proc configure_gcc() {
  standard_configure gcc
}

proc build_gcc() {
  standard_build gcc
}

proc install_gcc() {
  standard_install gcc
}

func gcc_dependencies() {
  return (:| binutils isl mpc mpfr gmp |)
}

proc gcc_tasks() {
  standard_tasks gcc
}

proc default_configure_opts_gcc() {
  set_configure_opts ("gcc", :| --with-mpfr=$INSTALLDIR
                                --with-gmp=$INSTALLDIR
                                --with-mpc=$INSTALLDIR |)
}

proc write_dejagnu_site_file {
  var content="""
load_generic_config "unix"
process_multilib_options ""
set_board_info cflags "-foffload-options=-mcpu=gfx90a"
"""
  write -- $content > site.exp
}

proc test_gcc_gcc() {
  var Build = get_objdir ("gcc")
}

proc test_gcc_libgomp(; options) {
  var Build = get_objdir ("gcc")
  var Target = ConfigureOpts.gcc.target
  cd $Build/$Target/libgomp {
    #write_dejagnu_site_file
    var pass_opts = :| --target_board=unix/-foffload-options=-march=gfx90a | \
                    ++ options
    make -k check RUNTESTFLAGS="$[join(pass_opts, ' ')]"
    # Is this better?
    # eval "make -k check RUNTESTFLAGS=\"@pass_opts\""
  }
}