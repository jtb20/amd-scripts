#!/usr/bin/env ysh

proc clean_gcc() {
  clean_component gcc
}

func get_gcc_src() {
  return (get_src_default ("gcc"))
}

proc configure_gcc() {
  standard_configure gcc
}

proc build_gcc() {
  standard_build gcc
}

proc install_gcc() {
  standard_install gcc
}

func gcc_dependencies() {
  return (:| binutils isl mpc mpfr gmp |)
}

proc gcc_tasks() {
  standard_tasks gcc
}

proc default_configure_opts_gcc() {
  set_configure_opts ("gcc", :| --with-mpfr=$INSTALLDIR
                                --with-gmp=$INSTALLDIR
                                --with-mpc=$INSTALLDIR |)
}

proc write_dejagnu_site_file {
  var content="""
load_generic_config "unix"
process_multilib_options ""
set_board_info cflags "-foffload-options=-mcpu=gfx90a"
"""
  write -- $content > site.exp
}

proc gcc_results_helper(task, name, relpath; files=null) {
  var BuildDir = get_objdir("gcc")
  var LogFile = "$BuildDir/$relpath/$name.log"
  var SumFile = "$BuildDir/$relpath/$name.sum"
  if (task === "save") {
    if test --exists $LogFile {
      cp $LogFile $TESTRESULTSDIR/${name}.log
      cp $SumFile $TESTRESULTSDIR/${name}.sum
      call files->setValue (:| ${name}.sum |)
    }
  } elif (task === "clean") {
    rm -f $LogFile $SumFile
  } else {
    error "Unknown task $task"
  }
}

### C ###

proc clean_results_gcc_c() {
  gcc_results_helper clean gcc gcc/testsuite/gcc
}

proc test_gcc_c() {
  var Build = get_objdir ("gcc")
  cd $Build {
    var pass_opts = dejagnu_opts()
    if (SelectTests) {
      append $SelectTests (pass_opts)
    }
    install_path make -k check-c RUNTESTFLAGS=$[shell_quote_args(pass_opts)]
  }
}

proc save_results_gcc_c(; files) {
  gcc_results_helper save gcc gcc/testsuite/gcc (files)
}

