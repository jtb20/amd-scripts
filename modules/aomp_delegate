proc setup_x_symlinks {
  var AMDSMISrc = get_srcdir('rocsmilib')
  var AOMPSrc = get_srcdir('aomp')
  var AOMPExtrasSrc = get_srcdir('aomp_extras')
  var ClrSrc = get_srcdir('hipamd')
  var FlangSrc = get_srcdir('flang')
  var HipSrc = get_srcdir('hip')
  var HipFortSrc = get_srcdir('hipfort')
  var LLVMSrc = get_srcdir('llvm')
  var ROCDbgApiSrc = get_srcdir('rocm_dbgapi')
  var ROCGDBSrc = get_srcdir('rocgdb')
  var ROCMCmakeSrc = get_srcdir('rocm_cmake')
  var ROCMInfoSrc = get_srcdir('rocminfo')
  var ROCProfilerSrc = get_srcdir('rocprofiler')
  var ROCProfilerRegisterSrc = get_srcdir('rocprofiler_register')
  var ROCRRuntimeSrc = get_srcdir('rocr_runtime')
  var ROCTracerSrc = get_srcdir('roctracer')
  var ROCTThunkIntfSrc = get_srcdir('roct_thunk_interface')
  var AOMP_VERSION = ConfigureOpts.aomp_delegate.aomp_version
  var AOMP_REPOS = ConfigureOpts.aomp_delegate.aomp_repos

  if ! test --exists $AOMP_REPOS {
    mkdir -p $AOMP_REPOS
  }

  ln -sfT $AMDSMISrc $AOMP_REPOS/amdsmi
  ln -sfT $AOMPSrc $AOMP_REPOS/aomp
  ln -sfT $AOMPExtrasSrc $AOMP_REPOS/aomp-extras
  ln -sfT $ClrSrc $AOMP_REPOS/clr
  ln -sfT $FlangSrc $AOMP_REPOS/flang
  ln -sfT $HipSrc $AOMP_REPOS/hip
  ln -sfT $HipFortSrc $AOMP_REPOS/hipfort
  ln -sfT $LLVMSrc $AOMP_REPOS/llvm-project
  ln -sfT $ROCDbgApiSrc $AOMP_REPOS/ROCdbgapi
  ln -sfT $ROCGDBSrc $AOMP_REPOS/ROCgdb
  ln -sfT $ROCMCmakeSrc $AOMP_REPOS/rocm-cmake
  ln -sfT $ROCMInfoSrc $AOMP_REPOS/rocminfo
  ln -sfT $AMDSMISrc $AOMP_REPOS/rocm_smi_lib
  ln -sfT $ROCProfilerSrc $AOMP_REPOS/rocprofiler
  ln -sfT $ROCProfilerRegisterSrc $AOMP_REPOS/rocprofiler-register
  ln -sfT $ROCRRuntimeSrc $AOMP_REPOS/rocr-runtime
  ln -sfT $ROCTracerSrc $AOMP_REPOS/roctracer
  ln -sfT $ROCTThunkIntfSrc $AOMP_REPOS/roct-thunk-interface
}

proc x_symlinks_tasks {
  add_tasks x_symlinks setup
}

