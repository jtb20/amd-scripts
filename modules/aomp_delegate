for Comp in project rocprofiler-register roct rocr openmp offload \
            extras comgr rocminfo rocm_smi_lib amdsmi llvm-legacy llvm-classic \
            flang-legacy flang-classic pgmath flang flang_runtime hipcc hipamd \
            rocdbgapi rocgdb roctracer rocprofiler rocm-cmake libdevice {
  var CompName = Comp=>replace('-','_')
  var ConfTool = 'cmake'
  if (Comp === 'rocgdb') {
    setvar ConfTool = 'configure'
  }
  var Procs = aomp_delegate_gen(Comp, ConfTool)
  for Name in (Procs) {
    call setVar(Name, Procs[Name])
  }
  call setVar("get_ao_${CompName}_src", aomp_delegate_getsrc)
}

