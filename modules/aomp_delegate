func translate_aomp_deps(Comp) {
  var Deps = []
  if ('deps' in Sources[Comp]) {
    setvar Deps = Sources[Comp].deps
  } else {
    eval "setvar Deps = ${Comp}_dependencies ()"
  }
  var NewDeps = []
  for D in (Deps) {
    case (D) {
      rocm_cmake | device_libs | hwloc | hip | gmp | mpfr | \
      aqlprofile | rocprofiler_sdk | opencl_icd_loader {
        # We don't need to build these explicitly with the delegated build.
        :
      }
      hipamd {
        append "$[DelegatedCompName[D]]" (NewDeps)
        append ao_python_mods (NewDeps)
      }
      * {
        append "$[DelegatedCompName[D]]" (NewDeps)
      }
    }
  }
  # They all need these ones...
  append ao_symlinks (NewDeps)
  append ao_prereq (NewDeps)
  return (NewDeps)
}

