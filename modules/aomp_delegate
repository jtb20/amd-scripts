proc setup_x_python_mods() {
  # Without this dynamic scope, we don't see the redefined PATH from our
  # caller (so e.g. we pick up pip3 from homebrew, rather than the system one,
  # and that just throws an error about using an externally-managed
  # environment).
  shopt -s dynamic_scope {
    pip3 install --ignore-installed --user barectf==3.1.2 PyYAML==5.3.1
    pip3 install --user CppHeaderParser argparse wheel lit lxml pandas
  }
}

proc x_python_mods_tasks {
  add_tasks x_python_mods setup
}

