func translate_x_deps(Comp) {
  eval "var Deps = ${Comp}_dependencies ()"
  var NewDeps = []
  for D in (Deps) {
    case (D) {
      rocm_cmake | device_libs | hwloc | hip | gmp | mpfr | \
      aqlprofile | rocprofiler_sdk {
        # We don't need to build these explicitly with the delegated build.
        :
      }
      hipamd {
        append "$[DelegatedCompName[D]]" (NewDeps)
        append x_python_mods (NewDeps)
      }
      * {
        append "$[DelegatedCompName[D]]" (NewDeps)
      }
    }
  }
  # They all need these ones...
  append x_symlinks (NewDeps)
  append x_prereq (NewDeps)
  return (NewDeps)
}

