# Our sanitize_path thing isn't working well to avoid a homebrew version of
# pip3.  Try this instead (yuck).
proc sys_pip3 {
  if test --exists /usr/bin/pip3 {
    /usr/bin/pip3 @ARGV
  } else {
    pip3 @ARGV
  }
}

proc setup_ao_python_mods() {
  var OS=null
  var Ubuntu20=false
  try {
    setvar OS=$(lsb_release -sd)
  }
  if (_error.code === 0 and OS ~~ 'Ubuntu 20*') {
    setvar Ubuntu20 = true
  }
  if (Ubuntu20) {
    sys_pip3 install --user CppHeaderParser argparse wheel lit lxml barectf pandas
  } else {
    sys_pip3 install --ignore-installed --user barectf==3.1.2 PyYAML==5.3.1
    sys_pip3 install --user CppHeaderParser argparse wheel lit lxml pandas

  }
}

