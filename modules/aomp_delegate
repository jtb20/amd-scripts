func aomp_delegate_env(Comp) {
  func flag(Name) {
    if (ConfigureOpts.aomp_delegate[Name]) {
      return ('1')
    } else {
      return ('0')
    }
  }

  func invflag(Name) {
    if (ConfigureOpts.aomp_delegate[Name]) {
      return ('0')
    } else {
      return ('1')
    }
  }

  # Use the AOMP component name when setting options here, e.g.
  # --debug=project,openmp,offload (don't use an 'ao_' prefix).
  var Env = :| BUILD_TYPE=$[get_build_type(Comp)]
               AOMP_USE_NINJA=1
               AOMP=$INSTALLDIR
               AOMP_BUILD_CUDA=$[flag('build_cuda')]
               AOMP_BUILD_DEBUG=$[flag('build_debug')]
               AOMP_BUILD_PERF=$[flag('build_perf')]
               AOMP_BUILD_SANITIZER=$[flag('build_sanitizer')]
               AOMP_SKIP_FLANG=$[invflag('flang_classic')]
               AOMP_SKIP_FLANG_NEW=$[invflag('flang_new')] |
  write "Using environment variables:"
  write -- @Env
  return (Env)
}

func aomp_delegate_gen(Comp, ConfigureTool) {
  var CompName = Comp=>replace('-','_')
  var InstallWord = 'install'
  var Procs = {}
  if (Comp === 'llvm-legacy' or Comp === 'llvm-classic') {
    # No install step for llvm-legacy!
    setvar InstallWord = ''
  }
  eval """
  proc ${ConfigureTool}_ao_${CompName} {
    var AOMPSrc = get_srcdir('aomp')
    var LocalEnv = aomp_delegate_env('$CompName')
    with-env @LocalEnv {
      \$AOMPSrc/bin/build_$Comp.sh $ConfigureTool
    }
  }
  proc build_ao_${CompName} {
    var AOMPSrc = get_srcdir('aomp')
    var LocalEnv = aomp_delegate_env('$CompName')
    with-env @LocalEnv {
      \$AOMPSrc/bin/build_$Comp.sh no$ConfigureTool
    }
  }
  proc install_ao_${CompName} {
    var AOMPSrc = get_srcdir('aomp')
    var LocalEnv = aomp_delegate_env('$CompName')
    with-env @LocalEnv {
      \$AOMPSrc/bin/build_$Comp.sh install
    }
  }
  proc ao_${CompName}_tasks {
    add_tasks ao_${CompName} $ConfigureTool build $InstallWord
  }
  """
  setvar Procs["${ConfigureTool}_ao_${CompName}"] = getVar("${ConfigureTool}_ao_${CompName}")
  setvar Procs["build_ao_${CompName}"] = getVar("build_ao_${CompName}")
  if (InstallWord !== '') {
    setvar Procs["install_ao_${CompName}"] = getVar("install_ao_${CompName}")
  }
  setvar Procs["ao_${CompName}_tasks"] = getVar("ao_${CompName}_tasks")
  return (Procs)
}

