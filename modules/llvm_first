#!/usr/bin/env ysh

# FIXME: Make this better.
# I think the ROCm build needs an existing installation to build OpenMP
# support properly.  This builds a "stage 1" compiler to build and install
# e.g. device libs before attempting the OpenMP build.  The AOMP tree has
# patches that avoid the need to do this, IIUC.

func get_llvm_first_src() {
  var version_name=Sources.llvm.version_name
  return ("llvm-project-$version_name")
}

# This compiler installs in the same place as the next "stage".  Actually
# maybe we can skip the install step for this one?  Try that.
func get_llvm_first_install(installdir) {
  if ('append_install_dir' in ConfigureOpts.llvm and
      ConfigureOpts.llvm.append_install_dir) {
    return ("$installdir/$[ConfigureOpts.llvm.append_install_dir]")
  } else {
    return (installdir)
  }
}

proc clean_llvm_first() {
  clean_component llvm_first
}

proc configure_llvm_first() {
  var Src = get_srcdir("llvm")
  var BuildDir = get_objdir("llvm_first")
  var BuildType = get_build_type("llvm")
  var Cfg = ConfigureOpts["llvm_first"]
  var Tool = get_build_tool("llvm")
  var CCache_opt = cmake_ccache_option("llvm")
  var Assertions_opt = :| -DLLVM_ENABLE_ASSERTIONS=ON | if get_assertions('llvm') else []
  cd $BuildDir {
    cmake -G $Tool @CCache_opt \
          -DLLVM_ENABLE_PROJECTS=$[join(Cfg.projects, ';')] \
          -DLLVM_TARGETS_TO_BUILD=$[join(Cfg.targets, ';')] \
          -DCMAKE_BUILD_TYPE=$BuildType \
          -DCMAKE_INSTALL_PREFIX=$[get_installdir ('llvm')] \
          @[Cfg.cfg] -DLLVM_ENABLE_RUNTIMES=$[join(Cfg.runtimes, ';')] \
          @Assertions_opt \
          $Src/llvm
  }
}

proc build_llvm_first() {
  if ('hsakmt_build_hack' in ConfigureOpts.llvm and
      ConfigureOpts.llvm.hsakmt_build_hack) {
    hsakmt_DIR=$INSTALLDIR/lib/cmake/hsakmt cmake_build llvm_first
  } else {
    cmake_build llvm_first
  }
}

proc install_llvm_first() {
  cmake_install llvm_first
}

func llvm_first_dependencies() {
  return ([])
}

proc llvm_first_tasks() {
  standard_tasks llvm_first
}

proc default_configure_opts_llvm_first() {
  var LLDOpts = []
  if (false and have_binary ('ld.lld')) {
    # Opportunistically use lld if we find it (for linking LLVM libs/binaries
    # themselves).  This should probably be a build option (like Ninja, ccache
    # usage).
    setvar LLDOpts = :| -DLLVM_USE_LINKER=lld |
  }
  set_configure_opts ("llvm_first", :| -DLLVM_BUILD_TOOLS=ON
                                       -DLLVM_ENABLE_Z3_SOLVER=OFF
                                       -DLLVM_ENABLE_ZLIB=ON
                                       -DLLVM_INCLUDE_TESTS=ON
                                       -DCLANG_DEFAULT_LINKER=lld
                                       -DLLVM_PARALLEL_LINK_JOBS=8
                                       -DLLVM_USE_SPLIT_DWARF=TRUE
                                       -DLLVM_PARALLEL_LINK_JOBS=2
                                       @LLDOpts |)
}
