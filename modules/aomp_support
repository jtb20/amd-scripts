# Wrap the build_supp.sh aomp script.  Mostly just avoid using $HOME by
# default.

proc build_aomp_support_component(Component) {
  var AOMP_Src = get_srcdir ("aomp")
  var Src = get_srcdir(Component)
  var Build = get_objdir(Component)
  copy_dir $Src $Build
  mkdir -p $Build/tmpbin
  # build_supp.sh wants to download and unpack these itself.  This hack stops
  # it doing that (we run in a bubblewrap with networking disabled).
  cd $Build/tmpbin {
    ln -sf /bin/true wget
    ln -sf /bin/true bzip2
    # This is particularly shocking.  Instead of untarring the just-downloaded
    # tarball, we hijack 'tar' to make a symlink to the source copied above.
    cat > tar <<< "ln -sf \"$Build\" \"$OBJDIR/aomp-support/$Component\""
    chmod +x tar
  }

  mkdir -p $INSTALLDIR/aomp-support

  with-env AOMP=$[get_installdir('llvm')] \
           AOMP_SUPP=$INSTALLDIR/aomp-support \
           AOMP_SUPP_INSTALL=$INSTALLDIR/aomp-support-inst \
           AOMP_SUPP_BUILD=$OBJDIR/aomp-support \
           PATH=$(prepend_path $Build/tmpbin PATH) {
    cd $OBJDIR/aomp-support {
      $AOMP_Src/bin/build_supp.sh $Component
    }
  }
}

