# OPENMPI

# We're not using build_supp.sh for openmpi here because the script contains
# some hard-coded paths that don't match the layout we're using.  So there's
# a bit of slightly unfortunate duplication here.

# Also we really shouldn't be hard-wiring the version number in some of the
# paths below!

func get_openmpi_src() {
  return (get_src_default ("openmpi"))
}

func openmpi_dependencies() {
  return (:| llvm flang_legacy flang_runtime |)
}

proc clean_openmpi() {
  clean_component openmpi
}

proc configure_openmpi() {
  var Src = get_srcdir('openmpi')
  var Obj = get_objdir('openmpi')
  var LLVM_Inst = get_installdir('llvm')
  cd $Obj {
    cp $Src/configure $Src/configure.bak
    try {
      sed -i -e 's/flang\s*)/flang*)/' $Src/configure
      $Src/configure \
        --with-hwloc=$INSTALLDIR \
        --with-hwloc-libdir=$INSTALLDIR/lib \
        OMPI_CC=$LLVM_Inst/bin/clang \
        OMPI_CXX=$LLVM_Inst/bin/clang++ \
        OMPI_F90=$LLVM_Inst/bin/flang \
        CXX=$LLVM_Inst/bin/clang++ \
        CC=$LLVM_Inst/bin/clang \
        FC=$LLVM_Inst/bin/flang \
        --prefix=$INSTALLDIR/aomp-support-inst/openmpi-5.0.0
    }
    var TryError = _error.code
    mv -f $Src/configure.bak $Src/configure
    if (TryError !== 0) {
      error "Configure failed"
    }
  }
}

proc build_openmpi() {
  var Obj = get_objdir('openmpi')
  cd $Obj {
    make -j8
  }
}

proc install_openmpi() {
  var Obj = get_objdir('openmpi')
  cd $Obj {
    make -j8 install
    ln -sf $INSTALLDIR/aomp-support-inst/openmpi-5.0.0 \
           $INSTALLDIR/aomp-support/openmpi
  }
}

proc openmpi_tasks() {
  standard_tasks openmpi
}

