#!/usr/bin/env ysh

proc clean_flang() {
  clean_component flang
}

func get_flang_src() {
  return (get_src_default ("flang"))
}

proc configure_flang() {
  var Build = get_objdir("flang")
  var LLVM_Build = get_objdir("llvm")
  #var DevLibs_Build = get_objdir("device_libs")
  var BuildType = get_build_type("flang")
  var Src = get_srcdir("flang")
  var Tool = get_build_tool("flang")
  var LLVMCfg = ConfigureOpts["llvm"]
  var CompIncDir = "$Src/runtime/libpgmath/lib/common"
  cd $Build {
    cmake -G $Tool -DCMAKE_INSTALL_PREFIX=$[get_installdir('llvm')] \
      -DCMAKE_BUILD_TYPE=$BuildType \
      -DLLVM_ENABLE_ASSERTIONS=ON \
      -DLLVM_CONFIG=$[get_installdir('llvm')]/bin/llvm-config \
      -DCMAKE_C_COMPILER=$[get_installdir('llvm')]/bin/clang \
      -DCMAKE_CXX_COMPILER=$[get_installdir('llvm')]/bin/clang++ \
      -DCMAKE_C_FLAGS="${CFLAGS:-} -I$CompIncDir" \
      -DCMAKE_CXX_FLAGS="${CXXFLAGS:-} -I$CompIncDir" \
      -DCMAKE_Fortran_COMPILER=gfortran \
      -DLLVM_TARGETS_TO_BUILD=$[join(LLVMCfg.targets, ';')] \
      -DFLANG_OPENMP_GPU_AMD=ON \
      -DFLANG_OPENMP_GPU_NVIDIA=ON \
      -DLLVM_INSTALL_TOOLCHAIN_ONLY=ON \
      -DFLANG_INCLUDE_TESTS=ON \
      -DLLVM_EXTERNAL_LIT=$[get_srcdir('llvm')]/llvm/utils/lit/lit.py \
      -DTARGET_TRIPLE=amdgcn-amd-amdhsa \
      @[get_rpath_opts('flang')] \
      $Src
  }
}

proc build_flang() {
  cmake_build flang
}

proc install_flang() {
  cmake_install flang
}

func flang_dependencies() {
  return (:| llvm |)
}

proc flang_tasks {
  standard_tasks flang
}

proc clean_results_flang_legacy () {
  var Build = get_objdir('flang')
  rm -f $Build/test/testresults.json
}

proc test_flang_legacy () {
  var Build = get_objdir('flang')
  var LLVM_Build = get_objdir('llvm')
  cd $Build {
    try {
      ln -sf $LLVM_Build/bin/FileCheck $Build/bin
      ln -sf $LLVM_Build/bin/count $Build/bin
      ln -sf $LLVM_Build/bin/not $Build/bin
      if (SelectTests !== null) {
        # This is a regex, not a glob, like the regular LLVM tests.
        LIT_FILTER=$SelectTests LIT_OPTS="-o testresults.json" ninja -k 0 check-flang
      } else {
        LIT_OPTS="-o testresults.json" ninja -k 0 check-flang
      }
    }
  }
  if (_error.code === 0) {
    write "Success."
  } else {
    write "Failure."
  }
}

proc save_results_flang_legacy (; files) {
  var Build = get_objdir('flang')
  var ResultFile = "$Build/test/testresults.json"
    if test --exists $ResultFile {
      cp $ResultFile $TESTRESULTSDIR/flang-legacy.json
      call files->setValue (:| flang-legacy.json |)
    }
}
