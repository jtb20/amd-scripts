#!/usr/bin/env ysh

proc clean_comgr() {
  clean_component comgr
}

func get_comgr_src() {
  return (get_src_default ("comgr"))
}

proc add_symlink_comgr() {
  var LLVM_Src = get_srcdir('llvm')
  var SPIRV_Translator_Src = get_srcdir('spirv_llvm_translator')
  # This doesn't seem completely legit. FIXME?
  ln -sf $SPIRV_Translator_Src/include $LLVM_Src/llvm/include/LLVMSPIRVLib
}

proc remove_symlink_comgr() {
  var LLVM_Src = get_srcdir('llvm')
  rm -f $LLVM_Src/llvm/include/LLVMSPIRVLib
}

proc configure_comgr() {
  var Build = get_objdir("comgr")
  var LLVM_Build = get_objdir("llvm")
  var DevLibs_Build = get_objdir("device_libs")
  var BuildType = get_build_type("comgr")
  var Src = get_srcdir("comgr")
  var Tool = get_build_tool("comgr")
  var Cfg = ConfigureOpts.comgr
  cd $Build {
    cmake -G $Tool -DCMAKE_INSTALL_PREFIX=$INSTALLDIR \
      -DCMAKE_BUILD_TYPE=$BuildType \
      -DCMAKE_PREFIX_PATH="$LLVM_Build;$DevLibs_Build" \
      -DCOMGR_BUILD_SHARED_LIBS=ON \
      -DLLVM_DIR=$LLVM_Build \
      -DClang_DIR=$LLVM_Build \
      @[Cfg.cfg] \
      $Src
  }
}

proc default_configure_opts_comgr() {
  set_configure_opts ("comgr", [])
}

proc build_comgr() {
  rocm_env cmake_build comgr
}

proc install_comgr() {
  rocm_env cmake_install comgr
}

func comgr_dependencies() {
  return (:| llvm device_libs |)
}

proc comgr_tasks {
  if (ConfigureOpts.llvm.spirv_translator) {
    add_tasks comgr clean add_symlink configure build install remove_symlink
  } else {
    standard_tasks comgr
  }
}
