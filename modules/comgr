  #exit 1
#fi

clean_comgr() {
  clean_component comgr
}

print_comgr_src() {
  local LLVMSRC="$(print_llvm_src)"
  echo "$LLVMSRC/amd/comgr"
}

configure_comgr() {
  local BUILD="$(print_objdir comgr)"
  local LLVMBUILD="$(print_objdir llvm)"
  local DEVLIBSBUILD="$(print_objdir device_libs)"
  local SRC="$(print_srcdir comgr)"
  pushd "$BUILD" >& /dev/null
  cmake --log-level=DEBUG --debug-output \
    -DCMAKE_INSTALL_PREFIX="$INSTALLDIR" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_PREFIX_PATH="$LLVMBUILD;$DEVLIBSBUILD" \
    -DCOMGR_BUILD_SHARED_LIBS=ON \
    -DLLVM_DIR="$LLVMBUILD" \
    -DClang_DIR="$LLVMBUILD" \
    "$SRC" >& "$LOGDIR/comgr-config.log"
  popd >& /dev/null
}

build_comgr() {
  local BUILD="$(print_objdir comgr)"
  pushd "$BUILD" >& /dev/null
  make -j32 >& comgr-build.log
  popd >& /dev/null
}

install_comgr() {
  local BUILD="$(print_objdir comgr)"
  pushd "$BUILD" >& /dev/null
  make -j32 install >& comgr-install.log
  popd >& /dev/null
}

func comgr_dependencies() {
  return (:| llvm device_libs |)
}

proc comgr_tasks {
  standard_tasks comgr
}
