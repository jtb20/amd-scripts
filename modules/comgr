#!/bin/bash
DIRNAME="$(dirname $0)"
HERE="$(cd "$DIRNAME" && pwd)"
cmake --log-level=DEBUG --debug-output \
  -DCMAKE_INSTALL_PREFIX=$HERE/install \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_PREFIX_PATH="$HERE/llvmbuild;$HERE/devlibsbuild" \
  -DCOMGR_BUILD_SHARED_LIBS=ON \
  -DLLVM_DIR="$HERE/llvmbuild" \
  -DClang_DIR="$HERE/llvmbuild" \
  "$HERE/llvm-project/amd/comgr"
