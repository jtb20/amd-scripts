#!/usr/bin/env ysh

proc clean_comgr(var="") {
  clean_component comgr $var
}

func get_comgr_src() {
  # Before ROCm 6.0, comgr lived in the ROCm-CompilerSupport repository; such
  # configs declare it as a subcomponent (see modules/rocm_compilersupport).
  return (get_src_default ("comgr"))
}

proc add_symlink_comgr(var="") {
  var LLVM_Src = get_srcdir('llvm')
  var SPIRV_Translator_Src = get_srcdir('spirv_llvm_translator')
  # This doesn't seem completely legit. FIXME?
  ln -sf $SPIRV_Translator_Src/include $LLVM_Src/llvm/include/LLVMSPIRVLib
}

proc remove_symlink_comgr(var="") {
  var LLVM_Src = get_srcdir('llvm')
  rm -f $LLVM_Src/llvm/include/LLVMSPIRVLib
}

proc configure_comgr(var="") {
  var Build = get_objdir("comgr", var) if var else get_objdir("comgr")
  var LLVM_Build = get_objdir("llvm")
  var DevLibs_Build = get_objdir("device_libs")
  var BuildType = get_build_type("comgr")
  var Src = get_srcdir("comgr")
  var Tool = get_build_tool("comgr")
  var Cfg = ConfigureOpts.comgr
  cd $Build {
    variant_cmake comgr "$var" -G $Tool -DCMAKE_INSTALL_PREFIX=$INSTALLDIR \
      -DCMAKE_BUILD_TYPE=$BuildType \
      -DCMAKE_PREFIX_PATH="$LLVM_Build;$DevLibs_Build" \
      -DCOMGR_BUILD_SHARED_LIBS=ON \
      -DLLVM_DIR=$LLVM_Build \
      -DClang_DIR=$LLVM_Build \
      @[Cfg.cfg] \
      @[get_rpath_opts('comgr', var)] \
      $Src
  }
}

proc default_configure_opts_comgr() {
  set_configure_opts ("comgr", [])
}

proc build_comgr(var="") {
  rocm_env cmake_build comgr $var
}

proc install_comgr(var="") {
  rocm_env cmake_install comgr $var
}

func comgr_dependencies() {
  return (:| llvm device_libs |)
}

proc comgr_tasks {
  add_tasks comgr @[comgr_variant_tasks()]
}

### Build variants (see "BUILD VARIANTS" in common, and configs/aomp/aomp-variants.inc) ###

func comgr_supported_variants() {
  return (:| asan |)
}

func comgr_variant_tasks(var=null) {
  if (ConfigureOpts.llvm.spirv_translator) {
    return (:| clean add_symlink configure build install remove_symlink |)
  }
  return (:| clean configure build install |)
}
