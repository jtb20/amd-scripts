#!/usr/bin/env ysh

proc clean_device_libs() {
  clean_component device_libs
}

func get_device_libs_src() {
  var LLVM_Src = get_llvm_src()
  var Relative = Sources.device_libs.subdir
  return ("$LLVM_Src/$Relative")
}

proc configure_device_libs() {
  var Build = get_objdir("device_libs")
  var Src = get_srcdir("device_libs")
  var LLVM_Build = get_objdir("llvm")
  cd $Build {
    cmake "$Src" -DCMAKE_INSTALL_PREFIX=$INSTALLDIR \
      -DCMAKE_PREFIX_PATH=$LLVM_Build \
      -DCMAKE_BUILD_TYPE=Release
  }
}

proc build_device_libs() {
  var Build = get_objdir("device_libs")
  cd $Build {
    make -j32
  }
}

proc install_device_libs() {
  var Build = get_objdir("device_libs")
  cd $Build {
    make -j32 install
  }
}

func device_libs_dependencies() {
  return (:| llvm |)
}

proc device_libs_tasks() {
  standard_tasks device_libs
}
