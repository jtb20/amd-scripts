proc cmake_build(comp, variant="") {
  var BuildDir = get_objdir(comp, variant) if variant else get_objdir(comp)
  var Tool = get_build_tool(comp)
  var Parallelism = get_build_parallelism(comp)
  var Parallelism_opt
  cd $BuildDir {
    if (Tool === "Ninja") {
      setvar Parallelism_opt = :| -j${Parallelism} | if (Parallelism) else ()
      ninja @Parallelism_opt
    } else {
      setvar Parallelism_opt = :| -j${Parallelism} | if (Parallelism) else \
                               :| -j${DefaultParallelism} |
      make @Parallelism_opt
    }
  }
}

proc cmake_install(comp, variant="") {
  var BuildDir = get_objdir(comp, variant) if variant else get_objdir(comp)
  var Tool = get_build_tool(comp)
  var Parallelism = get_build_parallelism(comp)
  var Parallelism_opt
  cd $BuildDir {
    if (Tool === "Ninja") {
      setvar Parallelism_opt = :| -j${Parallelism} | if (Parallelism) else ()
      ninja @Parallelism_opt install
    } else {
      setvar Parallelism_opt = :| -j${Parallelism} | if (Parallelism) else \
                               :| -j${DefaultParallelism} |
      make @Parallelism_opt install
    }
  }
}
