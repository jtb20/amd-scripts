var tr_venv_src = {
  "type" : "subcomponent",
  "parent" : "therock",
  "subdirectory" : "."
}

add_sources ("tr_venv", tr_venv_src)

func get_tr_venv_src() {
  return (".")
}

proc setup_tr_venv() {
  var TRSrc = get_srcdir('therock')
  var Obj = get_objdir('tr_venv')
  
  #rm -rf $Obj
  if ! test --dir $Obj {
    mkdir -p $Obj

    python3 -m venv $Obj
    cd $TRSrc {
      $Obj/bin/pip install -r requirements.txt
    }
  }
}

proc tr_venv_tasks {
  add_tasks tr_venv setup
}

func tr_venv_dependencies() {
  return ([])
}

func get_therock_src() {
  return (get_src_default ("therock"))
}

func therock_dependencies() {
  return (:| tr_venv |)
}

proc cmake_therock {
  var Src = get_srcdir('therock')
  var Obj = get_objdir('therock')
  var Venv = get_objdir('tr_venv')
  var Cfg = get_configure_opts('therock')

  # We've set options by the time this is invoked, so this can set up the build
  # system as we need for this particular build.
  cd $Src {
    VIRTUAL_ENV=$Venv PATH=$(prepend_path $Venv/bin PATH) cmake \
          -DTHEROCK_INTROSPECTION=ON -GNinja -B $Obj \
          -DTHEROCK_AMDGPU_TARGETS=gfx90a @Cfg .
  }
}

proc therock_tasks {
  add_tasks therock cmake
}

func tr_delegate_env(Comp) {
  var Venv = get_objdir('tr_venv')
  var Env = :| VIRTUAL_ENV=$Venv
               PATH=$(prepend_path $Venv/bin PATH)
               THEROCK_INTERACTIVE=ON |
  return (Env)
}

func therock_delegate_gen(Comp, CompName, Info) {
  var TRSrc = get_srcdir('therock')
  var TRObj = get_objdir('therock')
  var Procs = {}
  eval """
  proc clean_tr_${CompName} {
    var LocalEnv = tr_delegate_env('$CompName')
    cd $TRObj {
      with-env @LocalEnv {
        if test --exists "$[Info.bin]/build.ninja" {
          cd $[Info.bin] {
            ninja clean
          }
        }
        ninja $Comp+expunge
      }
    }
  }
  proc configure_tr_${CompName} {
    var LocalEnv = tr_delegate_env('$CompName')
    cd $TRObj {
      with-env @LocalEnv {
        ninja $Comp+configure
      }
    }
  }
  proc build_tr_${CompName} {
    var LocalEnv = tr_delegate_env('$CompName')
    cd $TRObj {
      with-env @LocalEnv {
        if test --exists "$[Info.bin]/build.ninja" {
          cd $[Info.bin] {
            ninja
          }
        } else {
          ninja $Comp+build
        }
      }
    }
  }
  proc stage_tr_${CompName} {
    var LocalEnv = tr_delegate_env('$CompName')
    cd $TRObj {
      with-env @LocalEnv {
        if test --exists "$[Info.bin]/build.ninja" {
          cd $[Info.bin] {
            ninja install
          }
        } else {
          ninja $Comp+stage
        }
      }
    }
  }
  proc dist_tr_${CompName} {
    var LocalEnv = tr_delegate_env('$CompName')
    cd $TRObj {
      with-env @LocalEnv {
        if test --exists "$[Info.bin]/build.ninja" {
          cd $[Info.bin] {
            ninja therock-dist
          }
        } else {
          ninja $Comp+dist
        }
      }
    }
  }
  proc tr_${CompName}_tasks {
    add_tasks tr_${CompName} clean configure build stage dist
  }
  func get_tr_${CompName}_src() {
    return ("$[Info.src]")
  }
  func tr_${CompName}_dependencies() {
    return (['therock'] ++ ConfigureOpts.tr_$CompName.deps)
  }
  """
  setvar Procs["clean_tr_${CompName}"] = getVar("clean_tr_${CompName}")
  setvar Procs["configure_tr_${CompName}"] = getVar("configure_tr_${CompName}")
  setvar Procs["build_tr_${CompName}"] = getVar("build_tr_${CompName}")
  setvar Procs["stage_tr_${CompName}"] = getVar("stage_tr_${CompName}")
  setvar Procs["dist_tr_${CompName}"] = getVar("dist_tr_${CompName}")
  setvar Procs["tr_${CompName}_tasks"] = getVar("tr_${CompName}_tasks")
  setvar Procs["get_tr_${CompName}_src"] = getVar("get_tr_${CompName}_src")
  setvar Procs["tr_${CompName}_dependencies"] = getVar("tr_${CompName}_dependencies")
  return (Procs)
}

proc therock_preinit() {
  var Src = get_srcdir('therock')
  var Obj = get_objdir('therock', 'preinit')
  var Venv = get_objdir('tr_venv')

  if ! test --exists $Obj/subproject_map.json {
    # Subproject map isn't there, try again?
    rm -rf $Obj
  }
  if ! test --dir $Obj {
    mkdir -p $Obj

    setup_tr_venv

    cd $Src {
      VIRTUAL_ENV=$Venv PATH=$(prepend_path $Venv/bin PATH) \
        $Venv/bin/python ./build_tools/fetch_sources.py

      # We're just generating the build task functions, etc., so enable
      # everything here.
      VIRTUAL_ENV=$Venv PATH=$(prepend_path $Venv/bin PATH) cmake \
            -DTHEROCK_INTROSPECTION=ON -GNinja -B $Obj \
            -DTHEROCK_AMDGPU_TARGETS=gfx90a .
    }
  }

  var SrcRel = get_srcdir_rel('therock')

  var SubProj
  json read (&SubProj) < $Obj/subproject_map.json
  for Comp, Info in (SubProj) {
    var CompName = Comp=>replace('-', '_')
    var Procs = therock_delegate_gen(Comp, CompName, Info)
    for Name, Proc in (Procs) {
      call setVar(Name, Proc, global=true)
    }
    set_configure_key ("tr_$CompName", 'deps', dehyphenate_list(Info.runtime_deps ++ Info.build_deps, prepend='tr_'))
    # Convenience symlinks (not quite the same as other amd-scripts configs though!)
    var CompSrcSubdir = get_srcdir_rel("tr_$CompName")
    cd $SRCDIR {
      ln -sfT "$SrcRel/$CompSrcSubdir" $Comp
    }
  }
}

