func gather_build_type_overrides() {
  var Overrides = []
  for Comp, Info in (BuildOpts) {
    if ('build_type' in Info) {
      append -- -D${Comp}_BUILD_TYPE=$[Info.build_type] (Overrides)
    }
  }
  return (Overrides)
}

proc therock_postinit() {
  var Src = get_srcdir('therock')
  var Obj = get_objdir('therock')
  var Venv = get_objdir('tr_venv')
  var Cfg = get_configure_opts('therock')
  var BuildTypeOverrides = gather_build_type_overrides ()
  var BuildOpts = Cfg ++ BuildTypeOverrides \
                  ++ :| -DCMAKE_BUILD_TYPE=$[get_build_type('therock')] |

  # WARNING: This might be a bit prone to cache invalidation problems --
  # it might be better to just run cmake every time.  Slower though.
  if test --exists $Obj/cached-config-opts.json {
    var OldCfg
    json read (&OldCfg) < $Obj/cached-config-opts.json
    if (BuildOpts !== OldCfg) {
      rm -f $Obj/subproject_map.json
    }
  } else {
    rm -f $Obj/subproject_map.json
  }

  if ! test --exists $Obj/subproject_map.json {
    # Subproject map isn't there, try again?
    rm -rf $Obj
  }
  if ! test --dir $Obj {
    mkdir -p $Obj

    json write (BuildOpts) > $Obj/cached-config-opts.json

    cd $Src {
      # We know our proper configuration settings now.  Invoke cmake again
      # with that knowledge.
      VIRTUAL_ENV=$Venv PATH=$(prepend_path $Venv/bin PATH) cmake \
            -DTHEROCK_INTROSPECTION=ON -GNinja -B $Obj \
            -DCMAKE_INSTALL_PREFIX=$INSTALLDIR \
            @[cmake_ccache_option('therock')] \
            -DTHEROCK_AMDGPU_TARGETS=gfx90a @BuildOpts .
    }
  }

  var SubProj
  json read (&SubProj) < $Obj/subproject_map.json
  for Comp, Info in (SubProj) {
    var CompName = Comp=>replace('-', '_')
    add_components "tr_$CompName"
    if ("tr_$CompName" not in ConfigureOpts) {
      write -- "-- project $Comp unexpectedly appeared in postinit"
    }
    var AllDeps = Info.runtime_deps ++ Info.build_deps
    write "Comp $Comp: Deps: $[AllDeps.join(', ')]"
    if (AllDeps !== ConfigureOpts["tr_$CompName"].deps) {
      # This probably isn't necessary -- it's in case dependencies get dropped
      # when we select a smaller set of enabled projects.
      setvar ConfigureOpts["tr_$CompName"].deps = dehyphenate_list(AllDeps, prepend='tr_')
    }
  }

  var DependOnAll = []
  for Comp in (SubProj) {
    call DependOnAll->append(Comp)
  }
  eval """
  func tr_finalize_dependencies() {
    return (:| @[dehyphenate_list(DependOnAll, prepend='tr_')] |)
  }
  """
  call setVar('tr_finalize_dependencies', tr_finalize_dependencies, global=true)

  add_components tr_finalize

  # Convenience symlink for "TheRock" logs
  cd "$LOGDIR/.." {
    ln -sfT $Obj/logs therock-logs
  }
}

