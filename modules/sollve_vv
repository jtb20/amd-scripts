proc test_misc_sollve_vv {
  var AOMP_Src = get_srcdir ("aomp")
  var Source = get_srcdir ("sollve_vv")
  var Obj = get_objdir ("sollve_vv")
  var ROCmOpts = []
  if ('sollve_vv' in ConfigureOpts and \
      'rocm_opts' in ConfigureOpts.sollve_vv) {
    setvar ROCmOpts = ConfigureOpts.sollve_vv.rocm_opts
  }
  copy_dir $Source $Obj
  maybe_mkdir $Obj/tmpbin
  # The run_solvve.sh script tries to update the repo -- let's try to avoid
  # that here (it'd be confusing since we're copying the source directory
  # above, and if we update in the obj directory then sources could get out of
  # sync).
  ln -sf $(which true) $Obj/tmpbin/git
  cd $Obj {
    var Parts = Obj=>split("/")
    # MY_SOLLVE_FLAGS="-Wl,-rpath,$INSTALLDIR/lib:$INSTALLDIR/lib/x86_64-unknown-linux-gnu --rocm-path=/opt/rocm -O2 -fopenmp --offload-arch=gfx90a"
    shvar AOMP=$INSTALLDIR \
          AOMP_REPOS_TEST=$[Parts[:-1]=>join("/")] \
          AOMP_SOLVV_REPO_NAME=$[Parts[-1]] \
          PATH=$Obj/tmpbin:$PATH \
          LD_LIBRARY_PATH=$INSTALLDIR/lib:$INSTALLDIR/lib/x86_64-unknown-linux-gnu \
          SKIP_SOLLVE45=0 \
          SKIP_SOLLVE50=0 \
          SKIP_SOLLVE51=0 \
          SKIP_SOLLVE52=0 {
      export AOMP
      export AOMP_REPOS_TEST
      export AOMP_SOLVV_REPO_NAME
      export PATH
      export LD_LIBRARY_PATH
      export SKIP_SOLLVE45
      export SKIP_SOLLVE50
      export SKIP_SOLLVE51
      export SKIP_SOLLVE52
      #export MY_SOLLVE_FLAGS

      if (SelectTests !== null) {
        # Not beautiful, but maybe useful?
        # Maybe we should have "sollve" be its own test group, containing
        # 4.5/5.0/5.1/5.2 "testsuites", instead?
        case (SelectTests) {
          "4.5" {
            export SKIP_SOLLVE50=1
            export SKIP_SOLLVE51=1
            export SKIP_SOLLVE52=1
            rocm_env @ROCmOpts $AOMP_Src/bin/run_sollve.sh
          }
          "5.0" {
            export SKIP_SOLLVE45=1
            export SKIP_SOLLVE51=1
            export SKIP_SOLLVE52=1
            rocm_env @ROCmOpts $AOMP_Src/bin/run_sollve.sh
          }
          "5.1" {
            export SKIP_SOLLVE45=1
            export SKIP_SOLLVE50=1
            export SKIP_SOLLVE52=1
            rocm_env @ROCmOpts $AOMP_Src/bin/run_sollve.sh
          }
          "5.2" {
            export SKIP_SOLLVE45=1
            export SKIP_SOLLVE50=1
            export SKIP_SOLLVE51=1
            rocm_env @ROCmOpts $AOMP_Src/bin/run_sollve.sh
          }
          * {
            if ! test --exists bin {
              mkdir -p bin
            }
            # This isn't a glob, exactly.  It needs to identify an individual
            # test case.  The run_sollve.sh script just compiles the test, and
            # doesn't attempt to run it (so we do that here instead).
            try > singletest.log {
              rocm_env @ROCmOpts $AOMP_Src/bin/run_sollve.sh $SelectTests
            }
            var MakeStatus = _status
            var TestSrc = null
            var TestBin = null
            var SourcePattern = / 'Source file:' s+ <capture .* as Src> /
            var GoodBin = / 'Binary' s+ <capture .* as Bin> ' exists!' /
            var BadBin = / 'Expected binary' s+ <capture .* as Bin> s+ 'does NOT exist!' /
            cat singletest.log | while read n {
              if (n ~ SourcePattern) {
                setvar TestSrc = _group('Src')
              } elif (n ~ GoodBin) {
                setvar TestBin = _group('Bin')
              } elif (n ~ BadBin) {
                setvar MakeStatus = 1
              }
            }
            rm -f singletest.sum
            if (TestSrc === null) {
              cat singletest.log >&2
              # This probably means an individual test wasn't found.
              error "Test source pattern not found"
            }
            var TestSrcRel = TestSrc=>trimStart(Obj++"/")
            if (MakeStatus === 0) {
              write "PASS: $TestSrcRel compile" >> singletest.sum
            } else {
              write "FAIL: $TestSrcRel compile" >> singletest.sum
            }
            if (TestBin === null) {
              write "SKIPPED: $TestSrcRel run" >> singletest.sum
            } else {
              try {
                $TestBin
              }
              if (_status === 0) {
                write "PASS: $TestSrcRel run" >> singletest.sum
              } else {
                write "FAIL: $TestSrcRel run" >> singletest.sum
              }
            }
          }
        }
      } else {
        rocm_env @ROCmOpts $AOMP_Src/bin/run_sollve.sh
      }
    }
  }
}

proc sollve_json_to_sum(; FileName) {
  sed -e 's/var jsonResults =//' -e 's/^];/]/' < $FileName | json read (&J)

  for Test in (J) {
    var TestPath = Test["Test path"]
    var CompileRes = Test["Compiler result"]
    var RunRes = Test["Runtime result"]
    write -- "$CompileRes: $TestPath compile"
    if (CompileRes === "FAIL") {
      setvar RunRes = "SKIPPED"
    }
    write -- "$RunRes: $TestPath run"
  }
}

proc sollve_json_to_log(; FileName, ObjDir) {
  sed -e 's/var jsonResults =//' -e 's/^];/]/' < $FileName | json read (&J)

  for Test in (J) {
    var CompilerCmd = Test["Compiler command"]
    var CompilerOutput = Test["Compiler output"]
    var TestName = Test["Test name"]
    var TestPath = Test["Test path"]
    var CompileRes = Test["Compiler result"]
    var BinPath = Test["Binary path"]
    if (CompileRes !== "FAIL") {
      setvar BinPath = "bin/${TestName}.bin"
    }
    var CompileOutput = Test["Compiler output"]
    write -- "Compile $TestName:"
    # Try to write this so it can be copy/pasted directly.
    write -- "$CompilerCmd $ObjDir/$TestPath -o $[BinPath=>trimStart("bin/")]"
    write -- $CompileOutput
    write -- "$CompileRes: $TestPath compile"
    var RunRes = Test["Runtime result"]
    if (CompileRes !== "FAIL") {
      write -- "Execute $BinPath:"
      var RunOutput = Test["Runtime output"]
      write -- $RunOutput
    } else {
      setvar RunRes = "SKIPPED"
    }
    write -- "$RunRes: $TestPath run"
  }
}

proc clean_results_misc_sollve_vv () {
  var Obj = get_objdir ("sollve_vv")

  cd $Obj {
    rm -rf bin
    rm -rf results_report*
  }
}

proc save_results_misc_sollve_vv (; files) {
  var Obj = get_objdir ("sollve_vv")
  var FoundResults = false

  cd $Obj {
    if test --exists singletest.sum {
      # The run_sollve.sh script has support for building a single test, but
      # does not populate the JSON, etc. result files in that case.  So this
      # script does it manually instead.
      cp -f singletest.log $TESTRESULTSDIR/sollve.log
      cp -f singletest.sum $TESTRESULTSDIR/sollve.sum
      setvar FoundResults = true
      # FIXME: ysh control flow.
      return
    }

    for Dir in results_report* {
      sollve_json_to_sum ("$Dir/results.json")
      setvar FoundResults = true
    } > $TESTRESULTSDIR/sollve.sum
    for Dir in results_report* {
      sollve_json_to_log ("$Dir/results.json", Obj)
    } > $TESTRESULTSDIR/sollve.log
  }

  if (FoundResults) {
    call files->setValue (:| sollve.sum |)
  }
}

