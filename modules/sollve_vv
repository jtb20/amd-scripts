}

proc test_misc_sollve_vv {
  var AOMP_Src = get_srcdir ("aomp")
  var Source = get_srcdir ("sollve_vv")
  var Obj = get_objdir ("sollve_vv")
  copy_dir $Source $Obj
  maybe_mkdir $Obj/tmpbin
  # The run_solvve.sh script tries to update the repo -- let's try to avoid
  # that here (it'd be confusing since we're copying the source directory
  # above, and if we update in the obj directory then sources could get out of
  # sync).
  ln -sf $(which true) $Obj/tmpbin/git
  cd $Obj {
    var Parts = Obj=>split("/")
    shvar AOMP=$INSTALLDIR \
          AOMP_REPOS_TEST=$[Parts[:-1]=>join("/")] \
          AOMP_SOLVV_REPO_NAME=$[Parts[-1]] \
          PATH=$Obj/tmpbin:$PATH \
          LD_LIBRARY_PATH=$INSTALLDIR/lib/x86_64-unknown-linux-gnu {
      export AOMP
      export AOMP_REPOS_TEST
      export AOMP_SOLVV_REPO_NAME
      export PATH
      export LD_LIBRARY_PATH

      $AOMP_Src/bin/run_sollve.sh
    }
  }
}

proc sollve_json_to_sum(; FileName) {
  sed -e 's/var jsonResults =//' -e 's/^];/]/' < $FileName | json read (&J)

  for Test in (J) {
    var TestPath = Test["Test path"]=>trimStart("tests/")
    var CompileRes = Test["Compiler result"]
    var RunRes = Test["Runtime result"]
    write -- "$CompileRes: $TestPath compile"
    if (CompileRes === "FAIL") {
      setvar RunRes = "SKIPPED"
    }
    write -- "$RunRes: $TestPath run"
  }
}

proc sollve_json_to_log(; FileName, ObjDir) {
  sed -e 's/var jsonResults =//' -e 's/^];/]/' < $FileName | json read (&J)

  for Test in (J) {
    var CompilerCmd = Test["Compiler command"]
    var CompilerOutput = Test["Compiler output"]
    var TestName = Test["Test name"]
    var TestPath = Test["Test path"]
    var CompileRes = Test["Compiler result"]
    var BinPath = Test["Binary path"]
    if (CompileRes !== "FAIL") {
      setvar BinPath = "bin/${TestName}.bin"
    }
    var CompileOutput = Test["Compiler output"]
    write -- "Compile $TestName:"
    # Try to write this so it can be copy/pasted directly.
    write -- "$CompilerCmd $ObjDir/$TestPath -o $[BinPath=>trimStart("bin/")]"
    write -- $CompileOutput
    write -- "$CompileRes: $TestPath compile"
    var RunRes = Test["Runtime result"]
    if (CompileRes !== "FAIL") {
      write -- "Execute $BinPath:"
      var RunOutput = Test["Runtime output"]
      write -- $RunOutput
    } else {
      setvar RunRes = "SKIPPED"
    }
    write -- "$RunRes: $TestPath run"
  }
}

proc clean_results_misc_sollve_vv () {
  var Obj = get_objdir ("sollve_vv")

  cd $Obj {
    rm -rf bin
    rm -rf results_report*
  }
}

proc save_results_misc_sollve_vv (; files) {
  var Obj = get_objdir ("sollve_vv")
  var FoundResults = false

  cd $Obj {
    for Dir in results_report* {
      sollve_json_to_sum ("$Dir/results.json")
      setvar FoundResults = true
    } > $TESTRESULTSDIR/sollve.sum
    for Dir in results_report* {
      sollve_json_to_log ("$Dir/results.json", Obj)
    } > $TESTRESULTSDIR/sollve.log
  }

  if (FoundResults) {
    call files->setValue (:| sollve.sum |)
  }
}

