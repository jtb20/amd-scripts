func get_nekbone_src() {
  return (get_src_default ("nekbone"))
}

func nekbone_dependencies() {
  return (:| aomp |)
}

proc nekbone_tasks {
  # No tasks!
  true
}

proc clean_results_misc_nekbone() {
  clean_component nekbone
}

proc test_misc_nekbone() {
  var AOMP_Src = get_srcdir ("aomp")
  var Source = get_srcdir ("nekbone")
  var Obj = get_objdir ("nekbone")
  var GPUs = get_amd_gpus()
  #var CompileOpts = '-x f77 -fopenmp -fopenmp-targets=amdgcn-amd-amdhsa -mcpu=$(AOMP_GPU) ${G_OPT}'
  copy_dir $Source $Obj/Nekbone
  shvar CaseDir=$Obj/Nekbone/test/nek_gpu1 \
        NekSrc=$Obj/Nekbone/src {
    sed -e "s@^CASEDIR:=.*@CASEDIR:=$CaseDir@" -e "s@^S:=.*@S:=$NekSrc@" \
      < $Source/test/nek_gpu1/makefile.aomp \
      > $Obj/Nekbone/test/nek_gpu1/makefile.aomp
  }
  shvar AOMP=$INSTALLDIR \
        AOMP_REPOS_TEST=$Obj \
        LD_LIBRARY_PATH=$INSTALLDIR/lib/x86_64-unknown-linux-gnu \
        VERBOSE=1 \
        FLANG=flang \
        AOMP_GPU=$[GPUs[0]] {
    export AOMP
    export AOMP_REPOS_TEST
    export LD_LIBRARY_PATH
    export VERBOSE
    export FLANG
    export AOMP_GPU

    $AOMP_Src/bin/run_nekbone.sh
  }
}
