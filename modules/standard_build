#!/usr/bin/env ysh

proc standard_configure(comp) {
  var Build = get_objdir(comp)
  var Src = get_srcdir(comp)
  cd $Build {
    var cfg_opts=:| --prefix=$INSTALLDIR |
    if (comp in ConfigureOpts) {
      if ("cfg" in ConfigureOpts[comp]) {
        setvar cfg_opts = cfg_opts ++ ConfigureOpts[comp].cfg
      }
      if ("target" in ConfigureOpts[comp]) {
        call cfg_opts->append("--target=$[ConfigureOpts[comp].target]")
      }
      if ("host" in ConfigureOpts[comp]) {
        call cfg_opts->append("--host=$[ConfigureOpts[comp].host]")
      }
      if ("build" in ConfigureOpts[comp]) {
        call cfg_opts->append("--build=$[ConfigureOpts[comp].build]")
      }
      if (get_build_ccache(comp)) {
        setvar cfg_opts = cfg_opts ++ autotools_ccache_option(comp)
      }
    }
    $Src/configure @cfg_opts
  }
}

proc standard_build(comp) {
  var Build = get_objdir(comp)
  var Parallelism = get_build_parallelism(comp)
  var Parallelism_opt = :| -j${Parallelism} | if (Parallelism) else \
                        :| -j${DefaultParallelism} |
  cd $Build {
    make @Parallelism_opt
  }
}

proc standard_install(comp) {
  var Build = get_objdir(comp)
  var Parallelism = get_build_parallelism(comp)
  var Parallelism_opt = :| -j${Parallelism} | if (Parallelism) else \
                        :| -j${DefaultParallelism} |
  cd $Build {
    make @Parallelism_opt install
  }
}
