proc show_vars {
  write "HIP_CLANG_PATH: $[ENV.HIP_CLANG_PATH]"
  write "ROCM_PATH: $[ENV.ROCM_PATH]"
  write "HIP_PATH: $[ENV.HIP_PATH]"
  write "LLVM_PATH: $[ENV.LLVM_PATH]"
  write "PATH: $[ENV.PATH]"
}

# Resolve a user-supplied directory to an absolute path.  The scripts hand
# these paths to bubblewrap and to build systems that run with a different
# working directory, so a relative one would not survive.  Canonicalisation is
# left until the directory exists; see do_bwrap.

func absolute_dir (Dir) {
  if (Dir=>startsWith('/')) {
    return (Dir)
  }
  return ("$WORKDIR/$Dir")
}

# Brief -h/--help output for amd-build, amd-test and amd-checkout, which share
# parse_args.  Only the options each script reads are shown; the README has
# the full story.
proc show_help() {
  var IsCheckout = ScriptName === 'amd-checkout'
  var IsTest = ScriptName === 'amd-test'
  case (ScriptName) {
    amd-checkout {
      write -n """
      Usage: amd-checkout [OPTION]... CONFIG [COMPONENT]...
      Clone or update the sources CONFIG needs (or only the named components).
      """
    }
    amd-test {
      write -n """
      Usage: amd-test [OPTION]... CONFIG [TASK]...
      Run CONFIG's test suites against its build, and summarise the results.
      """
    }
    (else) {
      write -n """
      Usage: $ScriptName [OPTION]... CONFIG [TASK]...
      Build CONFIG's components (or the selected tasks), in a bubblewrap sandbox.
      """
    }
  }
  write -n """

  CONFIG is a path under configs/, e.g. aomp/23/amd-staging-rocm-7.2.cfg.
  """
  if (not IsCheckout) {
    write -n """

    Tasks (run in order; none means all of them):
      list                 print the numbered task list and exit
      N, N--M              run task N, or tasks N to M
      continue             run from the task after the last one to the end
      PATTERN              run every task whose name contains PATTERN
    """
    if (not IsTest) {
      write "  list-variants        print the build variants on offer and exit"
    }
  }
  write -n """

  Work directory layout (relative paths are relative to the current directory):
    -s, --source DIR       source checkouts (default: src)
  """
  if (IsCheckout) {
    write "  -d, --downloads DIR    downloaded archives (default: archives)"
  } else {
    write -n """
      -b, --build DIR        build trees (default: obj)
      -i, --install DIR      install tree (default: install)
      -l, --logs DIR         task logs (default: logs)
    """
    if (IsTest) {
      write "  -t, --testresults DIR  test results (default: testresults)"
    }
  }
  write -n """

  Configuration:
    -A, --add MOD[,MOD]    enable optional modules
  """
  if (not IsCheckout) {
    write "  -R, --remove FEAT[,..] disable default features"
  }
  if (not IsCheckout and not IsTest) {
    write -n """
      -D                     no build variants (same as --variant default)
          --variant SPEC     variants to build: NAME[,..] or COMP=NAME[,..]
      -g, --debug            build everything as Debug
          --debug=COMP[,..]  build the named components as Debug
          --assertions=COMP[,..]  enable assertions in the named components
      -r, --rpath            use \$ORIGIN rpaths (default for amd-staging configs)
          --no-rpath         don't
      -j N                   build parallelism
      -C, --clean            empty the install tree first
    """
  }
  write "      --ghuser USER      GitHub username, for configs that clone a fork"
  if (IsTest) {
    write -n """

    Testing:
      -S, --select PATTERN   run only matching tests (syntax depends on the suite)
          --gpurun=ARGS      extra arguments for gpurun
          --gpu-offset N     GPU device bias (GPURUN_DEVICE_BIAS)
          --gpu-devices L    visible GPUs (ROCR_VISIBLE_DEVICES)
          --aomp DIR         test a preinstalled AOMP
    """
  }
  if (not IsCheckout) {
    write -n """

    Sandbox:
      -B, --no-bwrap         don't use the bubblewrap sandbox
          --share-net        keep network access inside the sandbox
      -H, --bind-homebrew    make Homebrew's tools available in the sandbox
      -T, --toolsroot DIR    use DIR (see build-toolsroot) as the root filesystem
          --shell            start a shell in the sandbox instead
    """
  }
  write -n """

    -h, --help             show this help and exit

  Full documentation: $SCRIPTDIR/README.md
  """
}

proc parse_args(; argv) {
  var spec
  var tasks
  var argc = len(argv)
  var opt = 0
  var positional = 0
  var args = {}
  var cfg
  while (opt < argc) {
    case (argv[opt]) {
      -h | --help {
        show_help
        exit 0
      }

      --ghuser {
        setvar opt += 1
        setglobal GithubUsername = argv[opt]
      }

      -g | --debug {
        setglobal DefaultBuildOpts.build_type = "Debug"
      }

      --debug=* {
        var DebugComponents = argv[opt]=>trimStart('--debug=')=>split(',')
        for D in (DebugComponents) {
          if (D not in BuildOpts) {
            setglobal BuildOpts[D] = {}
          }
          setglobal BuildOpts[D].build_type = "Debug"
        }
      }

      --assertions=* {
        var AssertionsComponents = argv[opt]=>trimStart('--assertions=')=>split(',')
        for A in (AssertionsComponents) {
          if (A not in BuildOpts) {
            setglobal BuildOpts[A] = {}
          }
          setglobal BuildOpts[A].assertions = true
        }
      }

      -D {
        # Shorthand for --variant default: only the default builds.
        append default (VariantRequest.all)
      }

      --variant | --variant=* {
        var VarSpec
        if (argv[opt] === '--variant') {
          setvar opt += 1
          setvar VarSpec = argv[opt]
        } else {
          setvar VarSpec = argv[opt]=>trimStart('--variant=')
        }
        for Item in (VarSpec=>split(',')) {
          if (Item ~~ '*=*') {
            var Parts = Item=>split('=')
            if (Parts[0] not in VariantRequest.per) {
              setglobal VariantRequest.per[Parts[0]] = []
            }
            append $[Parts[1]] (VariantRequest.per[Parts[0]])
          } else {
            append $Item (VariantRequest.all)
          }
        }
      }

      -S | --select {
        setvar opt += 1
        setglobal SelectTests = argv[opt]
      }

      -A | --add {
        setvar opt += 1
        setglobal OptionalModules = OptionalModules ++ split(argv[opt], ',')
      }

      -R | --remove {
        setvar opt += 1
        setglobal RemovedFeatures = RemovedFeatures ++ split(argv[opt], ',')
      }

      -r | --rpath {
        setglobal SetRPathOpts = true
      }

      --no-rpath {
        setglobal SetRPathOpts = false
      }

      -B | --no-bwrap {
        setglobal NoBWrap = true
      }

      -j | -j* {
        if (argv[opt] === '-j') {
          setvar opt += 1
          setglobal DefaultBuildOpts.parallelism = argv[opt]
        } else {
          setglobal DefaultBuildOpts.parallelism = argv[opt]=>trimStart('-j')
        }
      }

      -T | --toolsroot {
        setvar opt += 1
        setglobal ToolsRoot = argv[opt]
      }

      # Repoint the work directory layout.  Note the lowercase/uppercase pairs:
      # -s is not -S, -b is not -B, -t is not -T.

      -s | --source {
        setvar opt += 1
        setglobal SRCDIR = absolute_dir(argv[opt])
      }

      -b | --build {
        setvar opt += 1
        setglobal OBJDIR = absolute_dir(argv[opt])
      }

      -i | --install {
        setvar opt += 1
        setglobal INSTALLDIR = absolute_dir(argv[opt])
      }

      -t | --testresults {
        setvar opt += 1
        setglobal TESTRESULTSDIR = absolute_dir(argv[opt])
      }

      -l | --logs {
        setvar opt += 1
        setglobal LOGDIR = absolute_dir(argv[opt])
      }

      -d | --downloads {
        setvar opt += 1
        setglobal ARCHIVEDIR = absolute_dir(argv[opt])
      }

      --share-net {
        setglobal BwrapUnshareNet = false
      }

      -H | --bind-homebrew {
        setglobal BindHomebrew = true
      }

      -C | --clean {
        setglobal CleanInstallDir = true
      }

      --shell {
        if (NoBWrap) {
          write """
          *** This is a bubble-wrapped shell, unless you explicitly specified
          *** -B/--no-bwrap on the command line.  Exit with ctrl-D.
          """
          debian_chroot='bwrap' exec $[ENV.SHELL]
        }
      }

      --gpurun=* {
        setglobal GPURunOpts = argv[opt]=>trimStart('--gpurun=')=>shSplit()
      }

      --gpu-offset {
        setvar opt += 1
        setglobal GPUOffset = argv[opt]
      }

      --gpu-devices {
        setvar opt += 1
        setglobal GPUDevices = GPUDevices ++ split(argv[opt], ',')
      }

      # Test a toolchain installed elsewhere rather than one built here.  This
      # only makes sense for amd-test: get_llvm_install returns this directory
      # for everything that asks, and several modules use that as their CMake
      # install prefix, so building with it set would install over the very
      # tree we were asked to test against.
      --aomp {
        setvar opt += 1
        if (ScriptName !== 'amd-test') {
          error "The --aomp option is only meaningful for amd-test, not $ScriptName"
        }
        setglobal PreinstalledAOMP = absolute_dir(argv[opt])
      }

      --showdep {
        setvar opt += 1
        setglobal DebugDep = argv[opt]
      }

      --flang-name {
        setvar opt += 1
        setglobal FlangAdjectiveOverride = argv[opt]
      }

      -* {
        error "Unknown option: $[argv[opt]]"
      }

      * {
        if (positional === 0) {
          setglobal ActiveCfg = argv[opt]
          setvar positional += 1
        } else {
          setglobal TASKLIST = argv[opt:]
          setvar opt = argc
        }
      }
    }
    setvar opt += 1
  }
  # This is a nice ysh feature, but it's not fully baked yet...
  #parser (&spec) {
  #  flag -u --ghuser ('str', default="", help="GitHub username")
  #  arg cfg (help='Build configuration file')
  #  rest tasks
  #}
  #var args = parseArgs (spec, argv)
  #setglobal ActiveCfg = args.cfg
  #setglobal TASKLIST = args.tasks
  #setglobal GithubUsername = args.ghuser
  if (ActiveCfg === null) {
    error "Please specify a config file (from configs/*.cfg)"
  } elif ! test -e $CONFIGDIR/$ActiveCfg {
    error "No such config: $ActiveCfg"
  }
}

proc add_sources(; component, opts) {
  if (component in Sources) {
    error "Attempt to add component $component twice"
  }
  setglobal Sources[component] = opts
}

proc debug_dep(Place; DepList) {
  if (DebugDep) {
    if (in_list(DebugDep, DepList)) {
      write "Added $DebugDep dependency from $Place"
    }
  }
}

proc add_components(...components) {
  for comp in (components) {
    if (not in_list (comp, Components)) {
      # The delegated build 'ao_<component>' tasks don't have sources set.
      if (comp not in Sources and comp[0:3] !== 'ao_' and comp[0:3] !== 'tr_') {
        error "No source for component $comp!"
      }
      if (comp[0:3] !== 'ao_' and comp in Sources and 'deps' in Sources[comp]) {
        # Allow per-version dependencies to override dependencies added by the
        # 'static' dependencies function.  This isn't entirely neat, but it'll
        # do for now.
        debug_dep "$comp source block" (Sources[comp].deps)
        add_components @[Sources[comp].deps]
      } else {
        var deps = lookup_func("${comp}_dependencies")()
        debug_dep "${comp}_dependencies function" (deps)
        add_components @deps
      }
      try {
        var cond_deps = lookup_func ("${comp}_conditional_deps")()
        debug_dep "${comp}_conditional_deps function" (cond_deps)
        add_components @cond_deps
      }
      # Wipe 'sticky' errors from failed lookup_func above.
      clear_error
      if (DebugDep and comp === DebugDep) {
        write "Adding $comp now"
      }
      append $comp (Components)
      if (has_proc ("default_configure_opts_${comp}")) {
        # If we have a "default_configure_opts_${comp}" procedure for the
        # module, invoke it now.  Configuration files can then append their
        # own options, etc. as necessary.
        eval "default_configure_opts_${comp}"
      }
    }
  }
}

proc add_task (; ...taskparts) {
  call TASKARR->append(taskparts)
}

proc add_tasks (component, ...tasks) {
  if (component in ComponentVariants) {
    for var in (ComponentVariants[component]) {
      for task in (tasks) {
        add_task (component, var, task)
      }
    }
  } else {
    for task in (tasks) {
      add_task (component, task)
    }
  }
}

proc standard_tasks (component) {
  add_tasks $component clean configure build install
}

proc add_testsuites (component, ...testsuites) {
  for testsuite in (testsuites) {
    if (component not in Testsuites) {
      setglobal Testsuites[component] = []
    }
    append $testsuite (Testsuites[component])
  }
}

# This isn't done yet, just playing with ideas.  Variants would be for build
# variants, e.g. asan & debug versions of libraries.  It's a bit awkward to
# retrofit that now.
proc add_variants(component, ...variants) {
  if (component not in ComponentVariants) {
    setglobal ComponentVariants[component] = []
  }
  for var in (variants) {
    append $var (ComponentVariants[component])
  }
}

func get_srcdir_rel (component) {
  var component_src = lookup_func("get_${component}_src")()
  return (component_src)
}

func get_srcdir (component) {
  var component_src = lookup_func("get_${component}_src")()
  return ("$SRCDIR/$component_src")
}

func get_version_name (component) {
  if (Sources[component].type === "subcomponent") {
    return (get_version_name (Sources[component].parent))
  } else {
    return (Sources[component].version_name)
  }
}

func get_objdir (component, variant=null) {
  try {
    var component_obj = lookup_func("get_${component}_obj")
    return (component_obj(variant))
  }
  var version_name = get_version_name (component)
  if (variant) {
    return ("$OBJDIR/$component-$variant-$version_name")
  } else {
    return ("$OBJDIR/$component-$version_name")
  }
}

func get_installdir (component, variant=null) {
  try {
    var getinstdir_fn = lookup_func("get_${component}_install")
    if (variant) {
      return (getinstdir_fn (INSTALLDIR, variant))
    } else {
      return (getinstdir_fn (INSTALLDIR))
    }
  }
  return ("$INSTALLDIR")
}

