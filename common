proc print_tasks {
  if (len(TASKARR) === 0) {
    error "No tasks!"
  }
  for i, task in (TASKARR) {
    printf u'%.3d: %s\n' $[i+1] $[task=>join('/')]
  }
}

func sanitize_path(path) {
  var parts=split(path, ':')
  var new_parts=[]
  var BrewBinDir=''
  try {
    var Brew=$(which brew)
    setvar BrewBinDir=$(dirname $Brew)
  }
  if (BrewBinDir === '') {
    return (path)
  } else {
    for part in (parts) {
      if ! test $part -ef $BrewBinDir {
        call new_parts->append(part)
      }
    }
    return (join(new_parts, ':'))
  }
}

proc fix_path {
  PATH=$[sanitize_path (ENV.PATH)] @ARGV
}

proc do_task_number (; num; standalone=null) {
  var taskidx = num-1
  var taskparts = [standalone] if standalone else TASKARR[taskidx]
  var taskfn
  var cfgvariant = null
  if (len(taskparts) === 1) {
    setvar taskfn = taskparts[0]
  } elif (len(taskparts) === 2) {
    # Call function "component_task"
    setvar taskfn = "$[taskparts[1]]_$[taskparts[0]]"
  } elif (len(taskparts) === 3) {
    # Call function "component_task (cfgvariant)"
    setvar taskfn = "$[taskparts[2]]_$[taskparts[0]]"
    setvar cfgvariant = taskparts[1]
  } else {
    error "Unexpected number of task parts ($[len(taskparts)])"
  }
  var logname=$(printf u'%.3d-%s.log' $num $[taskparts=>join('_')])
  var numtasks = len(TASKARR)
  setglobal CurrentLogFile="$LOGDIR/$logname"
  printf u'[%s] [%.3d/%.3d]: start %s\n' $(time_now) $num $numtasks $[taskparts=>join('/')]
  try {
    if (cfgvariant) {
      fix_path eval "$taskfn $cfgvariant" > $CurrentLogFile 2>&1
    } else {
      fix_path eval "$taskfn" > $CurrentLogFile 2>&1
    }
  }
  if (_status !== 0) {
    write "Task '$taskfn' failed. Current log file is $CurrentLogFile"
    write "Last 20 lines:"
    tail -n 20 $CurrentLogFile
    if (_error.code !== 0 and "message" in _error) {
      error "$[_error.message]"
    } else {
      exit 1
    }
  }
  printf u'[%s] [%.3d/%.3d]: finish %s\n' $(time_now) $num $numtasks $[taskparts=>join('/')]
}

proc do_tasks (; todo) {
  var task = -1
  # A "continue" with nothing before it continues from the start: leaving this
  # at -1 would index backwards from the end of TASKARR instead.
  var nexttask = 1
  var Range = / ^ <capture digit+ as start : int> '--' <capture digit+ as end : int> $ /
  if (len(todo) === 0) {
    setvar todo = ("1", "continue")
  }
  for t in (todo) {
    if (nexttask > len(TASKARR)) {
      true
    } elif (t ~ Range) {
      var starttask = _group('start')
      var endtask = _group('end')
      for i in (starttask ..= endtask) {
        do_task_number (i)
      }
      setvar nexttask = endtask+1
    } elif (t ~ /^ <capture digit+ as tasknum: int> $/) {
      setvar task = _group('tasknum')
      do_task_number (task)
      setvar nexttask = task+1
    } elif (t === "continue") {
      for i in (nexttask ..= len(TASKARR)) {
        do_task_number (i)
      }
      setvar nexttask = len(TASKARR)+1
    } elif (t === "list") {
      print_tasks
      exit 0
    } elif (t === "list-variants") {
      if (not VariantsEnabled) {
        error "This config doesn't support build variants"
      }
      print_variants
      exit 0
    } else {
      # Treat anything else like this:
      #   1. Brace-expand (so "{build,install}_llvm" can be written)
      #   2. Run tasks sequentially that glob-match the resulting list
      shopt -s noglob { var braceexp=@(eval "write -- $t") }
      for globname in (braceexp) {
        for tasknum in (1 ..= len(TASKARR)) {
          var taskname = TASKARR[tasknum - 1]=>join('/')
          if (taskname ~~ "*${globname}*") {
            do_task_number (tasknum)
            setvar nexttask = tasknum + 1
          }
        }
      }
    }
  }
}

func get_amd_gpus() {
  var LocalGPUs = []
  try {
    var RAE = $(which rocm_agent_enumerator)
  }
  if (_error.code !== 0) {
    setvar RAE = "$[get_rocm_root()]/bin/rocm_agent_enumerator"
    if ! test --exists $RAE {
      error "No rocm_agent_enumerator found"
