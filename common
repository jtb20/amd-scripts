  setglobal ConfigureOpts[comp].cfg = ConfigureOpts[comp].cfg ++ opts
}

# This does something quite different in the non-variant and variant case.
# In the non-variant case, it returns the configuration opts (set by the config)
# in the ConfigureOpts dict.  In the variant case, it calls a function
# <component>_variant_config(variant), again provided by the config.

func get_configure_opts(comp, variant=null) {
  if (variant) {
    var cfgvarfn = lookup_func("${comp}_variant_config")
    return (cfgvarfn(variant))
  } elif (comp in ConfigureOpts and 'cfg' in ConfigureOpts[comp]) {
    return (ConfigureOpts[comp].cfg)
  } else {
    return ([])
  }
}

# Read a key set with set_configure_key, or 'default' if the component or key
# has not been set.  Handy for modules whose dependencies or tasks depend on
# era-specific settings that most configs never mention.

func get_configure_key(comp, key, default=null) {
  if (comp in ConfigureOpts and key in ConfigureOpts[comp]) {
    return (ConfigureOpts[comp][key])
  }
  return (default)
}

# Use a particular host compiler for the whole build, e.g. an older GCC for
# historical configs whose sources predate the system compiler.  CMake picks
# CC/CXX up from the environment when a build directory is first configured
# (so run a component's 'clean' task after changing this), and autotools
# builds get them via autotools_ccache_option.  Components that are
# explicitly built with the new LLVM are unaffected.

var HostCC = 'gcc'
var HostCXX = 'g++'
var HostCompilerSet = false

proc set_host_compiler(;; cc, cxx) {
  if (not have_binary (cc) or not have_binary (cxx)) {
    error "This config needs the host compilers '$cc' and '$cxx', which aren't on PATH"
  }
  setglobal HostCompilerSet = true
  setglobal HostCC = cc
  setglobal HostCXX = cxx
  setglobal ENV.CC = cc
  setglobal ENV.CXX = cxx
}

# The major version of the host C++ compiler if it is GCC, or null if it is
# something else (clang defines __GNUC__ too, so check for that).  For
# modules whose sources need adjusting for newer GCCs.

func host_gcc_major() {
  var Major = null
  var Lines = $(echo | $HostCXX -dM -E -x c++ - 2>/dev/null)=>split(u'\n')
  for Line in (Lines) {
    if (Line=>startsWith('#define __clang__ ')) {
      return (null)
    } elif (Line=>startsWith('#define __GNUC__ ')) {
      setvar Major = int(Line=>replace('#define __GNUC__ ', ''))
    }
  }
  return (Major)
}

# For components built with the *new* clang: a --gcc-toolchain prefix that
# makes it use the set_host_compiler GCC's C++ library, rather than the newest
# GCC on the system (whose headers may be too new for old sources).  Clang
# picks the newest GCC under the prefix, so the prefix holds only that one.
# Returns null if no host compiler was set.  Call from add_config_adjustment
# blocks, so that it only runs in amd-build.

func host_gcc_toolchain() {
  if (not HostCompilerSet) {
    return (null)
  }
  var Dir = "$OBJDIR/host-gcc-toolchain"
  if ! test --dir "$Dir/lib/gcc" {
    var InstallDir = $(dirname $($HostCC -print-libgcc-file-name))
    var Version = $(basename $InstallDir)
    var Triple = $(basename $(dirname $InstallDir))
    var Prefix = $(realpath "$InstallDir/../../../..")
    mkdir -p "$Dir/lib/gcc/$Triple"
    ln -sfn $InstallDir "$Dir/lib/gcc/$Triple/$Version"
    ln -sfn "$Prefix/include" "$Dir/include"
  }
  return (Dir)
}

