func get_src_default(comp) {
  if (Sources[comp].type === "subcomponent") {
    var parent_src = get_srcdir_rel (Sources[comp].parent)
    return ("$parent_src/$[Sources[comp].subdir]")
  } else {
    var version_name = Sources[comp].version_name
    return ("${comp}-${version_name}")
  }
}

