proc elaborate_tasks() {
  var ordered_comp
  var add_task_fn
  if (CleanInstallDir) {
    add_task ('clean_install_dir')
  }
  {
    var CompWithDeps = {}
    for comp in (Components) {
      if (comp[0:3] !== 'ao_' and comp in Sources and 'deps' in Sources[comp]) {
        for dep in (Sources[comp].deps) {
          write -- "$dep $comp"
          setvar CompWithDeps[comp] = true
          setvar CompWithDeps[comp] = true
        }
      } else {
        var deps = lookup_func("${comp}_dependencies")()
        for dep in (deps) {
          write -- "$dep $comp"
          setvar CompWithDeps[comp] = true
          setvar CompWithDeps[dep] = true
        }
      }
      try {
        var cond_deps = lookup_func ("${comp}_conditional_deps")()
        for dep in (cond_deps) {
          write -- "$dep $comp"
          setvar CompWithDeps[comp] = true
          setvar CompWithDeps[dep] = true
        }
      }
      clear_error
    }
    for comp in (Components) {
      if (comp not in CompWithDeps) {
        # A special case, sort of -- components which don't depend on anything
        # and which nothing depends on are marked as depending on themselves.
        # That means that 'tsort' will include them in its output, albeit in
        # an arbitrary position.  That's fine.
        write -- "$comp $comp"
      }
    }
  } | tsort | while read ordered_comp {
    setvar add_task_fn = "${ordered_comp}_tasks"
    eval "$add_task_fn"
    # Each component's build variant tasks come straight after its own.
    if (VariantsEnabled) {
      add_variant_tasks $ordered_comp
    }
  }
}

proc elaborate_tests() {
  add_task ('clean_test_dirs')
  for comp in (Testsuites) {
    for testsuite in (Testsuites[comp]) {
      var testsuite_nodash = testsuite=>replace('-', '_')
      add_task ("test_${comp}_${testsuite_nodash}")
    }
  }
  add_task ('save_test_results')
}

