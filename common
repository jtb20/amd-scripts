# Unset variables apart from those in the whitelist.  Invoke like this:
#
# unset @(unset_varlist)
proc unset_varlist() {
  var current=$(env -0)=>trimEnd(b'\y00')=>split(b'\y00')
  var bashfunc = / 'BASH_FUNC_' .* /
  var kv = / <capture (w|'_')+ (alnum|'_')* as key> '=' <capture dot* as value> /
  var env_whitelist = :| _ PATH ENV HOME TERM LANG PWD OLDPWD USER LOGNAME SHELL
                         NAME SHLVL HOSTTYPE LINES COLUMNS
                         GCN_PLUGIN_IMPL GCN_DEBUG GOMP_DEBUG |
  if (HostCompilerSet) {
    # Set by the config via set_host_compiler, not inherited from the caller.
    setvar env_whitelist = env_whitelist ++ :| CC CXX |
  }
  if (ToolsRoot and NoBWrap) {
    # Inside a -T sandbox: set by do_bwrap, not inherited from the caller.
    setvar env_whitelist = env_whitelist ++ :| CCACHE_DIR |
  }

  for x in (current) {
    if (x ~ bashfunc) {
      true
    } elif (x ~ kv) {
      var Key = _group('key')
      if (env_whitelist=>indexOf(Key) < 0) {
        write -- $Key
      }
    } else {
      error "Unexpected environment var setting: $x"
    }
  }
}

# This is meant to be used with 'Bernstein chaining', i.e. as a prefix to
# another command, i.e.:
#
# rocm_env cmake_build my_component
#
# or,
#
# rocm_env --system cmake_build my_component
#
# To use the system's installed version of ROCm (with a new LLVM build, e.g.
# for testing mainline builds).  You need to use the -B/--no-bwrap option if
# you want to access the system's /opt/rocm.

# The root of the ROCm stack under test: HIP, rocm_agent_enumerator and friends
# live here, with the compiler in a subdirectory named by append_install_dir.
# Normally that is what we installed locally, but --aomp points at a toolchain
# installed elsewhere, which brings its own ROCm along with it while the local
# install directory stays empty.  --aomp names the compiler directory, so walk
# back up to the tree containing it.
func get_rocm_root() {
  if (not PreinstalledAOMP) {
    return (INSTALLDIR)
  }
  var Suffix = ''
  if ('llvm' in ConfigureOpts and
      'append_install_dir' in ConfigureOpts.llvm and
      ConfigureOpts.llvm.append_install_dir) {
    setvar Suffix = "/$[ConfigureOpts.llvm.append_install_dir]"
  }
  if (Suffix and PreinstalledAOMP=>endsWith(Suffix)) {
    return (PreinstalledAOMP=>trimEnd(Suffix))
  }
  # A flat installation, or one laid out some other way: take it as it stands.
  return (PreinstalledAOMP)
}

proc rocm_env {
  var LLVM_Inst = get_installdir('llvm')
  if (ARGV[0] === '--system') {
    with-env LD_LIBRARY_PATH=$(prepend_path "$LLVM_Inst/lib" \
                                            "$LLVM_Inst/lib/x86_64-unknown-linux-gnu" \
                                            "/opt/rocm/lib/llvm/lib:/opt/rocm/lib" \
                                            LD_LIBRARY_PATH) \
             HIP_CLANG_PATH=$INSTALLDIR/bin \
             ROCM_PATH=/opt/rocm \
             HIP_PATH=/opt/rocm \
             LLVM_PATH=$LLVM_Inst \
             AOMP=$LLVM_Inst \
             PATH=$(prepend_path $LLVM_Inst/bin PATH) {
      @[ARGV[1:]]
    }
  } else {
    var ROCm = get_rocm_root ()
    with-env LD_LIBRARY_PATH=$(prepend_path "$ROCm/lib" \
                                            "$LLVM_Inst/lib" \
                                            "$LLVM_Inst/lib/x86_64-unknown-linux-gnu" \
                                            LD_LIBRARY_PATH) \
             HIP_CLANG_PATH=$LLVM_Inst/bin \
             ROCM_PATH=$ROCm \
             HIP_PATH=$ROCm \
             LLVM_PATH=$LLVM_Inst \
             AOMP=$LLVM_Inst \
             PATH=$(prepend_path $LLVM_Inst/bin $ROCm/bin PATH) {
      @ARGV
    }
  }
}

proc install_path {
  PATH=$(prepend_path $INSTALLDIR/bin PATH) @ARGV
}

# This proc is meant to be used with Bernstein chaining too.  "Hide" git, i.e.
# by symlinking it to /bin/true so it doesn't do anything (successfully).
# This could be done in do_bwrap, but we don't want to unconditionally
# depend on that, I don't think.
# Call like:
# hide_git $TMPBIN other_command command_args [...]

proc hide_git {
  var TMPDIR=ARGV[0]
  mkdir -p $TMPDIR
  ln -sf $(which true) $TMPDIR/git
  PATH=$TMPDIR:$[ENV.PATH] @[ARGV[1:]]
}

proc gpu_opts {
  if (GPURunOpts !== [] or GPUOffset or GPUDevices !== []) {
    var LocalEnv = []
    if (GPUOffset) {
      append "GPURUN_DEVICE_BIAS=$GPUOffset" (LocalEnv)
    }
    if (GPUDevices !== []) {
      append "ROCR_VISIBLE_DEVICES=$[GPUDevices=>join(',')]" (LocalEnv)
    }
    append "AOMP=$INSTALLDIR" (LocalEnv)
    with-env @LocalEnv {
      $INSTALLDIR/bin/gpurun @GPURunOpts @ARGV
    }
  } else {
    @ARGV
  }
}

func get_ccache_cache_dir() {
  var QueryPattern = / .* 'cache_dir = ' <capture .* as dirname> /
  try > /dev/null {
    which ccache
  }
  if (_error.code !== 0) {
    return (null)
  }
  try > /dev/null {
    var All = @(ccache --show-config)
    for Line in (All) {
      if (Line ~ QueryPattern) {
        return (_group('dirname'))
      }
    }
  }
  if (_error.code !== 0) {
    error "Failed to find ccache cache dir"
  }
}

# Check if $Binary is from Homebrew -- by checking if the binary is in the
# same dir as the 'brew' binary.

func homebrew_bin_p(Binary) {
  try {
    var Brew = $(which brew)
    var BrewBinDir = $(dirname $Brew)
    var WhichBin = $(which $Binary)
    var BinDir = $(dirname $WhichBin)
    if test $BinDir -ef $BrewBinDir {
      return (true)
    }
  }
  return (false)
}

func find_homebrew_llvm_bin(Binary) {
  try {
    var BrewBin = $(which brew)
    var BrewDir = $(dirname $BrewBin)
    var OptDir = $(readlink -f "$BrewDir/../opt")
    cd $OptDir {
      var LLVMs = glob('llvm@*')
      var BiggestLLVM = $(write -- @LLVMs | sort -r -n -t '@' -k 2 | head -n 1)
      return ("$OptDir/$BiggestLLVM/bin/$Binary")
    }
  }
  return (null)
}

func homebrew_llvm_bin_p(Binary) {
  var FoundBin = find_homebrew_llvm_bin(Binary)
  if (FoundBin === null) {
    return (false)
  }
  if test --exists $FoundBin {
    return (true)
  } else {
    return (false)
  }
}

func homebrew_bind(Binary) {
  var WhichBin = $(which $Binary)
  var RealBinary = $(readlink -f $WhichBin)
  return (:| --bind $RealBinary /opt/homebrew/bin/$Binary |)
}

func homebrew_llvm_bind(Binary) {
  var FoundBin = find_homebrew_llvm_bin(Binary)
  var RealBinary = $(readlink -f $FoundBin)
  return (:| --bind $RealBinary /opt/homebrew/bin/$Binary |)
}

proc do_bwrap {
  var HideUsrLibCMake=[]
  var RealWD=$(readlink -f $WORKDIR)
  var CCacheDir=get_ccache_cache_dir ()

  if ! test --exists $CCacheDir {
    >&2 echo "CCache cache dir doesn't exist yet, creating"
    mkdir -p $CCacheDir
  }

  if (CCacheDir) {
    setvar CCacheDir=$(readlink -f $CCacheDir)
  }

  if test --exists /usr/lib/cmake {
    setvar HideUsrLibCMake=:| --tmpfs /usr/lib/cmake |
  }
  var CCacheDirOpt = []
  if (CCacheDir) {
    setvar CCacheDirOpt = :| --bind $CCacheDir $CCacheDir |
  }

  # This awkward little bit is because not all systems have bwrap/ccache
  # installed, but a full Homebrew installation interferes too much with builds
  # (i.e. it might include its own 'pkg-config' but we want to use the system
  # one instead).  Just pluck out the bits we need and hook them up inside the
  # tmpfs /opt mount.
  var HomebrewBinds = []
  if (BindHomebrew) {
    for Bin in bwrap ccache makeinfo ld.lld {
      if (homebrew_bin_p (Bin)) {
        setvar HomebrewBinds = HomebrewBinds ++ homebrew_bind (Bin)
      } elif (homebrew_llvm_bin_p (Bin)) {
        setvar HomebrewBinds = HomebrewBinds ++ homebrew_llvm_bind (Bin)
      }
    }
    setglobal ENV.PATH="/opt/homebrew/bin:$[ENV.PATH]"
  }

  var NetSharingOpt = []
  if (BwrapUnshareNet) {
    setvar NetSharingOpt = :| --unshare-net |
  } else {
    setvar NetSharingOpt = :| --share-net |
  }

  # The work directory is the only writable part of the filesystem by default,
  # so anything -s/-b/-i/-t/-l/-d moved out of it needs binding in explicitly.
  var DirBinds = []
  var BoundDirs = []
  for D in ([SRCDIR, OBJDIR, INSTALLDIR, TESTRESULTSDIR, LOGDIR, ARCHIVEDIR]) {
    if test --dir $D {
      var RealD = $(readlink -f $D)
      if (RealD !== RealWD and not RealD=>startsWith("$RealWD/")
          and not in_list (RealD, BoundDirs)) {
        setvar DirBinds = DirBinds ++ :| --bind $RealD $RealD |
        call BoundDirs->append(RealD)
      }
    }
  }

  # We bind the whole filesystem read-only, so a toolchain named with --aomp is
  # already visible wherever it happens to live.  The exception is /opt, which
  # we replace with a tmpfs to stop a system ROCm being picked up by accident,
  # and which would hide a toolchain someone has just explicitly asked for.
  # Bind that case back in, after the --tmpfs so it survives it; bwrap applies
  # these in order.
  #
  # Only that case: binding a path we did not have to would mean asking bwrap
  # to create the destination, which it cannot do through a symlinked parent.
  var AOMPBind = []
  if (PreinstalledAOMP) {
    # Bind the whole tree rather than just the compiler directory inside it:
    # HIP and rocm_agent_enumerator are at the root.
    var AOMPRoot = get_rocm_root ()
    var RealAOMP = $(readlink -f $AOMPRoot)
    if (AOMPRoot=>startsWith('/opt/') or RealAOMP=>startsWith('/opt/')) {
      setvar AOMPBind = :| --ro-bind $RealAOMP $RealAOMP |
      # /opt/rocm is normally a symlink to a versioned directory, and neither
      # name survives the tmpfs, so make the requested one work too.
      if (RealAOMP !== AOMPRoot) {
        setvar AOMPBind = AOMPBind ++ :| --ro-bind $RealAOMP $AOMPRoot |
      }
    }
  }

  var HostSpecificOpts = []
  if test --exists $[ENV.HOME]/.config/amd-scripts/bwrap-opts {
    setvar HostSpecificOpts = $(cat $[ENV.HOME]/.config/amd-scripts/bwrap-opts)=>shSplit()
  }

  if (ToolsRoot) {
    # A root filesystem from build-toolsroot (or any similar one): its
    # programs and libraries replace the host's entirely.
    var TR = $(readlink -f $ToolsRoot)
    if ! test --dir "$TR/usr/bin" {
      error "--toolsroot $ToolsRoot doesn't look like a root filesystem (no usr/bin)"
    }

    # /bin, /lib etc. are directories in older releases and symlinks into
    # /usr in merged-/usr ones.
    var RootDirOpts = []
    for D in bin sbin lib lib32 lib64 libx32 {
      if test -L "$TR/$D" {
        setvar RootDirOpts = RootDirOpts ++ :| --symlink $(readlink "$TR/$D") /$D |
      } elif test --dir "$TR/$D" {
        setvar RootDirOpts = RootDirOpts ++ :| --ro-bind "$TR/$D" /$D |
      }
    }

    # The toolsroot's own /etc, so that the dynamic linker cache, alternatives
    # and so on match its libraries, but the host's idea of users and the
    # network.
    var EtcOpts = :| --ro-bind "$TR/etc" /etc |
    for F in passwd group hosts resolv.conf {
      if test --exists "/etc/$F" && test --exists "$TR/etc/$F" {
        setvar EtcOpts = EtcOpts ++ :| --ro-bind /etc/$F /etc/$F |
      }
    }

    # rocm-dbgapi's cmake wants pci.ids.  build-toolsroot installs it; for an
    # older toolsroot without it, borrow the host's.
    var PCIIdsOpt = []
    if ! test --exists "$TR/usr/share/misc/pci.ids" && test --dir "$TR/usr/share/misc" {
      if test --exists /usr/share/misc/pci.ids {
        setvar PCIIdsOpt = :| --ro-bind /usr/share/misc /usr/share/misc |
      } elif test --exists /usr/share/hwdata/pci.ids {
        setvar PCIIdsOpt = :| --ro-bind /usr/share/hwdata /usr/share/misc |
      }
    }

    # Nothing outside the binds below exists in the sandbox, including the
    # scripts themselves (unless they happen to be in $HOME or the work
    # directory) and any symlinked path to them or to the work directory.  So
    # bind the scripts in, and use real paths for them and the directory to
    # start in.
    var RealScriptDir = $(readlink -f $SCRIPTDIR)
    var Cmd = [$(readlink -f $[ARGV[0]])] ++ ARGV[1:]

    # The same goes for the ccache cache directory, which is bound in under
    # its real path, but which the toolsroot's ccache may look for through a
    # symlink (like ~/.ccache).  Tell it where the cache is.
    var CCacheEnvOpt = []
    if (CCacheDir) {
      setvar CCacheEnvOpt = :| --setenv CCACHE_DIR $CCacheDir |
    }

    # The host's PATH could find host programs first (like a ysh built against
    # the host's newer glibc, through $HOME), so use the toolsroot's.
    bwrap --tmpfs / \
          --bind /tmp /tmp \
          @BwrapExtraOpts \
          @CCacheDirOpt \
          --bind $[ENV.HOME] $[ENV.HOME] \
          --ro-bind $RealScriptDir $RealScriptDir \
          --bind $RealWD $RealWD \
          @DirBinds \
          --tmpfs /opt \
          @AOMPBind \
          --dev /dev \
          --dev-bind /dev/kfd /dev/kfd \
          --dev-bind /dev/dri /dev/dri \
          --proc /proc \
          --bind /run /run \
          --ro-bind "$TR/usr" /usr \
          @RootDirOpts \
          @EtcOpts \
          @PCIIdsOpt \
          --unshare-pid \
          @NetSharingOpt \
          @HostSpecificOpts \
          --setenv PATH /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
          @CCacheEnvOpt \
          --chdir $RealWD \
          --die-with-parent \
          @Cmd
  } else {
    # The .parallel bind is needed for smoke tests (GNU Parallel) to work.
    bwrap --ro-bind / / \
          --bind $[ENV.HOME]/.parallel $[ENV.HOME]/.parallel \
          --bind /tmp /tmp \
          @BwrapExtraOpts \
          @CCacheDirOpt \
          --bind $RealWD $RealWD \
          @DirBinds \
          --bind /run/user /run/user \
          --tmpfs /opt \
          --dir /opt/homebrew \
          --dir /opt/homebrew/bin \
          @AOMPBind \
          @HideUsrLibCMake \
          @HomebrewBinds \
          --dev /dev \
          --dev-bind /dev/kfd /dev/kfd \
          --dev-bind /dev/dri /dev/dri \
          --proc /proc \
          --unshare-pid \
          @NetSharingOpt \
          @HostSpecificOpts \
          --die-with-parent \
          @ARGV
  }
}

