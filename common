var WORKDIR="$(pwd)"

var SRCDIR="$WORKDIR/src"
var SCRIPTDIR="$_this_dir"
var LOGDIR="$WORKDIR/logs"
var OBJDIR="$WORKDIR/obj"
var INSTALLDIR="$WORKDIR/install"
var ARCHIVEDIR="$WORKDIR/archives"
var CONFIGDIR="$SCRIPTDIR/configs"

var ActiveCfg
var Sources={}
var Components=[]
var ConfigureOpts={}
var DefaultBuildOpts={}
var BuildOpts={}
const DefaultParallelism=32

proc show_vars {
  write "HIP_CLANG_PATH: $HIP_CLANG_PATH"
  write "ROCM_PATH: $ROCM_PATH"
  write "HIP_PATH: $HIP_PATH"
  write "LLVM_PATH: $LLVM_PATH"
  write "PATH: $PATH"
}

proc maybe_mkdir (where) {
  if ! test --dir $where {
    mkdir -p $where
  }
}

func dir_empty (where) {
  cd $where {
    # shopt "dotglob" appears to be unimplemented. This'll do.
    var files=glob("*")++glob(".*")
    return (len(files) === 2)
  }
}

func lookup_func(name) {
  try {
    # It seems like evalExpr "..." might be better here somehow, but it doesn't
    # seem to work like that (yet?)
    eval "var fn = $name" 2> /dev/null
  }
  if (_status === 0 and type(fn) === "Func") {
    return (fn)
  } else {
    error "Not a function: $name"
  }
}

proc time_now {
  date +"%H:%M:%S"
}

func in_list(item, inlist) {
  return (inlist=>indexOf(item) >= 0)
}

proc parse_args(; argv) {
  var spec
  var tasks
  parser (&spec) {
    arg cfg (help='Build configuration file')
    rest tasks
  }
  var args = parseArgs (spec, argv)
  setglobal ActiveCfg = args.cfg
  setglobal TASKLIST = args.tasks
}

proc add_sources(; component, opts) {
  if (component in Sources) {
    error "Attempt to add component $component twice"
  }
  setglobal Sources[component] = opts
}

proc add_components(...components) {
  for comp in (components) {
    if (not in_list (comp, Components)) {
      var deps = lookup_func("${comp}_dependencies")()
      add_components @deps
      append $comp (Components)
    }
  }
}

proc add_task (name) {
  append $name (TASKARR)
}

proc add_tasks (component, ...tasks) {
  for task in (tasks) {
    add_task "${task}_${component}"
  }
}

proc standard_tasks (component) {
  add_tasks $component clean configure build install
}

func get_srcdir_rel (component) {
  var component_src = lookup_func("get_${component}_src")()
  return (component_src)
}

func get_srcdir (component) {
  var component_src = lookup_func("get_${component}_src")()
  return ("$SRCDIR/$component_src")
}

func get_version_name (component) {
  if (Sources[component].type === "subcomponent") {
    return (get_version_name (Sources[component].parent))
  } else {
    return (Sources[component].version_name)
  }
}

func get_objdir (component) {
  var version_name = get_version_name (component)
  return ("$OBJDIR/$component-$version_name")
}

func get_installdir (component) {
  return ("$INSTALLDIR/$component")
}

proc set_configure_opts(; comp, opts) {
  if (comp not in ConfigureOpts) {
    setglobal ConfigureOpts[comp] = {}
  }
  setglobal ConfigureOpts[comp].cfg = opts
}

proc set_configure_key(; comp, key, opts) {
  if (comp not in ConfigureOpts) {
    setglobal ConfigureOpts[comp] = {}
  }
  setglobal ConfigureOpts[comp][key] = opts
}

proc set_target(; comp, tgt) {
  set_configure_key (comp, "target", tgt)
}

proc set_host(; comp, tgt) {
  set_configure_key (comp, "host", tgt)
}

proc set_build(; comp, tgt) {
  set_configure_key (comp, "build", tgt)
}

proc append_configure_opts(; comp, opts) {
  setglobal ConfigureOpts[comp].cfg = ConfigureOpts[comp].cfg ++ opts
}

proc set_build_key(; comp, key, value) {
  if (comp not in BuildOpts) {
    setglobal BuildOpts[comp] = {}
  }
  setglobal BuildOpts[comp][key] = value
}

proc set_build_tool(; comp, tool) {
  set_build_key (comp, "tool", tool)
}

proc set_build_ccache(; comp, use_ccache) {
  set_build_key (comp, "ccache", use_ccache)
}

proc set_build_type(; comp, build_type) {
  set_build_key (comp, "build_type", build_type)
}

proc set_build_parallelism(; comp, procs) {
  set_build_key (comp, "parallelism", procs)
}

proc load_config {
  if test --exists "$CONFIGDIR/$ActiveCfg" {
    source $CONFIGDIR/$ActiveCfg
  } elif (ActiveCfg !== null) {
    error "No such config: $ActiveCfg"
  }
}

proc elaborate_tasks {
  var ordered_comp
  for comp in (Components) {
    var deps = lookup_func("${comp}_dependencies")()
    for dep in (deps) {
      write -- "$dep $comp"
    }
  } | tsort | while read ordered_comp {
    var add_task_fn = "${ordered_comp}_tasks"
    eval "$add_task_fn"
  }
}

var DefaultBuildOpts = {
  "tool" : "Ninja",
  "ccache" : true,
  "build_type" : "Release"
  "parallelism" : null
}

func get_tool_opt(comp, option) {
  if (comp in BuildOpts and option in BuildOpts[comp]) {
    return (BuildOpts[comp][option])
  } else {
    return (DefaultBuildOpts[option])
  }
}

func get_build_tool(comp) {
  return (get_tool_opt (comp, "tool"))
}

func get_build_ccache(comp) {
  return (get_tool_opt (comp, "ccache"))
}

func get_build_type(comp) {
  return (get_tool_opt (comp, "build_type"))
}

func get_build_parallelism(comp) {
  return (get_tool_opt (comp, "parallelism"))
}

func cmake_ccache_option(comp) {
  if (get_build_ccache(comp)) {
    try {
      var ccache_bin = $(which ccache)
    }
    if (_status === 0) {
      return (:| -DCMAKE_C_COMPILER_LAUNCHER=$ccache_bin
                 -DCMAKE_CXX_COMPILER_LAUNCHER=$ccache_bin |)
    } else {
      error "No ccache binary in PATH"
    }
  } else {
    return ([])
  }
}

func autotools_ccache_option(comp) {
  if (get_build_ccache(comp)) {
    try {
      var ccache_bin = $(which ccache)
    }
    if (_status === 0) {
      return (:| CC="$ccache_bin gcc" CXX="$ccache_bin g++" |)
    } else {
      error "No ccache binary in PATH"
    }
  } else {
    return ([])
  }
}

