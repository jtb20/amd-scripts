#!/usr/bin/env ysh

var WORKDIR="$(pwd)"

var SRCDIR="$WORKDIR/src"
var SCRIPTDIR="$_this_dir"
var LOGDIR="$WORKDIR/logs"
var OBJDIR="$WORKDIR/obj"
var INSTALLDIR="$WORKDIR/install"
var ARCHIVEDIR="$WORKDIR/archives"
var TESTRESULTSDIR="$WORKDIR/testresults"
var CONFIGDIR="$SCRIPTDIR/configs"

var ActiveCfg
var Sources={}
var Components=[]
var Testsuites={}
var SelectTests=null
var ConfigureOpts={}
var DefaultBuildOpts={}
var BuildOpts={}
const DefaultParallelism=32
var GithubUsername=""
var OptionalModules=[]
var CleanInstallDir=false
var TASKLIST=[]
var TASKARR=()

proc show_vars {
  write "HIP_CLANG_PATH: $HIP_CLANG_PATH"
  write "ROCM_PATH: $ROCM_PATH"
  write "HIP_PATH: $HIP_PATH"
  write "LLVM_PATH: $LLVM_PATH"
  write "PATH: $PATH"
}

proc maybe_mkdir (where) {
  if ! test --dir $where {
    mkdir -p $where
  }
}

func dir_empty (where) {
  cd $where {
    # shopt "dotglob" appears to be unimplemented. This'll do.
    var files=glob("*")++glob(".*")
    return (len(files) === 2)
  }
}

proc copy_dir (Src, Dest) {
  write "Copying directory $Src to $Dest..."
  if test --dir $Dest {
    rm -rf -- $Dest
  }
  if test --exists $Dest {
    error "$Dest exists and is not a directory, stopping"
  }
  mkdir -p $(dirname $Dest)
  cp -a $Src $Dest
}

func lookup_func(name) {
  var fn = getVar(name)
  if (type(fn) === "Func") {
    return (fn)
  } else {
    error "Not a function: $name"
  }
}

proc time_now {
  date +"%H:%M:%S"
}

func in_list(item, inlist) {
  return (inlist=>indexOf(item) >= 0)
}

func has_proc (procname) {
  var t = null
  try > /dev/null 2>&1 {
    setvar t = "$(type -t $procname)"
  }
  return (_status === 0 and t === 'function')
}

proc clear_error () {
  setglobal _error.message = null
  setglobal _error.status = 0
}

proc parse_args(; argv) {
  var spec
  var tasks
  var argc = len(argv)
  var opt = 0
  var positional = 0
  var args = {}
  var cfg
  while (opt < argc) {
    case (argv[opt]) {
      --ghuser {
        setvar opt += 1
        setglobal GithubUsername = argv[opt]
      }

      -g | --debug {
        setglobal DefaultBuildOpts.build_type = "Debug"
      }

      -S | --select {
        setvar opt += 1
        setglobal SelectTests = argv[opt]
      }

      -A | --add {
        setvar opt += 1
        setglobal OptionalModules = OptionalModules ++ split(argv[opt], ',')
      }

      -C | --clean {
        setglobal CleanInstallDir = true
      }

      -* {
        error "Unknown option: $[argv[opt]]"
      }

      * {
        if (positional === 0) {
          setglobal ActiveCfg = argv[opt]
          setvar positional += 1
        } else {
          setglobal TASKLIST = argv[opt:]
          setvar opt = argc
        }
      }
    }
    setvar opt += 1
  }
  # This is a nice ysh feature, but it's not fully baked yet...
  #parser (&spec) {
  #  flag -u --ghuser ('str', default="", help="GitHub username")
  #  arg cfg (help='Build configuration file')
  #  rest tasks
  #}
  #var args = parseArgs (spec, argv)
  #setglobal ActiveCfg = args.cfg
  #setglobal TASKLIST = args.tasks
  #setglobal GithubUsername = args.ghuser
  if (ActiveCfg === null) {
    error "Please specify a config file (from configs/*.cfg)"
  }
}

proc add_sources(; component, opts) {
  if (component in Sources) {
    error "Attempt to add component $component twice"
  }
  setglobal Sources[component] = opts
}

proc add_components(...components) {
  for comp in (components) {
    if (not in_list (comp, Components)) {
      var deps = lookup_func("${comp}_dependencies")()
      add_components @deps
      try {
        var cond_deps = lookup_func ("${comp}_conditional_deps")()
        add_components @cond_deps
      }
      # Wipe 'sticky' errors from failed lookup_func above.
      clear_error
      append $comp (Components)
      if (has_proc ("default_configure_opts_${comp}")) {
        # If we have a "default_configure_opts_${comp}" procedure for the
        # module, invoke it now.  Configuration files can then append their
        # own options, etc. as necessary.
        eval "default_configure_opts_${comp}"
      }
    }
  }
}

proc add_task (name) {
  append $name (TASKARR)
}

proc add_tasks (component, ...tasks) {
  for task in (tasks) {
    add_task "${task}_${component}"
  }
}

proc standard_tasks (component) {
  add_tasks $component clean configure build install
}

proc add_testsuites (component, ...testsuites) {
  for testsuite in (testsuites) {
    if (component not in Testsuites) {
      setglobal Testsuites[component] = []
    }
    append $testsuite (Testsuites[component])
  }
}

func get_srcdir_rel (component) {
  var component_src = lookup_func("get_${component}_src")()
  return (component_src)
}

func get_srcdir (component) {
  var component_src = lookup_func("get_${component}_src")()
  return ("$SRCDIR/$component_src")
}

func get_version_name (component) {
  if (Sources[component].type === "subcomponent") {
    return (get_version_name (Sources[component].parent))
  } else {
    return (Sources[component].version_name)
  }
}

func get_objdir (component) {
  var version_name = get_version_name (component)
  return ("$OBJDIR/$component-$version_name")
}

func get_installdir (component) {
  return ("$INSTALLDIR/$component")
}

proc set_configure_opts(; comp, opts) {
  if (comp not in ConfigureOpts) {
    setglobal ConfigureOpts[comp] = {}
  }
  setglobal ConfigureOpts[comp].cfg = opts
}

proc set_configure_key(; comp, key, opts) {
  if (comp not in ConfigureOpts) {
    setglobal ConfigureOpts[comp] = {}
  }
  setglobal ConfigureOpts[comp][key] = opts
}

proc set_target(; comp, tgt) {
  set_configure_key (comp, "target", tgt)
}

proc set_host(; comp, tgt) {
  set_configure_key (comp, "host", tgt)
}

proc set_build(; comp, tgt) {
  set_configure_key (comp, "build", tgt)
}

proc append_configure_opts(; comp, opts) {
  setglobal ConfigureOpts[comp].cfg = ConfigureOpts[comp].cfg ++ opts
}

proc set_build_key(; comp, key, value) {
  if (comp not in BuildOpts) {
    setglobal BuildOpts[comp] = {}
  }
  setglobal BuildOpts[comp][key] = value
}

proc set_build_tool(; comp, tool) {
  set_build_key (comp, "tool", tool)
}

proc set_build_ccache(; comp, use_ccache) {
  set_build_key (comp, "ccache", use_ccache)
}

proc set_build_type(; comp, build_type) {
  set_build_key (comp, "build_type", build_type)
}

proc set_build_parallelism(; comp, procs) {
  set_build_key (comp, "parallelism", procs)
}

# We want to source configs at the top level so we can define funcs and procs
# in them.  "Call" this with eval, i.e. 'eval (load_config)'.
var load_config = ^(
  if test --exists "$CONFIGDIR/$ActiveCfg" {
    source $CONFIGDIR/$ActiveCfg
  } elif (ActiveCfg !== null) {
    error "No such config: $ActiveCfg"
  }
)

proc elaborate_tasks() {
  var ordered_comp
  var add_task_fn
  if (CleanInstallDir) {
    add_task clean_install_dir
  }
  {
    var CompWithDeps = {}
    for comp in (Components) {
      var deps = lookup_func("${comp}_dependencies")()
      for dep in (deps) {
        write -- "$dep $comp"
        setvar CompWithDeps[comp] = true
        setvar CompWithDeps[dep] = true
      }
      try {
        var cond_deps = lookup_func ("${comp}_conditional_deps")()
        for dep in (cond_deps) {
          write -- "$dep $comp"
          setvar CompWithDeps[comp] = true
          setvar CompWithDeps[dep] = true
        }
      }
      clear_error
    }
    for comp in (Components) {
      if (comp not in CompWithDeps) {
        # A special case, sort of -- components which don't depend on anything
        # and which nothing depends on are marked as depending on themselves.
        # That means that 'tsort' will include them in its output, albeit in
        # an arbitrary postion.  That's fine.
        write -- "$comp $comp"
      }
    }
  } | tsort | while read ordered_comp {
    setvar add_task_fn = "${ordered_comp}_tasks"
    eval "$add_task_fn"
  }
}

proc elaborate_tests() {
  add_task clean_test_dirs
  for comp in (Testsuites) {
    for testsuite in (Testsuites[comp]) {
      var testsuite_nodash = testsuite->replace('-', '_')
      add_task test_${comp}_${testsuite_nodash}
    }
  }
  add_task save_test_results
}

var DefaultBuildOpts = {
  "tool" : "Ninja",
  "ccache" : true,
  "build_type" : "Release"
  "parallelism" : null
}

func get_tool_opt(comp, option) {
  if (comp in BuildOpts and option in BuildOpts[comp]) {
    return (BuildOpts[comp][option])
  } else {
    return (DefaultBuildOpts[option])
  }
}

func get_build_tool(comp) {
  return (get_tool_opt (comp, "tool"))
}

func get_build_ccache(comp) {
  return (get_tool_opt (comp, "ccache"))
}

func get_build_type(comp) {
  return (get_tool_opt (comp, "build_type"))
}

func get_build_parallelism(comp) {
  return (get_tool_opt (comp, "parallelism"))
}

func get_src_default(comp) {
  if (Sources[comp].type === "subcomponent") {
    var parent_src = get_srcdir_rel (Sources[comp].parent)
    return ("$parent_src/$[Sources[comp].subdir]")
  } else {
    var version_name = Sources[comp].version_name
    return ("${comp}-${version_name}")
  }
}

func cmake_ccache_option(comp) {
  if (get_build_ccache(comp)) {
    try {
      var ccache_bin = $(which ccache)
    }
    if (_status === 0) {
      return (:| -DCMAKE_C_COMPILER_LAUNCHER=$ccache_bin
                 -DCMAKE_CXX_COMPILER_LAUNCHER=$ccache_bin |)
    } else {
      error "No ccache binary in PATH"
    }
  } else {
    return ([])
  }
}

func autotools_ccache_option(comp) {
  if (get_build_ccache(comp)) {
    try {
      var ccache_bin = $(which ccache)
    }
    if (_status === 0) {
      return (:| CC="$ccache_bin gcc" CXX="$ccache_bin g++" |)
    } else {
      error "No ccache binary in PATH"
    }
  } else {
    return ([])
  }
}

proc print_tasks {
  if (len(TASKARR) === 0) {
    error "No tasks!"
  }
  for i, task in (TASKARR) {
    printf u'%.3d: %s\n' $[i+1] $task
  }
}

func sanitize_path(path) {
  var parts=split(path, ':')
  var new_parts=[]
  for part in (parts) {
    if (part !~ "/homebrew/") {
      call new_parts->append(part)
    }
  }
  return (join(new_parts, ':'))
}

proc do_task_number (; num) {
  var taskidx = num-1
  var taskfn = TASKARR[taskidx]
  var logname=$(printf u'%.3d-%s.log' $num $taskfn)
  var numtasks = len(TASKARR)
  setglobal CurrentLogFile="$LOGDIR/$logname"
  printf u'[%s] [%.3d/%.3d]: start %s\n' $(time_now) $num $numtasks $taskfn
  try {
    PATH=$[sanitize_path (PATH)] eval "$taskfn" > $CurrentLogFile 2>&1
  }
  if (_status !== 0) {
    write "Task '$taskfn' failed. Current log file is $CurrentLogFile"
    write "Last 20 lines:"
    tail -n 20 $CurrentLogFile
    if (_error.status !== 0 and "message" in _error) {
      error "$[_error.message]"
    } else {
      exit 1
    }
  }
  printf u'[%s] [%.3d/%.3d]: finish %s\n' $(time_now) $num $numtasks $taskfn
}

proc do_tasks (; todo) {
  var task = -1
  var nexttask = -1
  var Range = / <capture digit+ as start : int> '--' <capture digit+ as end : int> /
  if (len(todo) === 0) {
    setvar todo = ("1", "continue")
  }
  for t in (todo) {
    if (nexttask > len(TASKARR)) {
      :
    } elif (t ~ Range) {
      var starttask = _group('start')
      var endtask = _group('end')
      for i in (starttask .. endtask+1) {
        do_task_number (i)
      }
      setvar nexttask = endtask+1
    } elif (t ~ /<capture digit+ as tasknum: int>/) {
      setvar task = _group('tasknum')
      do_task_number (task)
      setvar nexttask = task+1
    } elif (t === "continue") {
      for i in (nexttask .. len(TASKARR)+1) {
        do_task_number (i)
      }
      setvar nexttask = len(TASKARR)+1
    } elif (t === "list") {
      print_tasks
      exit 0
    } else {
      # Treat anything else like this:
      #   1. Brace-expand (so "{build,install}_llvm" can be written)
      #   2. Run tasks sequentially that glob-match the resulting list
      shopt -s noglob { var braceexp=@(eval "write -- $t") }
      for globname in (braceexp) {
        for tasknum in (1..len(TASKARR)+1) {
          var taskname = TASKARR[tasknum - 1]
          if (taskname ~~ "*${globname}*") {
            do_task_number (tasknum)
            setvar nexttask = tasknum + 1
          }
        }
      }
    }
  }
}

func get_amd_gpus() {
  var LocalGPUs = []
  var List = @(rocm_agent_enumerator 2> /dev/null)
  for GPU in (List) {
    if (GPU !== "gfx000") {
      call LocalGPUs->append(GPU)
    }
  }
  return (LocalGPUs)
}

proc clean_component (component) {
  var OBJDIR = get_objdir(component)
  if test --dir $OBJDIR {
    rm -rf $OBJDIR/*
  } else {
    mkdir -p $OBJDIR
  }
}

proc clean_install_dir () {
  if test --dir $INSTALLDIR {
    rm -rf $INSTALLDIR/*
  }
}

proc add_optional_modules() {
  if (len(OptionalModules) > 0 and not has_proc ("add_optional_module")) {
    error "Optional modules not supported for this config"
  }
  # We don't want to force configs to define the add_optional_module function
  # if they don't need it.  Try to avoid failing if we don't have it.
  try {
    for Mod in (OptionalModules) {
      add_optional_module $Mod
    }
  }
  if (_status !== 0 and _error.status !== 0 and "message" in _error) {
    error "$[_error.message]"
  }
}

