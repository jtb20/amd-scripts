#!/bin/bash

set -e

usage() {
  cat <<EOF
Usage: setup_prereq
Download and build the YSH interpreter (oils-for-unix) the other scripts need,
and GNU readline if the system has no usable one.

Environment:
  DOWNLOAD   where tarballs are fetched (default: \$HOME/downloads)
  PREFIX     install prefix (default: \$HOME/prefix)
  BUILD      scratch build directory (default: \$HOME/build-oil)

  -h, --help   show this help and exit

Full documentation: $(dirname "$(readlink -f "$0")")/README.md ("Setup")
EOF
}

case "${1-}" in
  -h|--help) usage; exit 0 ;;
  "") ;;
  *) usage >&2; exit 1 ;;
esac

DOWNLOAD="${DOWNLOAD:-$HOME/downloads}"
PREFIX="${PREFIX:-$HOME/prefix}"
BUILD="${BUILD:-$HOME/build-oil}"

DOWNLOAD="$(readlink -f "$DOWNLOAD")"
PREFIX="$(readlink -f "$PREFIX")"
BUILD="$(readlink -f "$BUILD")"

OIL_TARBALL="oils-for-unix-0.37.0.tar.gz"
OIL_URL="https://oils.pub/download/$OIL_TARBALL"

READLINE_TARBALL="readline-8.2.tar.gz"
# ftpmirror.gnu.org redirects to a working mirror; ftp.gnu.org itself is not
# reachable from some networks, over either http or https.
READLINE_URL="https://ftpmirror.gnu.org/readline/$READLINE_TARBALL"

if ! [ "$DOWNLOAD" ] || ! [ "$PREFIX" ] || ! [ "$BUILD" ]; then
  echo "Empty DOWNLOAD/PREFIX/BUILD, please fix."
fi


mkdir -p "$DOWNLOAD"
mkdir -p "$PREFIX"
mkdir -p "$BUILD"

check_sys_readline() {
  local BUILD="$1"
  pushd "$BUILD" >& /dev/null
  cat > dummy.c << EOF
int main(void) { return 0; }
EOF
  if gcc dummy.c -lreadline -o dummy >& /dev/null; then
    echo "system"
  else
    echo "ours"
  fi
  popd >& /dev/null
}

# readline's shared library needs a terminfo library for tgetent(), tputs()
# and friends, but its build does not link one in by default.  Without this,
# oils' ./configure cannot link its readline probe, and you silently get a
# shell with no interactive editing or history.
check_curses_lib() {
  local BUILD="$1"
  pushd "$BUILD" >& /dev/null
  cat > dummy_curses.c << EOF
int main(void) { return 0; }
EOF
  local lib
  for lib in tinfo ncurses curses; do
    if gcc dummy_curses.c "-l$lib" -o dummy_curses >& /dev/null; then
      echo "-l$lib"
      break
    fi
  done
  popd >& /dev/null
}

download() {
  local DOWNLOAD="$1"
  local URL="$2"
  local TARBALL="$3"
  if [ ! -e "$DOWNLOAD/$TARBALL" ]; then
    if type wget; then
      pushd "$DOWNLOAD"
      wget "$URL"
      popd
    elif type curl; then
      pushd "$DOWNLOAD"
      curl -O "$URL"
      popd
    else
      echo "No wget or curl!"
      exit 1
    fi
  fi
}

WHICH_READLINE="$(check_sys_readline "$BUILD")"

echo "Using readline: $WHICH_READLINE"

if [ "$WHICH_READLINE" = "ours" ]; then
  CURSES_LIB="$(check_curses_lib "$BUILD")"
  if [ -z "$CURSES_LIB" ]; then
    echo "No terminfo/curses library found; readline will lack line editing."
  else
    echo "Using curses library: $CURSES_LIB"
  fi
fi

download "$DOWNLOAD" "$OIL_URL" "$OIL_TARBALL"
if [ "$WHICH_READLINE" = "ours" ]; then
  download "$DOWNLOAD" "$READLINE_URL" "$READLINE_TARBALL"
fi

mkdir -p "$BUILD"

pushd "$BUILD"

if [ "$WHICH_READLINE" = "ours" ]; then
  tar fxz "$DOWNLOAD/$READLINE_TARBALL"
  pushd "$(basename "$READLINE_TARBALL" .tar.gz)"
  ./configure --prefix="$PREFIX" --with-curses
  make -j8 SHLIB_LIBS="$CURSES_LIB"
  make -j8 install SHLIB_LIBS="$CURSES_LIB"
  popd
fi

tar fxz "$DOWNLOAD/$OIL_TARBALL"
pushd "$(basename "$OIL_TARBALL" .tar.gz)"
if [ "$WHICH_READLINE" = "ours" ]; then
  ./configure --prefix="$PREFIX" --readline="$PREFIX"
else
  ./configure --prefix="$PREFIX" --with-readline
fi
_build/oils.sh
./install
popd
popd

echo "-- please add $PREFIX/bin to your PATH:"
echo "echo 'PATH=\"$PREFIX/bin:\$PATH\"' >> ~/.bashrc"
echo "echo 'export PATH' >> ~/.bashrc"

echo 'All done!'
