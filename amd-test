proc clean_test_dirs() {
  for test in (TASKARR) {
    if (test=>startsWith("test_")) {
      try {
        var name = test=>trimStart("test_")
        var CleanProc = "clean_results_$name"
        try {
          eval $CleanProc
        }
        if (_status === 0) {
          write "Cleaned results for $test"
        } else {
          write "Failed to clean results for $test (FIXME)"
        }
      }
    }
  }
}

var GatheredTestResults = []
var SaveDone = false

proc save_test_results() {
  for test in (TASKARR) {
    if (test=>startsWith("test_")) {
      var name = test=>trimStart("test_")
      var SaverProc = "save_results_$name"
      var Files
      try {
        eval "$SaverProc (&Files)"
        setglobal GatheredTestResults = GatheredTestResults ++ Files
      }
      if (_status === 0) {
        write "Saved results for $test"
      } else {
        write "Result saving failed for $test"
      }
    }
  }
  setglobal SaveDone = true
}

proc summarise_json_tests() {
  for file in (GatheredTestResults) {
    if (file=>endsWith(".json")) {
      var Res
      var SumFile = file=>replace(".json", ".sum")
      json read (&Res) < $TESTRESULTSDIR/$file
      for test in (Res.tests) {
        write "$[test.code]: $[test.name]"
      } > $TESTRESULTSDIR/$SumFile
    }
  }
}

var Totals = {}

func AccumulateResults(Result, Num) {
  if (Result in Totals) {
    setglobal Totals[Result] += Num
  } else {
    setglobal Totals[Result] = Num
  }
}

func GetResultOrZero(Result) {
  if (Result in Totals) {
    return (Totals[Result])
  } else {
    return (0)
  }
}

proc summarise_one_test(SumFile) {
  var Passes = 0
  var XPasses = 0
  var Fails = 0
  var XFails = 0
  var Errors = 0
  var Skipped = 0
  var Unsupported = 0
  cat $TESTRESULTSDIR/$SumFile | while read n {
    case (n) {
      PASS:* {
        setvar Passes += 1
      }
      XPASS:* {
        setvar XPasses += 1
      }
      FAIL:* {
        setvar Fails += 1
      }
      XFAIL:* {
        setvar XFails += 1
      }
      ERROR:* {
        setvar Errors += 1
      }
      SKIPPED:* {
        setvar Skipped += 1
      }
      UNSUPPORTED:* {
        setvar Unsupported += 1
      }
      * {
        write "Unhandled result kind: $n (FIXME)"
      }
    }
  }
  write """=== $SumFile ===

PASSes: $Passes
XPASSes: $XPasses
FAILs: $Fails
XFAILs: $XFails
SKIPPED: $Skipped
UNSUPPORTED: $Unsupported
ERRORs: $Errors

"""
  call AccumulateResults("Passes", Passes)
  call AccumulateResults("XPasses", XPasses)
  call AccumulateResults("Fails", Fails)
  call AccumulateResults("XFails", XFails)
  call AccumulateResults("Skipped", Skipped)
  call AccumulateResults("Unsupported", Unsupported)
  call AccumulateResults("Errors", Errors)
}

proc print_result_summary() {
  for test in (GatheredTestResults) {
    var SumFile = test->replace(".json", ".sum")
    summarise_one_test $SumFile
  }
  write """=== TOTALS ===

PASSes: $[GetResultOrZero ("Passes")]
XPASSes: $[GetResultOrZero ("XPasses")]
FAILs: $[GetResultOrZero ("Fails")]
XFAILs: $[GetResultOrZero ("XFails")]
SKIPPED: $[GetResultOrZero ("Skipped")]
UNSUPPORTED: $[GetResultOrZero ("Unsupported")]
ERRORs: $[GetResultOrZero ("Errors")]"""
}

parse_args (ARGV)

eval (load_config)

add_optional_modules

elaborate_tests

maybe_mkdir $TESTRESULTSDIR

do_tasks (TASKLIST)

if (SaveDone) {
  write "Summarise JSON results..."

  summarise_json_tests

  write "Generating test report..."

  print_result_summary > $TESTRESULTSDIR/report.txt

  write
  cat $TESTRESULTSDIR/report.txt
}