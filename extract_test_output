#!/usr/bin/env ysh

proc usage(status='0') {
  write -n """
  Usage: extract_test_output RESULTS.JSON PATTERN
  Print the result, time and output of each test in a lit JSON results file
  (as amd-test saves them) whose name contains PATTERN.

    -h, --help             show this help and exit

  Full documentation: $_this_dir/README.md
  """
  exit $status
}

if (len(ARGV) >= 1 and (ARGV[0] === '-h' or ARGV[0] === '--help')) {
  usage
} elif (len(ARGV) !== 2) {
  usage 1
}

var Results = ARGV[0]
var TestName = ARGV[1]

json read (&Content) < $Results

for test in (Content.tests) {
  if (test.name ~~ "*$TestName*") {
    write -- "$[test.code]: $[test.name]"
    write "Elapsed time: $[test.elapsed]"
    write -- $[test.output]
    write
  }
}