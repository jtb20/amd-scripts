#!/usr/bin/env ysh
#set -e

const ScriptName = "amd-build"

source $_this_dir/common

var CurrentLogFile

maybe_mkdir $LOGDIR
maybe_mkdir $OBJDIR
maybe_mkdir $INSTALLDIR

parse_args (ARGV)

eval (load_config)

add_optional_modules

elaborate_tasks

unset @(unset_varlist)

if (NoBWrap) {
  do_tasks (TASKLIST)  
} else {
  do_bwrap $0 --no-bwrap @ARGV
}
