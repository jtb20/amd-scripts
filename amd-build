#!/usr/bin/env ysh
#set -e

const ScriptName = "amd-devel"

source --builtin args.ysh
source $_this_dir/common

var CurrentLogFile

proc clean_component (component) {
  var OBJDIR = get_objdir(component)
  if test --dir $OBJDIR {
    rm -rf $OBJDIR/*
  } else {
    mkdir -p $OBJDIR
  }
}

maybe_mkdir $LOGDIR
maybe_mkdir $OBJDIR
maybe_mkdir $INSTALLDIR

parse_args (ARGV)

eval (load_config)

elaborate_tasks

do_tasks (TASKLIST)
